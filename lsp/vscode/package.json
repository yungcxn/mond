{
	"name": "mond",
	"displayName": "mond",
	"description": "mond language support: highlighting, diagnostics, go to definition, references, outline, hover and completion from the mond compiler",
	"publisher": "mond",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.75.0"
	},
	"main": "./extension.js",
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [
		"onLanguage:mond"
	],
	"contributes": {
		"languages": [
			{
				"id": "mond",
				"aliases": [
					"mond"
				],
				"extensions": [
					".mn"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"configurationDefaults": {
			"[mond]": {
				"editor.semanticHighlighting.enabled": true
			},
			"editor.semanticTokenColorCustomizations": {
				"rules": {
					"namespace:mond": {
						"italic": true
					}
				}
			}
		},
		"semanticTokenScopes": [
			{
				"language": "mond",
				"scopes": {
					"macro": [
						"keyword.control.meta.mond"
					]
				}
			}
		]
	},
	"__metadata": {
		"size": 7649558
	}
}