# bc, the calculator of unix, in its integer core: numbers, `+ - * / % ^`, a minus in front,
# parentheses, the variables `a` to `z`, `x = ..`, statements split by `;`, and `quit`.
# it prints through `print` of examples/lib/print.c, which mond compiles and links in:
#   ./mond -b examples/bc.mn examples/lib/print.c -lc -m default
#   echo 'x = 6; x * 7; 2 ^ 62; 7 / 0' | ./bc

# several parameter lists: `print` is one variadic c function
fun print = (&u8 format);
fun print = (&u8 format, i64 number);
fun getchar = () -> i32;

variant Token = +(Number(i64), Variable(u8), Operator(u8), Open, Close, Assign, Split, Quit, Bad,
    End);
variant Fault = +(Syntax, DivideByZero);
# an expression: its value, or why it has none
variant Result = +(Value(i64), Failed(Fault));
# a statement: what bc does with it, or the fault of its expression
variant Action = +(Show(i64), Store, Quit);
variant Outcome = Action || Fault;

# how tight each operator binds, 0 for what is none, computed while compiling
stc [256]u8 BINDING = stcfor c in 0..<256: match c {
    '+' | '-' => 1,
    '*' | '/' | '%' => 2,
    '^' => 3,
    _ => 0,
};

# bc's integer power: a negative exponent keeps the integer part of 1 / base^n
fun power = (i64 base, i64 exponent where exponent < 0) -> i64: ret power(1 / base, -exponent);
fun power = (i64 base, i64 exponent where exponent == 0) -> i64: ret 1;
fun power = (i64 base, i64 exponent where exponent % 2 == 1) -> i64:
    ret base * power(base, exponent - 1);
fun power = (i64 base, i64 exponent) -> i64: ret power(base * base, exponent / 2);

fun apply = (
    u8 operator,
    i64 left,
    i64 right where right == 0 and (operator == '/' or operator == '%') or
        operator == '^' and left == 0 and right < 0,
) -> Result: ret Result.Failed(Fault.DivideByZero);
fun apply = (u8 operator, i64 left, i64 right) -> Result: ret Result.Value(match operator {
    '+' => left + right,
    '-' => left - right,
    '*' => left * right,
    '/' => left / right,
    '%' => left % right,
    _ => power(left, right),
});

# the tokens of a line, which ends at its length or at a zero byte
type Lexer = *(&[]u8 source, u64 length, mut u64 at = 0) !{
    fun peek = () -> u8: ret if self.at < self.length: self.source.*[self.at] else: 0;

    fun spells = (u64 start, &[]u8 word) -> bool {
        if self.at - start != lenof word: ret false;
        for i in 0..<lenof word: if self.source.*[start + i] != word.*[i]: ret false;
        ret true;
    }

    next = () -> Token {
        while self.peek() == ' ' or self.peek() == '\t': self.at += 1;
        u8 c = self.peek();
        if c == 0: ret Token.End;
        self.at += 1;
        ret match c {
            '0'..='9' => {
                mut i64 value = (c - '0') as i64;
                while self.peek() >= '0' and self.peek() <= '9':
                    value = value * 10 + (self.source.*[self.at++] - '0') as i64;
                Token.Number(value);
            },
            'a'..='z' => {
                u64 start = self.at - 1;
                while self.peek() >= 'a' and self.peek() <= 'z': self.at += 1;
                if self.at - start == 1: Token.Variable(c - 'a')
                else: if self.spells(start, "quit".&): Token.Quit
                else: Token.Bad;
            },
            '+' | '-' | '*' | '/' | '%' | '^' => Token.Operator(c),
            '(' => Token.Open,
            ')' => Token.Close,
            '=' => Token.Assign,
            ';' => Token.Split,
            _ => Token.Bad,
        };
    }
}

# the variables, and the line being run; for each statement of the line it gives its outcome
type Calculator = *(mut [26]i64 variables, mut Lexer lexer, mut Token token = Token.End) !{
    fun feed = (&[]u8 line) {
        self.lexer = Lexer(line, lenof line);
        self.advance();
    }

    fun advance = () { self.token = self.lexer.next(); }

    has_next = () -> bool: ret self.token != Token.End;

    next = () -> Outcome {
        mut Outcome outcome = self.statement();
        if self.token != Token.Split and self.token != Token.End: outcome = Fault.Syntax;
        match outcome {
            # bc drops the rest of a line that failed
            Fault fault => self.token = Token.End,
            _ => if self.token == Token.Split: self.advance(),
        }
        ret outcome;
    }

    fun statement = () -> Outcome {
        # a lexer is a value: a copy of it looks ahead
        mut Lexer ahead = self.lexer;
        match self.token {
            Token.Quit => {
                self.advance();
                ret Action.Quit;
            },
            Token.Variable(slot) => if ahead.next() == Token.Assign {
                self.advance();
                self.advance();
                ret match self.binary(1) {
                    Result.Value(value) => {
                        self.variables[slot] = value;
                        Action.Store;
                    },
                    Result.Failed(fault) => fault,
                };
            },
            _ => {},
        }
        ret match self.binary(1) {
            Result.Value(value) => Action.Show(value),
            Result.Failed(fault) => fault,
        };
    }

    # the operators binding at least as tight as `floor`, all to the left but `^`
    fun binary = (u32 floor) -> Result {
        first = self.unary();
        mut i64 left = first ?? ret first;
        loop {
            u8 operator = match self.token { Token.Operator(symbol) => symbol, _ => brk };
            u32 binding = BINDING[operator];
            if binding < floor: brk;
            self.advance();
            right = self.binary(if operator == '^': binding else: binding + 1);
            result = apply(operator, left, right ?? ret right);
            left = result ?? ret result;
        }
        ret Result.Value(left);
    }

    # in bc a minus in front binds tighter than `^`: -2 ^ 2 is 4
    fun unary = () -> Result {
        Token token = self.token;
        self.advance();
        ret match token {
            Token.Number(value) => Result.Value(value),
            Token.Variable(slot) => Result.Value(self.variables[slot]),
            Token.Operator('-') => {
                operand = self.unary();
                Result.Value(-(operand ?? ret operand));
            },
            Token.Open => {
                inner = self.binary(1);
                if self.token != Token.Close: ret Result.Failed(Fault.Syntax);
                self.advance();
                inner;
            },
            _ => Result.Failed(Fault.Syntax),
        };
    }
}

# what the last statement of a line gives, for the checks while compiling below
fun last_of = (&[]u8 line) -> Outcome {
    mut Calculator calculator;
    calculator.feed(line);
    mut Outcome last = Action.Store;
    for outcome in calculator: last = outcome;
    ret last;
}

stc bool PRECEDENCE = last_of("1 + 2 * 3 - 4".&) == Action.Show(3);       #= PRECEDENCE true
stc bool PARENTHESES = last_of("(1 + 2) * 3".&) == Action.Show(9);        #= PARENTHESES true
stc bool POWER = last_of("2 ^ 3 ^ 2".&) == Action.Show(512);              #= POWER true
stc bool NEGATED = last_of("-2 ^ 2 - --3".&) == Action.Show(1);           #= NEGATED true
stc bool INVERSE = last_of("2 ^ -1 + (-1) ^ -3".&) == Action.Show(-1);    #= INVERSE true
stc bool VARIABLES = last_of("x = 6; y = x * 7; y % 5".&) == Action.Show(2); #= VARIABLES true
stc bool STORED = last_of("a = 1".&) == Action.Store;                     #= STORED true
stc bool BY_ZERO = last_of("1 / (2 - 2)".&) == Fault.DivideByZero;        #= BY_ZERO true
stc bool SYNTAX = last_of("(1 + 2".&) == Fault.Syntax;                    #= SYNTAX true
stc bool WORD = last_of("1; quit".&) == Action.Quit;                      #= WORD true

# the next line of the input into `line`, ended by a zero byte; false when the input has ended
fun read_line = (*[256]u8 line) -> bool {
    mut i32 c = getchar();
    if c < 0: ret false;
    mut u64 length = 0;
    while c >= 0 and c != '\n' and length < 255, c = getchar(): line[length++] = c as u8;
    line[length] = 0;
    ret true;
}

main = () {
    mut Calculator calculator;
    mut [256]u8 line;
    while read_line(line.&) {
        calculator.feed(line.&);
        for outcome in calculator: match outcome {
            Action.Show(value) => print("%lld\n", value),
            Action.Store => {},
            Action.Quit => ret,
            Fault.Syntax => print("syntax error\n"),
            Fault.DivideByZero => print("divide by zero\n"),
        }
    }
}
