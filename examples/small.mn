

### EXTERNALS ###
# declarations only (no body, no logic): provided by the runtime / linker later on.
fun print = (&u8 fmt);
fun print = (&u8 fmt, i32 a);
fun print = (&u8 fmt, u32 a);
fun print = (&u8 fmt, u8 a);
fun print = (&u8 fmt, f32 a);
fun print = (&u8 fmt, bool a);
fun print = (&u8 fmt, &u8 a);
fun print = (&u8 fmt, AnyFixed32 a);
fun print = (&u8 fmt, i32 a, i32 b);




### FUNCTION DEFINITIONS ###
# complete function definition
fun add_i32 = (i32 a, i32 b) -> i32 { ret a + b; }

# induced return type
fun add_i32_induced = (i32 a, i32 b) { ret a + b; }

# with inserted names
fun add_i32_ins = (i32, i32) { ret $0 + $1; }

# without code block
fun add_i32_short = (i32, i32): ret $0 + $1;

# "unit" (no return type) is better to induce
fun my_void_func = () -> () {
    print("Hi!");
}

# static functions allow a second param-tuple (not mandatory)
stcfun my_templ = (type T, bool add_or_sub): (T a, T b) -> T {
    ret stcif add_or_sub: a + b else: a - b;
}

# realize template with alias
fun sub_from_templ = my_templ(i32, false);










### TYPE DEFINITIONS AND USING THEM ###
# basic
type Person = *([10]u8 name, mut i32 age = 18, mut &u8 address);

# no c-alignment
type Packed = **(u8 a, u16 b, u32 c);

# templates expose their realizations as abstract types
type Vec2D = (type T): *(T x, T y);

# using them
Person alice = Person(name = "Alice", age = 20, address = "123 Main St");

# induced type
bob          = Person(name = "Bob", address = "456 Elm St");

# if Person has a deinit:
deinit bob;

# copy struct through (with)
peter        = bob with (name = "peter");

# match struct 
fun weird_person_search = (Person p): match p {
    Person(name = "Alice", age = 42, address = _) => print("Found Alice, age 42"),
    Person(name = i, age = 42, address = _) => print("Found %s, age 42", i.&),
    Person(name = i, age = j, address = "Main St") => print("Found %s, living on Main St", i.&),
    _ => print("Found someone else"),
}








### TYPES AND TRAITS ###

# type with trait definition
type AddablePointI32 = *(mut i32 x, mut i32 y) !{
    fun add = (AddablePointI32 other) {
        self.x += other.x;
        self.y += other.y;
    }
}

# just a trait
trait Addable = !{
    fun add = ((typeof self) other);
}

# templated traits
trait SubtractableT = (type T): !{
    fun sub = (T other);
}

# using them
type AddableVec2D = *(mut i32 x, mut i32 y) implof Addable, SubtractableT(AddableVec2D) !{
    fun add = (AddableVec2D other) {
        self.x += other.x;
        self.y += other.y;
    }

    fun sub = (AddableVec2D other) {
        self.x -= other.x;
        self.y -= other.y;
    }
}

# real example, `Iterable` is a builtin
trait Iterable = (type T): !{
    next = () -> T;
    has_next = () -> bool;
}

type ByteStream = *(*u8 buf, mut u32 cursor, u32 len) implof Iterable(u8) !{
    init = (*u8 in_buf, u32 len): ret ByteStream(buf = in_buf, cursor = 0, len = len);
    deinit = () {} # could be left out

    # for Iterable(u8)
    next = () -> u8: ret self.buf[self.cursor++];
    has_next = () -> bool: ret self.cursor < self.len;

    pub fun pop = () -> Opt8: ret if self.cursor >= self.len: Opt8.None else: self.buf[self.cursor++];
}

# a real template
type Stream = (type Child): *(*Child buf, mut u32 cursor, u32 len) implof Iterable(Child) !{
    init = (*Child in_buf, u32 len): ret Stream(Child)(buf = in_buf, cursor = 0, len = len);
    deinit = () {} # could be left out

    next = () -> Child: ret self.buf[self.cursor++];
    has_next = () -> bool: ret self.cursor < self.len;

    pub fun pop = () -> Opt(Child): ret if self.cursor >= self.len: Opt(Child).None else: self.buf[self.cursor++];
}

# realize
type Int32Stream = Stream(i32);










### VARIANTS !!! ###

# A) enumvariant - values, no subtypes - tag is u8
variant Direction = +(North, South, East, West); 

# B) tagged homogenic unionvariant
variant Register = ++(
    AsLower(i16)                    = 0x00,
    AsInt(i32)                      = 0x01,
    AsFloat(f32)                    = 0x02,
    AsBytes(u8 a, u8 b, u8 c, u8 d) = 0x03,
) tagtype u8;

# C) tagged heterogenic abstract variant
variant Event = +(
    Click(i32 x, i32 y) = 0x01,
    Key(u8)             = 0x02,
    Close               = 0x00,
) tagtype u8;

# D) homogenic unionvariant (tagged by default)
variant AnyFixed32 = ++(                                  # could also be +, as that implies here ++
    AsInt(i32),
    AsFloat(f32),
    AsBits([4]u8),
) assertsize u64;

# E) heterogenic abstract variant (tagged by default)
variant AnyPrintable = +(
    AsInt(i32),
    AsText(&u8),
    AsFlag(bool),
);

# F) self-tagged variant
variant Opt8 = +(Some(u8), None = 0xFF) tagtype self assertsize u8;

variant CommonCode = +(
    Ok  = 0x0,
    OOM = 0x1,
    EOF = 0x2,
    Undefined(u8),
) tagtype self;

# the other builtin for any type
variant Opt = (type T): ++(Some(T), None) tagtype u8;

# use A): 
Direction dir = Direction.North;                            # Direction.North is a value, not a type

# use B):
Register reg = Register.AsInt(42);
Register.AsLower lower = reg as Register.AsLower;                                     # replaces tag
Register.AsFloat asflo = 4.2 as Register.AsFloat;                  # cast into Register.AsFloat(4.2)

# use C):
fun handle_event = (Event e): match e {
    Event.Click(x, y) => print("Click at (%d, %d)", x, y),
    Event.Key(key) => print("Key pressed: %d", key),
    Event.Close => print("Close"),
}

# use D):
fun handle_anyfixed = (AnyFixed32 a): match a {
    AnyFixed32.AsInt(i) => print("Int: %d", i),
    AnyFixed32.AsFloat(f) => print("Float: %f", f),
    AnyFixed32 non_specific => print("Non-specific: %d", non_specific),  # homogenic -> storable
}

# use E):
fun handle_anyprintable = (AnyPrintable a): match a {
    AnyPrintable.AsInt(i) => print("Int: %d", i),
    AnyPrintable.AsText(text) => print("Text: %s", text),
    AnyPrintable.AsFlag(flag) => print("Flag: %d", flag),
}

# use F):
fun handle_opt8 = (Opt8 o): match o {
    Opt8.Some(val) => print("Some: %d", val),
    Opt8.None => print("None"),
}

# use F): self-tagged variants
fun handle_code = (CommonCode c): match c {
    CommonCode.Ok => print("Ok"),
    CommonCode.OOM => print("Out of memory"),
    CommonCode.EOF => print("End of file"),
    CommonCode.Undefined <- undefined_val => print("Undefined code: %d", undefined_val),
}

# some more complex example
variant FamilyMember = +(
    Parent(&u8 name, mut i32 age where age >= 18 else age = 18) = 0x01,
    Child(&u8 name, mut i32 age, mut bool is_student = false) = 0x02,
    Pet(mut [10]u8 name, &u8 species) = 0x03,
) tagtype u8;








### WHERE, WHERE-ELSE, MIGHTY OVERLOADING ###

# where-else function:
fun safe_div = (f32 a, f32 b where b != 0.0 else ret 0x7FC00000 asbits f32) -> f32 {
    ret a / b;
}

# same as:
fun safe_div2 = (f32 a, f32 b) -> f32 {
    if b == 0.0: ret 0x7FC00000 asbits f32;
    ret a / b;
}

# static where for compile-time checks:
fun specific_printable = (AnyPrintable a stcwhere a != AnyPrintable.AsInt): match a {
    AnyPrintable.AsText(text) => print("Text: %s", text),
    AnyPrintable.AsFlag(flag) => print("Flag: %d", flag),
    _ => print("excluded by the stcwhere"),
}

# classic overloading:
fun add = (i32 a, i32 b) -> i32 { ret a + b; }
fun add = (f32 a, f32 b) -> f32 { ret a + b; }

# true overloading through different array lengths --- pointer allow here 0-copy + free type cast
fun recv_sum = (&[]u8 arr)  -> u32: ret recv_sum(arr as &[lenof arr-1]u8) + arr.*[lenof arr-1];
fun recv_sum = (&[1]u8 arr) -> u32: ret arr.*[0];
fun recv_sum = (&[0]u8 arr) -> u32: ret 0;

# mighty overloading with "where"
fun safe_div_ovl = (f32 a where a == 1, f32 b where b == 1) -> f32: ret 1;
fun safe_div_ovl = (f32 a where a == 1, f32 b): ret b;
fun safe_div_ovl = (f32 a, f32 b where b == 1): ret a;
fun safe_div_ovl = (f32 a, f32 b where b != 0.0): ret a / b;
fun safe_div_ovl = (f32 a, f32 b): ret 0x7FC00000 asbits f32;

# same as:
fun safe_div_ovl2 = (f32 a, f32 b) -> f32 {
    if a == 1 && b == 1: ret 1;
    if a == 1: ret b;
    if b == 1: ret a;
    if b != 0.0: ret a / b;
    ret 0x7FC00000 asbits f32;
}










### POINTERS AND ARRAYS ###
# pointers and pointers-to-immutables
fun test = () {
    mut u32 storage = 42;
    u32 other_storage = 99;

    *u32 myptr = storage.&;
    # myptr = other_storage; is illegal as `myptr` is not a mutable variable
    myptr.* = 43;                                                                    # storage == 43

    mut &u32 immut_ptr = storage.&;
    # immut_ptr.* = 44; is illegal
    immut_ptr = other_storage.&;                             # immut_ptr points to other_storage now
}

# arrays and strings
fun test2 = () {
    mut [4]u8 arr = [1, 2, 3, 4];
    arr[0] = 42;

    []u8 induced_len = [5, 6, 7, 8, 9];                                      # lenof induced_len == 5

    []u8 str = "Hello, world!";                                                     # lenof str == 13
    &u8 str2 = "Hello, world!";                                                            # with \0
    # *u8 str3 = "Hello, world!"; is illegal, as string literals are immutable
}










### CONTROL FLOW AND SUGARS ###
fun calc_something = () -> i32: ret 42;

main = () {
    # no statements exist in this languages -> from if to loop everything is an expression.

    # if-else unassigned
    if 2 + 3 == 5 {
        print("2 + 3 == 5");
    } else: if 2 + 3 == 6 {
        print("2 + 3 == 6");
    } else {
        print("2 + 3 != 5 and 2 + 3 != 6");
    }


    # if-else assigned
    i32 result = if 2 + 3 == 5: 42 else: if 2 + 3 == 6: 43 else: 44;

    # if-else with "runit" code execution
    mut i32 myvar = 0;                                       # initialization, mandatory before such

    myvar = if 2 + 3 == 5 {
        print("2 + 3 == 5");
    } else 42;

    # same as:
    myvar = if 2 + 3 == 5: do print("2 + 3 == 5") else: 42;                   # do for unit -> runit

    # stcif: condition is static, evaluated at compile-time only true compiles
    i32 stcif_var = stcif 1 == 1: 42 else: "illegal never-compiled value";


    # match unassigned
    i32 y = 42;
    match y {
        0 => print("y is zero"),
        1 => print("y is one"),
        2 | 3 | 4 => print("y is %d", y),
        _ => print("y is something else"),
    }

    # match assigned
    bool z = match y {
        0 => true,
        1 => false,
        2 | 3 | 4 => if y == 3: true else: false,
        _ => false,
    }

    # stcmatch
    bool w = stcmatch 5 {
        4 => "never compiled",
        5 => true,
        6 => "never compiled",
    }


    # while unassigned, also with repeat statement
    mut i32 j = 0;
    while j < 50 {
        print("j is %d", j);
        j++;
    }

    j = 0;
    while j < 50, j++: {
        print("j is %d", j);
    }

    # while assigned - produces array
    j = 0;
    [50]i32 arr = while j < 50: j++;

    # stcwhile - allows emitting length info -> no predefinition needed
    stc i32 jjj = 0;
    []i32 arr2 = stcwhile jjj < 50: jjj++;                    # ran in compile time to calculate len


    # for unassigned, also with iterator var
    []u32 arr3 = [1, 2, 3, 4, 5];
    for arr3 {                                                                   # or: 1..=5 / 1..<6
        print("arr3 element is %d", $it);
    }

    for i in arr3 {
        print("arr3 element is %d", i);
    }

    # for assigned
    mut [lenof arr3]u32 arr4;
    arr4 = for arr3: $it * 2;

    # stcfor - allows emitting length info -> no predefinition needed
    []i32 arr5 = stcfor 0..=50: $it * 2;                            # iterated length must be static

    # loop unassigned, also with repeat statement
    mut i32 k = 0;
    loop {
        if k >= 50 {
            brk;
        }
        print("k is %d", k);
        k = k + 1;
    }

    k = 0;
    loop k = k + 1 {
        if k >= 50 {
            brk;
        }
        print("k is %d", k);
    }

    # loop assigned
    k = 0;
    [10]i32 arr6 = loop k = k + 1: k;

    # stcloop - allows emitting length info -> no predefinition needed
    stc i32 sss = 0;
    []i32 arr7 = stcloop sss = sss + 1: if sss > 10: brk else: sss;                                       # ran in comptime


    # defer, defer deinit
    can = Person(name = "Can", age = 30, address = "789 Oak St");
    defer print("deferred for %s", can.address);
    deinit can;

    efe = Person(name = "Efe", age = 25, address = "321 Pine St") defer deinit;


    # brk, cont, ret
    if 5 == 4 {
        ret 1;                    # compiled logically, but never reached and probably optimized out
    }

    while true {
        if 5 == 4 {
            cont;                 # compiled logically, but never reached and probably optimized out
        } else {
            brk;
        }
    }


    # self-tagged variant unwrap with ??
    Opt8 vari = 42;                                                     # auto cast to Opt8.Some(42)
    u8 safe1 = vari ?? 0x0;                                          # ?? casts left hand to payload
    u8 safe2 = vari ?? ret 1;

    CommonCode code = CommonCode.EOF;
    u8 undefined_code = code ?? ret 2;


    # simple label arrow
    if (calc_something() <- solution) == 42 or solution == 43: do print("alright!");
    # unwrap arrow
    if vari ?<- nonnone_var {
        print("Unwrapped value is %d", nonnone_var);
    } else {
        print("opt8 vari was None");
    }
    match code {
        CommonCode.Undefined(undefined_code) => print("Undefined code: %d", undefined_code),
        _ => print("Code is defined"),
    }



    # generator expressions
    for i in 1..=10: print("#%d: from 1 to inclusively 10", i);
    for i in 1..<10: print("#%d: from 1 to inclusively 9", i);
    for i in ..=10: print("#%d:  from 0 to inclusively 10", i);
    for i in 1..: print("#%d: from 1 onwards until someone breaks!", i);

    # type conversion and checking
    i32 myint = 42;
    f32 myfloat = myint as f32;

    trait Bark = !{ fun bark = (); }
    type Dog = *(mut &u8 name) implof Bark !{ fun bark = (): print("%s: Woof!", self.name); }

    Dog my_dog = Dog(name = "Fido");
    if (typeof my_dog) == Dog: print("this is printed");
    if (typeof my_dog) == Bark: print("NEVER printed");

    if my_dog oftype Dog: print("this is printed");
    if my_dog oftype Bark: print("this is printed");
}










### METAPROGRAMMING ###
# quote {}, refl, include, <> and manipulation of `ast` type
# - `ast` is a builtin variant like `Opt`, its cases are the ParseTree nodes with their beautiful names:
#   ast.BinaryAdd(lhs, rhs), ast.IfThen(cond, then), ast.Identifier, ... (PartialExpression_ dropped)
#   -> match, with, oftype and case types work on trees as on any other variant
# - it is a template: ast(i32) is a tree giving an i32, also ast(bool), ast(type), ast(fun) and ast(())
#   for statements. plain `ast` is the abstract over all of them, like `Box` for `Box(T)`
# - trees only exist at compile-time, so every ast variable is implicitly stc
fun meta_test = () {
    # will be lazily evaluated: `quote:` takes an expression -> ast(i32), `quote {}` a block -> ast(())
    ast(i32) my_macro = quote: 1 + 2 + 3 + 4;

    # - the vars in it are hygienic; x in quote is not the same as x outside
    # - but types, functions etc. are global
    # - @ is the only way out of a quote, lexical first:
    #   - x is a compile-time binding where the quote is written (stc, ast, a macro's param):
    #     @x unquotes it, a tree is inserted, a value becomes a literal
    #   - otherwise: @x is the x where the tree lands (an expansion or a refl-write), found or bound there
    #   it takes the name with its .member and [index] chain, @(...) always unquotes
    ast(i32) more_complex = quote: 42 + add_i32(1, 2) + @my_macro;

    # <> expands macro, what comes out is code again and no tree
    i32 lazily_realized = <more_complex>;                                                       # 55

    # macro interacting with outside scope: realvar1 is no compile-time binding here, so @realvar1 is the
    #   one where it gets expanded. temp stays hygienic -> a fresh temp per expansion
    exchanger = quote {
        temp = @realvar1;
        @realvar1 = @realvar2;
        @realvar2 = temp;
    }

    mut i32 realvar1 = 42;
    mut i32 realvar2 = 43;
    <exchanger>;
    exchanger_alias = exchanger;
    <exchanger_alias>; # now back to original

    # parametrized quote/macro, compile time error if the trees are not bare identifiers (case types).
    #   value is no tree, @value lifts it into a literal
    fun param_macro_add = (ast.Identifier identifierx, ast.Identifier identifiery, i32 value): quote:
        @identifierx + @identifiery + @value;

    # nothing is quoted automatically, the caller decides what stays code. `quote: realvar1` is written
    #   here, so it means this realvar1 wherever it ends up
    i32 sum = <param_macro_add(quote: realvar1, quote: realvar2, 10)>;                          # 95

    # trees are variants: match them, copy them with `with`
    ast(i32) mirrored = match my_macro {
        ast.BinaryAdd(lhs, rhs) => my_macro with (lhs = rhs, rhs = lhs),           # 4 + (1 + 2 + 3)
        _ => my_macro,
    }

    # the macros from below
    <assert(quote: realvar1 + realvar2 == 85)>;
    mut i32 realvar3 = 44;
    <rotate([quote: realvar1, quote: realvar2, quote: realvar3])>;                       # 43, 44, 42
    i32 folded = <simplify(quote: (realvar1 * 1 + 0) * (realvar2 + 0))>;         # realvar1 * realvar2

    # @ can also bind: aif puts `it` into this scope. the quoted then-branch can't know `it` yet,
    #   so it stays a plain `ast` and gets typed when expanded
    Opt8 maybe = 42;
    <aif(quote: maybe, quote: print("got %d", it), quote: print("nothing"))>;

    # refl gives a *ast to the live declaration of whatever it names
    stc []u8 decl_text = (refl realvar1).src;                                         # "realvar1 = 42"
    # (refl realvar1).assigned = quote: 0; is illegal: a declaration freezes as soon as it is resolved
}

# a) control flow: c's assert, but the condition comes as a tree so its source comes along (#cond in c).
#   trees and not text -> `!@cond` needs no parentheses. `crash (at, ..)` reports at the user's code, not here
stcfun assert = (ast(bool) cond) -> ast(()): ret match cond {
    ast.BooleanTrue | ast.BooleanFalse => crash (cond, "assertion on a constant"),
    _ => quote { if !@cond: print("assertion failed: %s", @cond.src); },
}

# b) anaphoric: @value is a param -> unquoted, `it` exists nowhere here -> bound where aif lands
stcfun aif = (ast(Opt8) value, ast then, ast otherwise) -> ast(()): ret quote {
    if @value ?<- @it { @then; } else { @otherwise; }
}

# c) gensym: all quotes of one expansion share their names, `fresh` gives distinct ones (one per var)
stcfun rotate = ([]ast.Identifier vars) -> ast(()) {
    []ast.Identifier temps = for vars: fresh "temp";
    mut []ast moves = [];                                            # []ast grows with += at compile-time
    for i in 0..<lenof vars: moves += quote: @temps[i] = @vars[i];
    for i in 0..<lenof vars: moves += quote: @vars[i] = @temps[(i + 1) % lenof vars];
    ret quote { @..moves; };                                         # @.. splices a list in place
}

# d) quote-patterns: a quote in a match arm matches by shape, its @x bind subtrees (@_ ignores)
stcfun simplify = (ast(i32) e) -> ast(i32): ret match e {
    quote: @x + 0 => simplify(x),
    quote: 0 + @x => simplify(x),
    quote: @x * 1 => simplify(x),
    quote: 1 * @x => simplify(x),
    quote: @_ * 0 => quote: 0,
    quote: 0 * @_ => quote: 0,
    ast.BinaryAdd(lhs, rhs) | ast.BinaryMultiply(lhs, rhs) => e with (lhs = simplify(lhs), rhs = simplify(rhs)),
    _ => e,
}

# views on trees are $-members (like ParseTree's Param/Def/Loop/Branch), written through a *ast like
#   fields through a *T, the elements of a list view of a *ast are *ast:
#   any:              .src, .children
#   fun:              .name, .params, .rettype, .body
#   type, variant:    .name, .fields / .cases, .traits, .methods
#   field, param:     .name, .type, .defval, .guard, .ismut
#   variable:         .name, .type, .assigned
#   file, include:    .decls

# e) generating match arms: one arm per case, the variant is only read -> &ast
stcfun gen_name_of = (&ast(variant) v) -> ast(fun) {
    mut []ast arms = [];
    for c in v.cases: arms += quote: @(v.name).@(c.name) => @c.name.src;
    ret quote: (@v.name value) -> &u8: ret match value { @..arms };
}

fun direction_name = <gen_name_of(refl Direction)>;                              # like realizing a template

# f) refl edits the program: everything resolving Person sees the getters (the !{} is created if missing).
#   top-level <> run in source order before anything is resolved, a unit result expands to nothing
stcfun gen_getters = (*ast(type) t) {
    for field in t.fields: t.methods += quote:
        pub fun get_@(field.name) = () -> @field.type: ret self.@(field.name);    # get_ ## name in c
}
<gen_getters(refl Person)>;

fun person_age = (Person p) -> i32: ret p.get_age();

# g) deriving a trait: other in the folded condition and in the method is the same name, as both quotes
#   are built in the same expansion
trait Equatable = !{
    fun eq = ((typeof self) other) -> bool;
}

stcfun derive_eq = (*ast(type) t) {
    mut ast(bool) all = quote: true;
    for field in t.fields: all = quote: @all and self.@(field.name) == other.@(field.name);
    t.traits += quote: Equatable;
    t.methods += quote: fun eq = ((typeof self) other) -> bool: ret @all;
}
<derive_eq(refl AddablePointI32)>;

# h) rewriting functions in place: every call of add_i32 traces now, also the ones above
stcfun trace = (*ast(fun) f) {
    f.body = quote {                                    # the quote is built before the assignment
        print("-> %s", @f.name.src);
        defer print("<- %s", @f.name.src);
        @f.body;
    };
}
<trace(refl add_i32)>;

# i) the file itself: a bare refl is this file, the runner is generated from every `test_` function in it
fun test_add = () -> bool: ret add_i32(1, 2) == 3;
fun test_templ = () -> bool: ret sub_from_templ(3, 2) == 1;

fun starts_with = ([]u8 s, []u8 prefix) -> bool {
    if lenof s < lenof prefix: ret false;
    for i in 0..<lenof prefix: if s[i] != prefix[i]: ret false;
    ret true;
}

stcfun gen_test_runner = (&ast file) -> ast(fun) {
    mut []ast checks = [];
    for d in file.decls {
        if d oftype ast(fun) and starts_with(d.name.src, "test_") {
            checks += quote: if !@(d.name)(): print("FAILED: %s", @d.name.src);
        }
    }
    ret quote: () { @..checks; };
}

fun run_tests = <gen_test_runner(refl)>;

# and new top-level declarations, they are as global as the written ones
stcfun add_version = (*ast file, u32 v) {
    file.decls += quote: pub fun version = () -> u32: ret @v;
}
<add_version(refl, 3)>;

# j) include gets the declarations of another file as an own tree (a copy, no refl), the private ones
#   under names of their own.
#   <include "x.mn"> is an import, but the tree can be changed before
<include "lib/math.mn">;

stcfun traced_all = (ast lib) -> ast {
    mut ast out = lib;
    for i in 0..<lenof out.decls: if out.decls[i] oftype ast(fun): trace(out.decls[i].&);
    ret out;
}
<traced_all(include "lib/strings.mn")>;

# k) nothing is read-only: every case carries its DefTable fields (IfThen: cond, then; VariableDefinition:
#   type, identifier; FunctionCall: callable, fun_param_tuple; ...), the list views grow with +=. raw fields
#   are plain `ast` so any tree fits, it is checked once the declaration gets resolved. .children reaches
#   all of them generically
stcfun walk = (*ast t, (*ast) -> () visit) {
    visit(t);
    for c in t.children: walk(c, visit);                               # into what is there after visit
}

fun same = ([]u8 a, []u8 b) -> bool: ret lenof a == lenof b and starts_with(a, b);

fun legacy_min = (i16 a, i16 b) -> i16 {
    mut i16 acc = a;
    if acc > b: acc = b;
    ret acc;
}

stcfun modernize = (*ast(fun) f) {
    f.name = ast.Identifier("modern_min");                                    # identifiers are cases too
    walk(f, (*ast n): match n.* {
        ast.TypeSignedInteger16 => n.* = quote: i32,                           # params, return and local
        ast.Identifier => if same(n.src, "acc"): n.* = ast.Identifier("result"),       # a var, everywhere
        ast.BinaryGreater(lhs, rhs) => n.* = ast.BinaryGreaterOrEqual(lhs, rhs),             # an operator
        ast.IfThen(cond, then) => n.cond = quote: @cond and @b != 0,     # @cond: the binder, @b: lands
        _ => {},
    });
    f.body = quote {                                                              # and the body itself
        print("min of %d and %d", @a, @b);
        @..f.body;                                                # @.. flattens a block, @ would nest it
    };
}
<modernize(refl legacy_min)>;
# legacy_min is now:
#   fun modern_min = (i32 a, i32 b) -> i32 {
#       print("min of %d and %d", a, b);
#       mut i32 result = a;
#       if result >= b and b != 0: result = b;
#       ret result;
#   }

# same for types: fields, their types, defaults, wheres
stcfun widen = (*ast(type) t) {
    for field in t.fields: field.type = quote: u32;
}
<widen(refl Packed)>;                                                             # **(u32 a, u32 b, u32 c)
