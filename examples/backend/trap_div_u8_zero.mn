# a runtime check stops the program: a u8 division by zero. the line before is printed, the one after isn't
#+
#? trap
<include "lib/raw.mn">;
mut i64 ONE = 0;
fun d = (u8 a, u8 b) -> u8: ret a / b;
main = (u32 argc, &&u8 argv) {
    ONE = argc as i64;
    say_u64(1);   #> 1
    say_u64(d((9 * ONE) as u8, (0 * ONE) as u8) as u64);
    say_u64(2);
}
