# built with DWARF (`-d`) in every mode: code from macros and from `include` gets the line of the
# splice, closures and records get their frames
<include "lib/out.mn">;
#+ -lc lib/clib.c -d

stcfun unrolled = (u32 times, ast(()) step) -> ast(()) {
    mut []ast steps = [];
    for i in 0..<times: steps += step;
    ret quote { @..steps; };
}
type Pt = *(mut i64 x, i64 y);
fun apply = ((i64) -> i64 f, i64 v) -> i64: ret f(v);

$main = () {
    mut i64 x = 1;
    <unrolled(3, quote { @x = @x * 3; })>;
    line_i64(x);                              #> 27
    mut Pt p = Pt(2, 5);
    k = (i64 v): v + p.y;
    p.x = apply(k, p.x);
    line_i64(p.x);                            #> 7
}
