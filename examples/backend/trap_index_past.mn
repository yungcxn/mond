# a runtime check stops the program: an index one past the end. the line before is printed, the one after isn't
#+
#? trap
<include "lib/raw.mn">;
mut i64 ONE = 0;
fun at = ([4]u32 xs, u64 i) -> u32: ret xs[i];
$main = (u32 argc, &&u8 argv) {
    ONE = argc as i64;
    say_u64(1);   #> 1
    say_u64(at([1, 2, 3, 4], (4 * ONE) as u64) as u64);
    say_u64(2);
}
