# a runtime check stops the program: a u64 shifted by 64. the line before is printed, the one after isn't
#+
#? trap
<include "lib/raw.mn">;
mut i64 ONE = 0;
fun s = (u64 a, u64 n) -> u64: ret a << n;
$main = (u32 argc, &&u8 argv) {
    ONE = argc as i64;
    say_u64(1);   #> 1
    say_u64(s(1, (64 * ONE) as u64));
    say_u64(2);
}
