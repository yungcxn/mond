# a runtime check stops the program: an inner index past the end of a row, the row index in range. the line before is printed, the one after isn't
#+
#? trap
<include "lib/raw.mn">;
mut i64 ONE = 0;
fun at = ([3][2]u8 m, u64 i, u64 j) -> u8: ret m[i][j];
$main = (u32 argc, &&u8 argv) {
    ONE = argc as i64;
    say_u64(1);   #> 1
    say_u64(at([[1, 2], [3, 4], [5, 6]], ONE as u64, (2 * ONE) as u64) as u64);
    say_u64(2);
}
