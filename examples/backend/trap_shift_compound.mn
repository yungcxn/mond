# a runtime check stops the program: a shift by the width written back to the variable. the line before is printed, the one after isn't
#+
#? trap
<include "lib/raw.mn">;
mut i64 ONE = 0;
fun s = (u32 a, u32 n) -> u32 { mut u32 x = a; x = x << n; ret x; }
$main = (u32 argc, &&u8 argv) {
    ONE = argc as i64;
    say_u64(1);   #> 1
    say_u64(s(1, (32 * ONE) as u32) as u64);
    say_u64(2);
}
