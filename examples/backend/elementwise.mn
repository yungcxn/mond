<include "lib/out.mn">;
# operators element by element at run time: arrays with arrays, numbers and slices, comparisons
# into arrays of bools, `-` and `!`, updates in place of arrays and of the elements a slice views.
# each line ends in 1 where compiling computed the same
type Vec = [4]f32;

fun results = (u32 one) -> [10]i64 {
    [4]i32 a = [1, 5, 3, 7 * one as i32];
    [4]i32 b = [2, 5, 1, 9];
    [4]i32 sum = a + b * 2 - 1;
    [4]bool less = a < b;
    [4]bool more = a >= b;
    Vec v = [1.5, 2.0, 0.5, 4.0 * one as f32];
    Vec scaled = v * 2.0 + v / 2.0;
    [4]u32 bits = ([12, 10, 7, 255 * one] & 6 | [1, 0, 0, 1]) ^ 1 << [0, 1, 2, 3];
    [4]i32 negated = -a;
    [4]bool flipped = !less;
    mut [4]i64 updated = [10, 20, 30, 40 * one as i64];
    updated += 5;
    updated *= [1, 2, 3, 4];
    [..]i64 tail = updated[2..];
    tail -= [100, 1000];
    [4]u8 bytes = [10, 20, 30, 40];
    [..]u8 view = bytes[1..];
    [3]u8 mixed = [1, 2, 3] + view;
    mut i64 trues = 0;
    for i in 0..<4: trues += (less[i] as i64) * 1000 + (more[i] as i64) * 100 + (flipped[i] as i64);
    ret [
        sum[0] * 1000000 + sum[1] * 10000 + sum[2] * 100 + sum[3] as i64,
        trues,
        (scaled[0] * 100.0) as i64 * 1000 + (scaled[3] * 10.0) as i64,
        (bits[0] * 1000000 + bits[1] * 10000 + bits[2] * 100 + bits[3]) as i64,
        negated[0] * 1000 + negated[3] as i64,
        updated[0] * 1000000 + updated[1] * 1000 + updated[2],
        updated[3],
        mixed[0] as i64 * 10000 + mixed[1] as i64 * 100 + mixed[2] as i64,
        (a == b) as i64 * 10 + (a == a) as i64,
        sizeof [4]bool as i64,
    ];
}

stc [10]i64 STATIC = results(1);

main = (u32 argc, &&u8 argv) {
    [10]i64 run = results(argc);
    for i in 0..<10: line_i64(run[i] * 10 + (run[i] == STATIC[i]) as i64);
    #> 41404241
    #> 22021
    #> 3751001
    #> 40002151
    #> -10069
    #> 150500051
    #> -8199
    #> 2132431
    #> 11
    #> 41
}
