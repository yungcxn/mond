<include "lib/out.mn">;

type IntFn = (i64) -> i64;
fun apply = (IntFn f, i64 v) -> i64: ret f(v);
fun twice = (i64 x) -> i64: ret x * 2;
fun chain = (u32 a, u32 b = a + 1, u32 c = b * 2) -> u32: ret a * 100 + b * 10 + c;
fun countdown = (u32 n, u32 step = 1) -> u32: ret if n == 0: 0 else: 1 + countdown(n - step);
fun sign = (i32 x where x < 0) -> i32: ret -1;
fun sign = (i32 x where x == 0) -> i32: ret 0;
fun sign = (i32 x) -> i32: ret 1;
fun safe_div = (u32 a, u32 b where b != 0 else ret 0) -> u32: ret a / b;

$main = () {
    line_i64(apply(twice, 21));                   #> 42
    mut i64 base = 10;
    add_base = (i64 x): x + base;
    base = 20;
    line_i64(apply(add_base, 1));                 #> 21
    i64 k = 3;
    times_k = (i64 x): x * k;
    line_i64(apply(times_k, 5));                  #> 15
    line_u64(chain(1) as u64);                    #> 124
    line_u64(chain(1, c = 9) as u64);             #> 129
    line_u64(countdown(10) as u64);               #> 10
    line_u64(countdown(10, 2) as u64);            #> 9
    line_i64((sign(-5) * 100 + sign(0) * 10 + sign(9)) as i64);  #> -99
    line_u64(safe_div(9, 0) as u64);              #> 0
    line_u64(safe_div(9, 3) as u64);              #> 3
    mut i64 acc = 0;
    defer line_i64(acc);
    for i in 1..=3: acc += i;
    puts("before defer");                         #> before defer
    # the defer runs at the end of the block       #> 6
}
