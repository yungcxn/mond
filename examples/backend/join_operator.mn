<include "lib/out.mn">;
# `a ~ b` at run time: arrays of values, places and pointers copied one after the other
mut u32 ONE = 0;
type Pair = *(u32 a, u8 b);

fun rotated = ([4]u32 v, u32 k) -> [4]u32 {
    mut [4]u32 a = v;
    for _ in 0..<k: a = a[1..] ~ a[..<1];
    ret a;
}

main = (u32 argc, &&u8 argv) {
    ONE = argc;
    [2]u32 a = [ONE, ONE + 1];
    [3]u32 b = [7, 8, 9 * ONE];
    [5]u32 c = a ~ b;
    mut u64 digits = 0;
    for x in c: digits = digits * 10 + x as u64;
    line_u64(digits);                                    #> 12789
    &[2]u32 p = a.&;
    [4]u32 twice = p ~ p ~ [];
    line_u64(twice[3] as u64 * 10 + twice[0] as u64);    #> 21
    [6]u8 text = "ab" ~ "cd" ~ [101, 102];
    for t in text: putchar(t as i32);
    putchar(10);                                         #> abcdef
    [3]Pair pairs = [Pair(ONE, 2)] ~ [Pair(3, 4), Pair(5 * ONE, 6)];
    line_u64(pairs[2].a as u64 * 10 + pairs[1].b as u64); #> 54
    [4]u32 r = rotated([1, 2, 3, 4], 3 * ONE);
    line_u64(r[0] as u64 * 1000 + r[1] as u64 * 100 + r[2] as u64 * 10 + r[3] as u64); #> 4123
    [2046]u8 zeros;
    [2048]u8 big = [0] ~ [ONE as u8] ~ zeros;
    line_u64(big[1] as u64 + lenof big);                 #> 2049
}
