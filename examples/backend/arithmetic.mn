<include "lib/out.mn">;

fun fib = (u64 n) -> u64: ret if n < 2: n else: fib(n - 1) + fib(n - 2);

fun gcd = (u64 a, u64 b) -> u64 {
    mut u64 x = a;
    mut u64 y = b;
    while y != 0 {
        t = x % y;
        x = y;
        y = t;
    }
    ret x;
}

fun counts = (i64 n) -> i64 { mut i64 k = n; i64 a = k--; i64 b = --k; ret a * 100 + b * 10 + k; }
fun remainders = (i64 n) -> i64 { mut i64 x = n; x %= 7; mut u8 y = 200; y %= n as u8; ret x * 1000 + y as i64; }
fun xored = (bool a, bool b) -> i64: ret (a xor b) as i64 * 10 + (a xor !b) as i64;

main = () {
    puts("arithmetic");     #> arithmetic
    line_u64(fib(20));      #> 6765
    line_u64(gcd(84, 36));  #> 12
    line_i64(-17 / 5);      #> -3
    line_i64(-17 % 5);      #> -2
    u8 wrap = 250;
    line_u64((wrap + 10) as u64);  #> 4
    line_u64(1 << 40);      #> 1099511627776
    i32 shifted = -64;
    line_i64((shifted >> 3) as i64);  #> -8
    line_i64(counts(5));    #> 533
    line_i64(remainders(30));  #> 2020
    line_i64(xored(true, false) * 100 + xored(false, false));  #> 1001
}
