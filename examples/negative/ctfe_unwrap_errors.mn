variant Res = +(Ok(i32), Err(u8));
variant Bare = +(A, B);

# a bare unwrap of an empty case returns the fallback of the result, a crash fails instead
stcfun strict = (Res r) -> i32: ret r??;
stc i32 S1 = strict(Res.Ok(3)); #= S1 3
stc i32 S2 = strict(Res.Err(3)); #= S2 0
stcfun loud = (Res r) -> i32: ret r ?? crash "empty"; #! crash
stc i32 L1 = loud(Res.Ok(3)); #= L1 3
stc i32 L2 = loud(Res.Err(3));

# a variant without payload has nothing to unwrap
stcfun bare = (Bare b) -> u8: ret b ?? 0; #! type_mismatch
stc u8 BA = bare(Bare.A);

# the fallback has the payload type
stc i32 FB = Res.Ok(1) ?? "none"; #! type_mismatch
stc u8 FU = Res.Ok(1) ?? 0; #! type_mismatch

main = () {}
