# diagnostics of past bugs: each repeated case reported once, names in a range index checked,
# a size asserted as something that is no size, a label bound at the top level, a body first
# checked inside a condition the checker tries to evaluate, a stcfun body after a failed argument
variant Twice = +(A, B, A, A); #! duplicate_declaration duplicate_declaration
type Sized = *(u8 a) assertsize true; #! type_mismatch

fun ranges = ([6]u8 arr) {
    u8 e = arr[missing..]; #! undefined_name genexpr_index
}

missing_value <- bound_label; #! undefined_name

fun hidden = (&[]u8 text) -> u32 {
    ret not_declared; #! undefined_name
}
stcfun probes = () -> u32 {
    if hidden("x".&) == 1: ret 1;
    ret 0;
}
u32 PROBED = probes();

stcfun joined = (&[]u8 a, &[]u8 b) -> u64: ret a.$len + b[0];
stc [2]u8 AB = "ab";
stc u64 JOINED = joined(AB.&, "x".&); #! not_static not_static

$main = () {}
