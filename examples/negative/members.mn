type P = *(i32 x) !{ fun m = () {} }
variant V = +(A, B);

fun free = (P p) {}

fun f = () {
    P p = P(x = 1);
    i32 y = p.y; #! unknown_member
    p.nope(); #! unknown_member
    V v = V.C; #! unknown_member
    i32 n = 5;
    i32 z = n.x; #! unknown_member
    p.free(); #! unknown_member
    p.m();
    P.m(p.&);
    P.m(); #! wrong_arity
}

variant Code = +(Ok = 0, Bad(u8)) tagof self;

variant Shape = +(Dot, Line);

fun self_tag = (Code c) -> u8: ret c.$tag; #! unknown_member
fun type_tag = () -> u8: ret Shape.$tag; #! unknown_member
fun record_tag = (P p) -> u8: ret p.$tag; #! unknown_member

# predefined names are declared without fun
type Walk = *(mut u32 at) !{
    fun $has_next = () -> bool: ret self.at < 3; #! redundant_fun
    $next = () -> u32: ret self.at++;
}
