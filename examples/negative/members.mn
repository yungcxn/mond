type P = *(i32 x) !{ fun m = () {} }
variant V = +(A, B);

fun free = (P p) {}

fun f = () {
    P p = P(x = 1);
    i32 y = p.y; #! unknown_member
    p.nope(); #! unknown_member
    V v = V.C; #! unknown_member
    i32 n = 5;
    i32 z = n.x; #! unknown_member
    p.free(); #! unknown_member
    p.m();
    P.m(p.&);
    P.m(); #! wrong_arity
}

variant Code = +(Ok = 0, Bad(u8)) tagtype self;

variant Shape = +(Dot, Line);

fun self_tag = (Code c) -> u8: ret tagof c; #! invalid_operand
fun type_tag = () -> u8: ret tagof Shape; #! invalid_operand
fun record_tag = (P p) -> u8: ret tagof p; #! invalid_operand
fun record_length = (P p) -> u64: ret lenof p; #! invalid_operand
