stc i8 I8MAX = 127;
stc i8 I8MIN = -128;
stc u16 U16MAX = 65535;
stc i64 I64MAX = 9223372036854775807;
stc i64 I64MIN = -9223372036854775808;
stc u64 U64MAX = 18446744073709551615;

# every operation wraps at the edges of its width, a division by zero or a shift past the width has no value
stc i8 A = I8MAX + 1; #= A -128
stc i8 B = I8MIN - 1; #= B 127
stc i8 C = I8MIN * -1; #= C -128
stc i8 D = I8MIN / -1; #= D -128
stc i8 E = -I8MIN; #= E -128
stc u16 F = U16MAX + 1; #= F 0
stc u16 G = 256 * 256; #= G 0
stc i64 H = I64MAX + 1; #= H -9223372036854775808
stc i64 I = I64MIN - 1; #= I 9223372036854775807
stc i64 J = I64MIN / -1; #= J -9223372036854775808
stc u64 K = U64MAX + 1; #= K 0
stc u64 L = U64MAX * 2; #= L 18446744073709551614
stc u32 M = 3 - 4; #= M 4294967295
stc u8 N = 16 * 16; #= N 0
stc u32 O = 7 % 0; #! static_eval_failed
stc i32 P = -7 / 0; #! static_eval_failed
stc u8 Q = 1 << 8; #! static_eval_failed
stc u64 R = 1 << 64; #! static_eval_failed
stc i32 S = 1 >> 32; #! static_eval_failed

# a dependency holds its wrapped value
stc i8 T = A + 0; #= T -128

# folding wraps through groups and chains
stc u8 U = (100 + 100) + (20 + 40); #= U 4
stc u8 V = 255 - 100 + 101; #= V 0

$main = () {}
