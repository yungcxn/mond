# an included declaration is as global as a written one: included twice it is declared twice,
# and the calls in the bodies (`gcd` in both) find two of a kind, reported where they landed
<include "../lib/math.mn">; #! ambiguous_overload ambiguous_overload
<include "../lib/math.mn">; #! duplicate_declaration duplicate_declaration ambiguous_overload ambiguous_overload

main = () {}
