# a tag value is a static integer
variant Flag = +(A = true, B); #! type_mismatch
variant Text = +(A = "a", B); #! type_mismatch
variant NegU = +(A = -1, B) tagtype u8; #! tag_overflow
variant Fine = +(A = 2 + 3, B = 1 << 4) tagtype u8;

# implicit tags continue after a negative one
variant Neg = +(A = -2, B, C, D) tagtype i8;
stc i8 NA = tagof Neg.A; #= NA -2
stc i8 NB = tagof Neg.B; #= NB -1
stc i8 NC = tagof Neg.C; #= NC 0
stc i8 ND = tagof Neg.D; #= ND 1

main = () {}
