# machine code and calls of the kernel: static text, registers only. machine code runs at run time
# only, the kernel also while compiling, where a pointer passes plain data (no pointers in it)
fun dynamic_text = (bool c) { asm (if c: "nop" else: "nop"); }   #! not_static
fun two_texts = () { asm ("nop", "nop"); }                         #! wrong_arity
fun no_number = () -> i64: ret syscall ();                         #! wrong_arity
fun too_many = () -> i64: ret syscall (1, 2, 3, 4, 5, 6, 7, 8);    #! wrong_arity
fun a_float = () -> i64: ret syscall (1, 2.5);                     #! type_mismatch
stcfun pointing = () -> i64 {
    u32 x = 1;
    &u32 p = x.&;
    ret syscall (1, 1, p.&, 8);                                  #! not_static
}
stc i64 POINTING = pointing();
fun spin = () -> u32 {
    asm "nop";                                                   #! not_static
    ret 1;
}
stc u32 SPUN = spin();
main = () {}
