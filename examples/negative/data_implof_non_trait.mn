# only traits can be implemented or extended
type Rec = *(u8 v);
variant Var = +(A, B);
type OnRec = *(u8 v) implof Rec !{ fun x = () {} } #! type_mismatch
type OnVar = *(u8 v) implof Var !{ } #! type_mismatch
type OnPrim = *(u8 v) implof u32 !{ } #! type_mismatch
trait Super = implof Rec !{ fun y = (); } #! type_mismatch

$main = () {}
