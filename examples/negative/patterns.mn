variant V = +(A, B(u8));
variant W = +(X, Y);
variant P = +(I(i32 v), U(u8 v), Two(i32 a, i32 b));
type R = *(i32 a, i32 b);

fun f = (V v, i32 n, R r) {
    match v { W.X => 1, _ => 2 } #! type_mismatch
    match n { "s" => 1, _ => 2 } #! type_mismatch
    match v { V.B("s") => 1, _ => 2 } #! type_mismatch
    match r { R(c = 1) => 1, _ => 2 } #! wrong_arity
    match n { 1..=3 => 1, _ => 2 }
    match n { 1.0..=3.0 => 1, _ => 2 } #! type_mismatch
    match v { V.A => 1, V.B(x) => x }
    match v { W y => 1, _ => 2 } #! type_mismatch
}

fun g = (P p) -> i32: ret match p {
    P.Two(x, 0) | P.Two(0, x) => x,
    P.I(k) | P.U(k) => 1, #! type_mismatch
    P.Two(a, 1) | P.Two(1, b) => 2, #! undefined_name undefined_name
    _ => 3,
}
