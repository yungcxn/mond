fun calc = () -> u32: ret 1;
fun pick = (u32 x where x == 0) -> u32: ret 0; #! no_matching_overload
fun pick = (u32 x where x == 1) -> u32: ret 1;
fun small = (type T stcwhere sizeof T <= 8) -> u64: ret sizeof T;
fun limited = (u32 x stcwhere x < 10) -> u32: ret x;
fun f = (bool c, u32 n) {
    if c: 1 else: "s"; #! type_mismatch
    calc() <- x;
    u32 y = x; #! undefined_name
    u32 z = stcmatch n { _ => 1 } #! not_static
    [3]u8 arr = [1, 2, 3];
    &u8 p = arr; #! type_mismatch
    &u8 q = arr.&;
    u64 big = small([16]u8); #! stcwhere_violated
    u32 dynamic = limited(n); #! not_static
    u32 over = limited(20); #! stcwhere_violated
    u32 fine = limited(3);
}
