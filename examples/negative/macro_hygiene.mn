# a name a quote declares is its own: the code around neither sees it nor is captured by it
fun hidden = () -> u32 {
    <quote { secret = 1; }>;
    ret secret; #! undefined_name
}

# `crash` at a tree reports at the code it is given
stcfun picky = (ast e) -> ast: ret crash (e, "not this");
fun reported = () -> u32: ret <picky(quote: 1)>; #! crash

main = () {}
