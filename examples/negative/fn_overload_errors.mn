fun ptr = (*i32 p) -> u32: ret 1;
fun ptr = (&i32 p) -> u32: ret 2;
fun only_mut = (*i32 p) -> u32: ret 1;
fun ar = (u32 a) -> u32: ret 1;
fun ar = (u32 a, u32 b) -> u32: ret 2;
fun fl = (f32 x) -> u32: ret 1;
fun fl = (f64 x) -> u32: ret 2;
fun wd = (i16 x) -> u32: ret 1;
fun wd = (i64 x) -> u32: ret 2;
fun rec = (u8 a, u16 b) -> u32: ret 1;
fun rec = (u16 a, u8 b) -> u32: ret 2;

fun f = (i32 v, i8 small, u8 ub, f32 x32) {
    mut i32 w = 1;
    ptr(w.&);
    ptr(v.&);
    only_mut(v.&); #! type_mismatch
    only_mut(w.&);
    ar(); #! no_matching_overload
    ar(1, 2, 3); #! no_matching_overload
    ar(1, 2);
    ar(c = 1); #! no_matching_overload
    fl(1.5); #! ambiguous_overload
    fl(x32);
    fl(v); #! no_matching_overload
    wd(small); #! ambiguous_overload
    wd(1); #! ambiguous_overload
    wd(v);
    rec(ub, ub); #! ambiguous_overload
    rec(1, 1); #! ambiguous_overload
    rec(1, 300);
}

$main = () {}
