stc u32 total = 0;
stc u32 G = 1;

# a function called from a stcfun may not write outside state either
fun add_total = (u32 x) -> u32 { total += x; ret total; } #! impure_stcfun
stcfun via_fun = () -> u32: ret add_total(1);
stc u32 VF = via_fun();

# neither through a pointer to a global
stcfun ptr_global = () -> u32 { *u32 p = G.&; p.* = 7; ret G; } #! impure_stcfun
stc u32 PG = ptr_global();

# a static initializer outside any stcfun may run the same function, in declaration order
stc u32 TOP = add_total(5); #= TOP 5
stc u32 AFTER = total; #= AFTER 5
stcfun reads = () -> u32: ret total + G;
stc u32 RD = reads(); #= RD 6

# its own locals and pointers to them are fine
stcfun local_ok = () -> u32 {
    mut u32 t = 0;
    *u32 p = t.&;
    p.* += 3;
    t += 1;
    ret t;
}
stc u32 LO = local_ok(); #= LO 4

# a pointer is no static argument of a stcfun
stcfun through = (*u32 p) { p.* = 4; }
stcfun caller = () -> u32 { mut u32 x = 0; through(x.&); ret x; } #! not_static
stc u32 TH = caller();

$main = () {}
