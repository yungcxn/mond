# a variant without a tag can't tell its cases apart: matching a case, `tagof`, `==` and a case as
# an int need one; a tag written for it doesn't fit
variant Word = +(Int(u32), Float(f32), Tagged(u8) = 3) notagtype; #! tag_overflow
fun cases = (Word w) -> u32: ret match w { Word.Int(i) => i, _ => 0 }; #! untagged_variant
fun tag = (Word w) -> u8: ret tagof w; #! untagged_variant
fun equal = (Word a, Word b) -> bool: ret a == b; #! untagged_variant
type Holder = *(Word w);
fun equal_inside = (Holder a, Holder b) -> bool: ret a == b; #! untagged_variant
fun as_int = () -> u32: ret Word.Int(3) as u32; #! untagged_variant

# `_` is no tag type: a variant without a tag says `notagtype`
variant Old = +(A(u8), B(u16)) tagtype _; #! undefined_name

# unwrapping needs a tag
fun unwrap = (Word w) -> u32: ret w ?? 0; #! untagged_variant

main = () {}
