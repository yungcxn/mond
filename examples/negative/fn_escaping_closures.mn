# a closure never outlives the frame that made it, nor does what holds one
type IntFn = (i32) -> i32;
type Holder = *(mut IntFn f);
mut IntFn KEPT = (i32 x): x;
fun puts_back = (IntFn f);
stcfun twice = (IntFn f): (i32 x) -> i32: ret f(f(x));
fun apply = (IntFn f, i32 v) -> i32: ret f(v);

fun returned = (i32 n) -> IntFn: ret (i32 x): x * n;   #! escaping_closure
fun short_form = (i32 n): (i32 x): x + n;             #! escaping_closure
fun named = (i32 n) -> IntFn {
    fun scale = (i32 x): x * n;
    ret scale;                                         #! escaping_closure
}
fun passed_on = (IntFn f) -> IntFn: ret f;             #! escaping_closure
fun stored = (i32 n, *Holder out) {
    KEPT = (i32 x): x + n;                             #! escaping_closure
    out.f = (i32 x): x - n;                            #! escaping_closure
    puts_back((i32 x): x * n);                         #! escaping_closure
}
fun in_aggregate = (i32 n) -> Holder: ret Holder((i32 x): x + n);   #! escaping_closure
fun as_static = (i32 n) -> i32 {
    fun add_n = (i32 x): x + n;
    ret twice(add_n)(1);                               #! not_static
}
# all fine: called, passed down, kept in the frame, static functions anywhere
fun allowed = (i32 n) -> IntFn {
    fun add_n = (i32 x): x + n;
    mut Holder local = Holder(add_n);
    local.f = (i32 x): x * n;
    i32 r = apply(add_n, 1) + local.f(2);
    KEPT = (i32 x): x;
    ret twice((i32 x): x + 1);
}
main = () {}
