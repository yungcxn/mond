fun pick = (i32 a) -> u32: ret 1;
fun pick = (f32 a) -> u32: ret 2;
fun pick = (u8 a) -> u32: ret 3;
fun pick = (i64 a) -> u32: ret 4;

fun mixed = (u32 a) -> u32: ret 1;
fun mixed = (u32 a, u32 b = 5) -> u32: ret 2;

fun pair = (u32 a, u32 b) -> u32: ret 1;
fun pair = (u32 a, u32 c) -> u32: ret 2;

fun opt = (u32 a, u32 b = 1) -> u32: ret a;

fun f = (i32 n) {
    pick(1); #! ambiguous_overload
    pick(-1); #! ambiguous_overload
    pick(300); #! ambiguous_overload
    pick(1.5);
    pick("s"); #! no_matching_overload
    mixed(1); #! ambiguous_overload
    mixed(1, 2);
    pair(1, 2); #! ambiguous_overload
    pair(1, b = 2);
    opt(); #! wrong_arity
    opt(1, 2, 3); #! wrong_arity
    opt(1, c = 2); #! unknown_named_argument
    opt(b = 2); #! wrong_arity
    opt("s"); #! type_mismatch
}
