# BUG: all of these are accepted without a diagnostic, but hand out write access to something read only
#   *i32 p = imm.&;  *i32 p = param.&;               a mutable pointer to an immutable variable
#   *i32 p = ip.x.&;  *i32 p = mp.x.&;               a mutable pointer to a non mut field, also `ip.y.&` for a mut field of an immutable value
#   takes_mut(rp.y.&);  takes_mut(rq.minner.y.&);    a mutable pointer taken through a `&P` / `&Q`
#   *P d = ip.&;  *P d = rq.minner.&;                a mutable pointer to an immutable record
#   ip.bump();  rp.bump();  rp.set_arr();            a method that writes `self` called on an immutable variable or through `&P`
#   *u8 s = "text".&;                                a mutable pointer to a string literal
#   *i32 t = (imm + 1).&;                            the address of a temporary
#   for x in arr { *i32 p = x.&; }                   a mutable pointer to the loop copy
# the written-through cases below are the ones that are rejected

type P = *(i32 x, mut i32 y, mut [3]i32 arr, [3]i32 farr);
type Q = *(P inner, mut P minner);

fun takes_mut = (*i32 p) { p.* = 1; }
fun takes_ro = (&i32 p) -> i32: ret p.*;
fun takes_mut_p = (*P p) {}
fun widen = (&i32 p) -> *i32: ret p; #! type_mismatch
fun keep = (*i32 p) -> &i32: ret p;
fun reborrow = (&P p) -> *P: ret p; #! type_mismatch

fun f = (&P rp, *P wp, &Q rq, *Q wq, &[3]i32 ra, *[3]i32 wa, &i32 ri, *i32 wi) {
    P ip = P(x = 1, y = 2, arr = [1, 2, 3], farr = [4, 5, 6]);
    mut P mp = P(x = 1, y = 2, arr = [1, 2, 3], farr = [4, 5, 6]);
    [3]i32 ia = [1, 2, 3];
    rq.minner.y = 5; #! write_through_immutable_pointer
    rq.inner.x = 5; #! write_through_immutable_pointer
    rq.minner.arr[0] = 3; #! write_through_immutable_pointer
    wq.inner.y = 5; #! assign_to_immutable
    wq.inner.arr[0] = 3; #! assign_to_immutable
    wq.minner.y = 5;
    wq.minner.x = 5; #! assign_to_immutable
    wq.minner.arr[2] = 5;
    wp.x = 1; #! assign_to_immutable
    wp.y++;
    wp.farr[1] = 4; #! assign_to_immutable
    wp.arr[1] = 4;
    rp.y += 1; #! write_through_immutable_pointer
    rp.y++; #! write_through_immutable_pointer
    rp.arr[1] = 4; #! write_through_immutable_pointer
    rp.* = mp; #! write_through_immutable_pointer
    wp.* = mp;
    ra[0] = 1; #! write_through_immutable_pointer
    wa[0] = 1;
    ri.* += 1; #! write_through_immutable_pointer
    wi.* += 1;
    mp.farr[1] = 4; #! assign_to_immutable
    ip.arr[1] = 4; #! assign_to_immutable
    ia[0] = 9; #! assign_to_immutable
    f2 = (): ia[0] += 1; #! assign_to_immutable
    mut i32 counter = 0;
    f3 = (): counter += 1;
    *i32 c1 = widen(ri);
    takes_mut(ri); #! type_mismatch
    takes_mut(ri.*.&);
    takes_ro(wi);
    takes_mut_p(rp); #! type_mismatch
    takes_mut_p(rq.minner.&);
    takes_mut_p(wp);
    *P d1 = rp; #! type_mismatch
    *P d2 = reborrow(wp);
    *P d3 = rp as *P; #! invalid_cast
    *i32 d4 = ri as *i32; #! invalid_cast
    &P e1 = wp;
    &i32 e2 = wi;
    mut *i32 g1 = wi;
    g1 = ri; #! type_mismatch
    mut &i32 g2 = wi;
    g2 = ri;
    g2.* = 5; #! write_through_immutable_pointer
    mut *[3]i32 walk = wa;
    walk = ra; #! type_mismatch
    walk[0] = 2;
    mut &[3]i32 rwalk = ra;
    rwalk[0] = 2; #! write_through_immutable_pointer
    rwalk = wa;
    *i32 h1 = 0; #! type_mismatch
    *i32 h2 = true; #! type_mismatch
    &i32 h3 = "s"; #! type_mismatch
}
