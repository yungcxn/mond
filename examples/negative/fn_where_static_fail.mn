# a where clause failing in a static call without a fallback in its dispatch group
fun lone = (u32 x where x > 0) -> u32: ret 1;
# a fallback with another parameter name is another dispatch group
fun solo = (u32 x where x > 0) -> u32: ret 1;
fun solo = (u32 y) -> u32: ret 2;
fun fine = (u32 x where x > 0) -> u32: ret 1;
fun fine = (u32 x) -> u32: ret 2;
stc u32 L = lone(0); #! no_matching_overload
stc u32 S = solo(0); #! no_matching_overload
stc u32 L1 = lone(1); #= L1 1
stc u32 F = fine(0) * 10 + fine(5); #= F 21
$main = () {}
