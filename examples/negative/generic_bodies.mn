type Bad = (type T): *(T x) !{
    fun f = () -> T: ret "s"; #! type_mismatch type_mismatch
}

type A = Bad(i32);
type B = Bad(u8);
type C = Bad(i32);

fun sum = (&[]u32 a) -> u32: ret lenof a; #! type_mismatch type_mismatch

fun use = () {
    u32 x = sum([1, 2].&);
    u32 y = sum([1, 2, 3].&);
    u32 z = sum([4, 5].&);
}

type Boxed = (type T): *(T v) !{ fun get = () -> T: ret self.v + 1; } #! type_mismatch

type BB = Boxed(bool);
type BI = Boxed(i32);

# an instantiation that fails is reported in its body only, not again where it is called
fun per_type = (type T) -> u32: ret stcif sizeof T > 4: undefined_wide else: 1; #! undefined_name
stc u32 NARROW = per_type(u32);
stc u32 WIDE = per_type(u64);
