# literals take the expected type only when their value fits it exactly
fun f = () {
    u8 a0 = 255;
    u8 a1 = 256; #! type_mismatch
    u8 a2 = 0xFF;
    u8 a3 = 0x100; #! type_mismatch
    u8 a4 = 0b11111111;
    u8 a5 = 0b100000000; #! type_mismatch
    u8 a6 = 0o377;
    u8 a7 = 0o400; #! type_mismatch
    u8 a8 = -0; 
    u8 a9 = -1; #! type_mismatch
    i8 b0 = 127;
    i8 b1 = 128; #! type_mismatch
    i8 b2 = -128;
    i8 b3 = -129; #! type_mismatch
    u16 c0 = 65535;
    u16 c1 = 65536; #! type_mismatch
    i16 c2 = -32768;
    i16 c3 = -32769; #! type_mismatch
    i16 c4 = 32768; #! type_mismatch
    u32 d0 = 4294967295;
    u32 d1 = 4294967296; #! type_mismatch
    i32 d2 = -2147483648;
    i32 d3 = -2147483649; #! type_mismatch
    i32 d4 = 2147483648; #! type_mismatch
    u64 e0 = 18446744073709551615;
    u64 e1 = 18446744073709551616; #! type_mismatch
    i64 e2 = -9223372036854775808;
    i64 e3 = 9223372036854775808; #! type_mismatch
    i64 e4 = 9223372036854775807;
    u8 g0 = 'a';
    i8 g1 = 'a';
    u8 g2 = '\xff';
    i8 g3 = '\xff'; #! type_mismatch
    u64 g4 = 1_000_000_000_000;
    u32 g5 = 1_000_000_000_000; #! type_mismatch
    u8 h0 = - -255;
    u8 h1 = -(-256); #! type_mismatch
}

$main = () {}
