# a rejected call of a length generic function must not fix the length for later calls
fun len_of = (&[]i32 xs, i32 v) -> u64: ret xs.$len + v as u64;

fun bad_scalar = () -> u64 {
    [3]i32 a = [1, 2, 3];
    u32 wide = 1;
    ret len_of(a.&, wide); #! type_mismatch
}

fun bad_elem = () -> u64 {
    [4]u8 b = [1, 2, 3, 4];
    ret len_of(b.&, 1); #! type_mismatch
}

fun good_after = () -> u64 {
    [5]i32 c = [1, 3, 3, 8, 9];
    [2]i32 d = [7, 7];
    ret len_of(c.&, 0) + len_of(d.&, 1);
}

$main = () {}
