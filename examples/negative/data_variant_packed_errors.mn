# a packed variant has no size: only a parameter or a pointer has its type, its cases differ in size
# so they don't cast into each other, and through a pointer only the tag is read
variant Msg = ++(Ping(u8 seq), Data(u64 a, u64 b), Quit);
variant Bare = ++(Small(u8), Large(u64)) tagtype _;
type Holder = *(Msg m); #! unstorable_outside_parameter
fun make = () -> Msg: ret Msg.Quit; #! unstorable_outside_parameter
fun local = (Msg m) { Msg copy = m; } #! unstorable_outside_parameter
fun nested = ([2]Msg ms) {} #! unstorable_outside_parameter
fun cast = (Msg.Ping p) -> Msg.Data: ret p as Msg.Data; #! invalid_cast
type Slot = *(&Msg any);
fun through = (Slot s) -> Msg.Ping: ret s.any.*; #! unstorable_dereference
fun read_tag = (Slot s) -> u8: ret tagof s.any;
fun untagged = (&Bare b) -> u8: ret tagof b; #! untagged_variant
fun local_set = (u32 ||| f32 x) { u32 ||| f32 y = x; } #! unstorable_outside_parameter
variant Mixed = Msg || u32; #! unstorable_outside_parameter

main = () {}
