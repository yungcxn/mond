type P = *(mut i32 x, *i32 wp, &i32 rp);

# LIMIT: `&&` is a single token, a pointer to a read only pointer needs a space
fun f = (&*i32 ro_to_rw, *&i32 rw_to_ro, **i32 rw_rw, & &i32 ro_ro, &i32 ri, *i32 wi, P rec, &[4]i32 ra, *[4]i32 wa) {
    mut i32 v = 0;
    ro_to_rw.*.* = 1;
    ro_to_rw.* = v.&; #! write_through_immutable_pointer
    rw_to_ro.*.* = 1; #! write_through_immutable_pointer
    rw_to_ro.* = ri;
    rw_rw.*.* = 1;
    rw_rw.* = wi;
    ro_ro.*.* = 1; #! write_through_immutable_pointer
    ro_ro.* = ri; #! write_through_immutable_pointer
    ri += 1; #! assign_to_immutable
    ri++; #! assign_to_immutable
    mut &i32 walk = ri;
    walk += 1;
    walk--;
    (walk + 1).* = 3; #! write_through_immutable_pointer
    mut *i32 wwalk = wi;
    (wwalk + 1).* = 3;
    wwalk++.* = 4;
    rec.wp.* = 1;
    rec.rp.* = 1; #! write_through_immutable_pointer
    rec.wp = wi; #! assign_to_immutable
    rec.x = 1; #! assign_to_immutable
    ra.*[0] = 1; #! write_through_immutable_pointer
    wa.*[0] = 1;
    ra.* = [1, 2, 3, 4]; #! write_through_immutable_pointer
    wa.* = [1, 2, 3, 4];
    i32 n = 5;
    i32 d = n.*; #! type_mismatch
    *i32 sum = wi + wi; #! type_mismatch
    *i32 diff = wi - wi; #! type_mismatch
    *i32 prod = wi * 2; #! type_mismatch
    *i32 fl = wi + 1.5; #! type_mismatch
    *i32 back = 1 - wi; #! type_mismatch
    *i32 front = 1 + wi;
    bool lt = wi < wwalk;
    bool eq = wi == wwalk;
    bool mixed = wi == 1; #! type_mismatch
    *i32 lit_ptr = (5).&; #! type_mismatch
    &i32 ro_lit = (5).&;
    *i32 from_imm = n.&; #! type_mismatch
}

$main = () {}
