# an array collected from a range with run-time bounds has a run-time length, which is never static
fun collected = (u64 lo, u64 hi) -> u64 {
    []u64 values = for i in lo..<hi: i * 2;
    mut u64 n = 0;
    for v in values: n += v;                                     #! not_static
    ret n + values.$len;                                         #! not_static
}
fun indexed = (u64 lo, u64 hi) -> u64 {
    []u64 values = for i in lo..<hi: i * 2;
    ret values[0];
}
$main = () {}
