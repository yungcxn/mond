fun is_digit = (u8 c) -> bool: ret c >= '0' and c <= '9';

fun is_hex = (u8 c) -> bool: ret is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F');

type Json = *(
    &[]u8 s,
    mut u32 p,
    mut u32 depth,
    mut u32 maxd,
    mut u32 nval,
    mut u32 narr,
    mut u32 nobj,
    mut u32 nstr,
    mut u32 nnum,
    mut u32 nlit,
    mut u32 nkey,
    mut u32 err,
    mut bool failed,
) !{
    fun peek = () -> u8 {
        if (self.p as u64) >= self.s.$len: ret 0;
        ret self.s.*[self.p];
    }

    fun fail = () {
        if !self.failed {
            self.failed = true;
            self.err = self.p;
        }
    }

    fun ws = () {
        loop {
            u8 c = self.peek();
            if c == ' ' or c == '\t' or c == '\n' or c == '\r': self.p += 1 else: brk;
        }
    }

    fun digits = () -> u32 {
        mut u32 n = 0;
        while is_digit(self.peek()) {
            self.p += 1;
            n += 1;
        }
        ret n;
    }

    fun number = () {
        if self.peek() == '-': self.p += 1;
        u8 c = self.peek();
        if c == '0' {
            self.p += 1;
        } else if c >= '1' and c <= '9' {
            do self.digits();
        } else {
            self.fail();
            ret;
        }
        if self.peek() == '.' {
            self.p += 1;
            if self.digits() == 0: self.fail();
        }
        u8 e = self.peek();
        if e == 'e' or e == 'E' {
            self.p += 1;
            u8 sign = self.peek();
            if sign == '+' or sign == '-': self.p += 1;
            if self.digits() == 0: self.fail();
        }
        self.nnum += 1;
    }

    fun literal = (&[]u8 w) {
        for k in 0..<w.$len {
            if self.peek() != w.*[k] {
                self.fail();
                ret;
            }
            self.p += 1;
        }
        self.nlit += 1;
    }

    fun string_body = () {
        self.p += 1;
        loop {
            if (self.p as u64) >= self.s.$len {
                self.fail();
                ret;
            }
            u8 c = self.peek();
            if c == '"' {
                self.p += 1;
                ret;
            }
            if c < 0x20 {
                self.fail();
                ret;
            }
            if c == '\\' {
                self.p += 1;
                u8 e = self.peek();
                match e {
                    '"' | '\\' | '/' | 'b' | 'f' | 'n' | 'r' | 't' => self.p += 1,
                    'u' => {
                        self.p += 1;
                        for 0..<4 {
                            if !is_hex(self.peek()) {
                                self.fail();
                                ret;
                            }
                            self.p += 1;
                        }
                    },
                    _ => {
                        self.fail();
                        ret;
                    },
                }
            } else {
                self.p += 1;
            }
        }
    }

    fun open = () {
        self.depth += 1;
        if self.depth > self.maxd: self.maxd = self.depth;
        if self.depth > 6: self.fail();
    }

    fun array = () {
        self.open();
        self.narr += 1;
        self.p += 1;
        self.ws();
        if self.peek() == ']' {
            self.p += 1;
            self.depth -= 1;
            ret;
        }
        loop {
            self.value();
            if self.failed: ret;
            self.ws();
            u8 c = self.peek();
            if c == ',' {
                self.p += 1;
            } else if c == ']' {
                self.p += 1;
                brk;
            } else {
                self.fail();
                ret;
            }
        }
        self.depth -= 1;
    }

    fun object = () {
        self.open();
        self.nobj += 1;
        self.p += 1;
        self.ws();
        if self.peek() == '}' {
            self.p += 1;
            self.depth -= 1;
            ret;
        }
        loop {
            self.ws();
            if self.peek() != '"' {
                self.fail();
                ret;
            }
            self.string_body();
            self.nkey += 1;
            self.ws();
            if self.peek() != ':' {
                self.fail();
                ret;
            }
            self.p += 1;
            self.value();
            if self.failed: ret;
            self.ws();
            u8 c = self.peek();
            if c == ',' {
                self.p += 1;
            } else if c == '}' {
                self.p += 1;
                brk;
            } else {
                self.fail();
                ret;
            }
        }
        self.depth -= 1;
    }

    fun value = () {
        self.ws();
        self.nval += 1;
        u8 c = self.peek();
        match c {
            '{' => self.object(),
            '[' => self.array(),
            '"' => {
                self.string_body();
                self.nstr += 1;
            },
            't' => self.literal("true".&),
            'f' => self.literal("false".&),
            'n' => self.literal("null".&),
            '-' | '0'..='9' => self.number(),
            _ => self.fail(),
        }
    }

    fun document = () {
        self.value();
        if self.failed: ret;
        self.ws();
        if (self.p as u64) < self.s.$len: self.fail();
    }
}

fun parse = (&[]u8 s) -> Json {
    ret Json(s = s, p = 0, depth = 0, maxd = 0, nval = 0, narr = 0, nobj = 0, nstr = 0, nnum = 0, nlit = 0, nkey = 0, err = 0, failed = false);
}

fun check = (&[]u8 s) -> i32 {
    mut Json j = parse(s);
    j.document();
    ret if j.failed: j.err as i32 else: -1;
}

fun stats = (&[]u8 s) -> [8]u32 {
    mut Json j = parse(s);
    j.document();
    if j.failed: ret [0, 0, 0, 0, 0, 0, 0, 0];
    ret [j.nval, j.narr, j.nobj, j.nstr, j.nnum, j.nlit, j.nkey, j.maxd];
}

stc i32 J1 = check("null".&); #= J1 -1
stc i32 J2 = check("-0".&); #= J2 -1
stc i32 J3 = check("-3.5".&); #= J3 -1
stc i32 J4 = check("1E+5".&); #= J4 -1
stc i32 J5 = check("\"a\\\"b\"".&); #= J5 -1
stc i32 J6 = check("\"\\u00e9\"".&); #= J6 -1
stc i32 J7 = check("{}".&); #= J7 -1
stc i32 J8 = check("[1,2,3]".&); #= J8 -1
stc i32 J9 = check(" [ 1 , 2 ] ".&); #= J9 -1
stc i32 J10 = check("{\"a\":[1,{\"b\":null}],\"c\":\"d\"}".&); #= J10 -1
stc [8]u32 J11 = stats("{\"a\":[1,{\"b\":null}],\"c\":\"d\"}".&); #= J11 [6, 1, 2, 1, 1, 1, 3, 3]
stc i32 J12 = check("[[],[[]],{}]".&); #= J12 -1
stc [8]u32 J13 = stats("[[],[[]],{}]".&); #= J13 [5, 4, 1, 0, 0, 0, 0, 3]
stc i32 J14 = check("{\"k\":{\"k\":{\"k\":1}}}".&); #= J14 -1
stc [8]u32 J15 = stats("{\"k\":{\"k\":{\"k\":1}}}".&); #= J15 [4, 0, 3, 0, 1, 0, 3, 3]
stc i32 J16 = check("[1,[2,[3,[4,[5,[6]]]]]]".&); #= J16 -1
stc [8]u32 J17 = stats("[1,[2,[3,[4,[5,[6]]]]]]".&); #= J17 [12, 6, 0, 0, 6, 0, 0, 6]
stc i32 J18 = check("[1,[2,[3,[4,[5,[6,[7]]]]]]]".&); #= J18 18
stc i32 J19 = check("{\"a\":1,\"a\":2}".&); #= J19 -1
stc [8]u32 J20 = stats("{\"a\":1,\"a\":2}".&); #= J20 [3, 0, 1, 0, 2, 0, 2, 1]
stc i32 J21 = check("[true,false,null]".&); #= J21 -1
stc [8]u32 J22 = stats("[true,false,null]".&); #= J22 [4, 1, 0, 0, 0, 3, 0, 1]
stc i32 J23 = check("\n\t[1,\r\n2]\n".&); #= J23 -1
stc i32 J24 = check("".&); #= J24 0
stc i32 J25 = check("   ".&); #= J25 3
stc i32 J26 = check("[1".&); #= J26 2
stc i32 J27 = check("[1,]".&); #= J27 3
stc i32 J28 = check("[,1]".&); #= J28 1
stc i32 J29 = check("{\"a\"".&); #= J29 4
stc i32 J30 = check("{\"a\":1,}".&); #= J30 7
stc i32 J31 = check("{a:1}".&); #= J31 1
stc i32 J32 = check("{\"a\" 1}".&); #= J32 5
stc i32 J33 = check("[1 2]".&); #= J33 3
stc i32 J34 = check("[1] x".&); #= J34 4
stc i32 J35 = check("tru".&); #= J35 3
stc i32 J36 = check("truth".&); #= J36 3
stc i32 J37 = check("nulll".&); #= J37 4
stc i32 J38 = check("01".&); #= J38 1
stc i32 J39 = check("-".&); #= J39 1
stc i32 J40 = check("1.".&); #= J40 2
stc i32 J41 = check(".5".&); #= J41 0
stc i32 J42 = check("1e+".&); #= J42 3
stc i32 J43 = check("+1".&); #= J43 0
stc i32 J44 = check("\"abc".&); #= J44 4
stc i32 J45 = check("\"a\nb\"".&); #= J45 2
stc i32 J46 = check("\"\\x\"".&); #= J46 2
stc i32 J47 = check("\"\\u12g4\"".&); #= J47 5
stc i32 J48 = check("[1,2,3,".&); #= J48 7
stc i32 J49 = check("{\"a\":[1,2}".&); #= J49 9
stc i32 J50 = check("NaN".&); #= J50 0
stc i32 J51 = check("-Infinity".&); #= J51 1
stc i32 J52 = check("'a'".&); #= J52 0
stc i32 J53 = check("{\"a\":{\"b\":}}".&); #= J53 10
stc i32 J54 = check("[1.5e3,-2E-2,0.0]".&); #= J54 -1
stc [8]u32 J55 = stats("[1.5e3,-2E-2,0.0]".&); #= J55 [4, 1, 0, 0, 3, 0, 0, 1]

$main = () {}
