# half open intervals: sorting records, merging, inserting, sweeping events and finding gaps

type Iv = *(i32 lo, i32 hi);

type Set = *(mut [12]Iv items, mut u32 len = 0) !{
    fun add = (i32 lo, i32 hi) {
        self.items[self.len] = Iv(lo = lo, hi = hi);
        self.len += 1;
    }
    fun sort = () {
        for i in 1..<self.len {
            Iv key = self.items[i];
            mut u32 j = i;
            while j > 0 and (self.items[j - 1].lo > key.lo or self.items[j - 1].lo == key.lo and self.items[j - 1].hi > key.hi) {
                self.items[j] = self.items[j - 1];
                j -= 1;
            }
            self.items[j] = key;
        }
    }
    # touching intervals merge too: [1, 3) and [3, 5) become [1, 5)
    fun merged = () -> Set {
        mut Set c = self.*;
        c.sort();
        mut Set out = blank();
        for i in 0..<c.len {
            Iv x = c.items[i];
            if out.len > 0 and x.lo <= out.items[out.len - 1].hi {
                if x.hi > out.items[out.len - 1].hi: out.items[out.len - 1] = Iv(lo = out.items[out.len - 1].lo, hi = x.hi);
            } else: out.add(x.lo, x.hi);
        }
        ret out;
    }
    fun covered = () -> i32 {
        Set m = self.merged();
        mut i32 total = 0;
        for i in 0..<m.len: total += m.items[i].hi - m.items[i].lo;
        ret total;
    }
    fun digest = () -> i64 {
        mut i64 d = 0;
        for i in 0..<self.len: d = d * 1000 + self.items[i].lo as i64 * 30 + self.items[i].hi as i64;
        ret d;
    }
}

fun blank = () -> Set {
    mut Set s = Set(items = [Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0),
                             Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0), Iv(lo = 0, hi = 0)]);
    ret s;
}

# the maximum number of intervals alive at once: ends before starts at the same point
fun max_overlap = (&Set s) -> u32 {
    mut [24]i32 pts;
    mut u32 n = 0;
    for i in 0..<s.len {
        pts[n] = s.items[i].lo * 2 + 1;
        pts[n + 1] = s.items[i].hi * 2;
        n += 2;
    }
    for i in 1..<n {
        i32 key = pts[i];
        mut u32 j = i;
        while j > 0 and pts[j - 1] > key {
            pts[j] = pts[j - 1];
            j -= 1;
        }
        pts[j] = key;
    }
    mut u32 alive = 0;
    mut u32 best = 0;
    for i in 0..<n {
        if pts[i] % 2 == 1 {
            alive += 1;
            if alive > best: best = alive;
        } else: alive -= 1;
    }
    ret best;
}

# gaps inside [from, to) not covered by any interval
fun gaps = (&Set s, i32 from, i32 to) -> Set {
    Set m = s.merged();
    mut Set out = blank();
    mut i32 at = from;
    for i in 0..<m.len {
        Iv x = m.items[i];
        if x.hi <= at: cont;
        if x.lo >= to: brk;
        if x.lo > at: out.add(at, x.lo);
        at = x.hi;
    }
    if at < to: out.add(at, to);
    ret out;
}

fun sample = () -> Set {
    mut Set s = blank();
    s.add(15, 18);
    s.add(1, 3);
    s.add(8, 10);
    s.add(2, 6);
    s.add(10, 12);
    s.add(17, 20);
    ret s;
}

stcfun s_merge = () -> i64: ret sample().merged().digest();
stcfun s_sorted = () -> i64 {
    mut Set s = sample();
    s.sort();
    ret s.digest() % 1000000000;
}
stcfun s_cover = () -> i32: ret sample().covered();
stcfun s_overlap = () -> u32 {
    Set a = sample();
    mut Set b = blank();
    b.add(0, 10);
    b.add(1, 9);
    b.add(2, 8);
    b.add(8, 12);
    mut Set c = blank();
    c.add(1, 2);
    c.add(2, 3);
    c.add(3, 4);
    ret max_overlap(a.&) * 100 + max_overlap(b.&) * 10 + max_overlap(c.&);
}
stcfun s_gaps = () -> i64 {
    Set a = sample();
    Set g = gaps(a.&, 0, 25);
    Set h = gaps(a.&, 4, 9);
    Set e = gaps(blank().&, 3, 7);
    ret g.digest() * 10 + h.len as i64 + e.digest() * 0 + e.len as i64 * 100000000000000;
}
stcfun s_empty = () -> i32: ret blank().covered() + blank().merged().len as i32;

stc i64 MERGE = s_merge(); #= MERGE 36252470
stc i64 SORTED = s_sorted(); #= SORTED 312468530
stc i32 COVER = s_cover(); #= COVER 14
stc u32 OVER = s_overlap(); #= OVER 231
stc i64 GAPS = s_gaps(); #= GAPS 100011883756251
stc i32 EMPTY = s_empty(); #= EMPTY 0

$main = () -> i32 {
    Set s = sample();
    m = s.merged();
    first = m.items[0]; #: first *(i32 lo, i32 hi)
    ret m.len as i32 + s.covered() + max_overlap(s.&) as i32 + gaps(s.&, 0, 30).len as i32;
}
