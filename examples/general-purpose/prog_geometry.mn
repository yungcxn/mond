# integer computational geometry: convex hull, segment intersection, point in polygon, pick's theorem

type P = *(i64 x, i64 y);

fun cross = (P o, P a, P b) -> i64: ret (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
fun sgn = (i64 v) -> i32: ret if v > 0: 1 else: if v < 0: -1 else: 0;
fun before = (P a, P b) -> bool: ret a.x < b.x or a.x == b.x and a.y < b.y;

fun sort_points = (*[]P pts) {
    for i in 1..<pts.$len {
        P key = pts.*[i];
        mut u64 j = i;
        while j > 0 and before(key, pts.*[j - 1]) {
            pts.*[j] = pts.*[j - 1];
            j -= 1;
        }
        pts.*[j] = key;
    }
}

# andrew's monotone chain, collinear points dropped, returns the hull size and its doubled area
fun hull = (*[12]P pts, u32 n) -> i64 {
    sort_points(pts);
    mut [24]P h;
    mut u32 k = 0;
    for i in 0..<n {
        while k >= 2 and cross(h[k - 2], h[k - 1], pts.*[i]) <= 0: k -= 1;
        h[k] = pts.*[i];
        k += 1;
    }
    u32 lower = k + 1;
    mut u32 i = n - 1;
    while i > 0 {
        i -= 1;
        while k >= lower and cross(h[k - 2], h[k - 1], pts.*[i]) <= 0: k -= 1;
        h[k] = pts.*[i];
        k += 1;
    }
    k -= 1;
    mut i64 area2 = 0;
    for j in 0..<k {
        P a = h[j];
        P b = h[(j + 1) % k];
        area2 += a.x * b.y - b.x * a.y;
    }
    ret k as i64 * 10000 + area2;
}

fun on_segment = (P a, P b, P p) -> bool {
    bool xs = (if a.x < b.x: a.x else: b.x) <= p.x and p.x <= (if a.x > b.x: a.x else: b.x);
    bool ys = (if a.y < b.y: a.y else: b.y) <= p.y and p.y <= (if a.y > b.y: a.y else: b.y);
    ret xs and ys;
}

# proper and touching intersections, collinear overlap included
fun intersects = (P a, P b, P c, P d) -> bool {
    i32 d1 = sgn(cross(c, d, a));
    i32 d2 = sgn(cross(c, d, b));
    i32 d3 = sgn(cross(a, b, c));
    i32 d4 = sgn(cross(a, b, d));
    if d1 * d2 < 0 and d3 * d4 < 0: ret true;
    if d1 == 0 and on_segment(c, d, a): ret true;
    if d2 == 0 and on_segment(c, d, b): ret true;
    if d3 == 0 and on_segment(a, b, c): ret true;
    if d4 == 0 and on_segment(a, b, d): ret true;
    ret false;
}

# 0 outside, 1 inside, 2 on the boundary, by crossing count of a ray to the right
fun locate = (&[]P poly, P q) -> u32 {
    u64 n = poly.$len;
    mut bool inside = false;
    for i in 0..<n {
        P a = poly.*[i];
        P b = poly.*[(i + 1) % n];
        if cross(a, b, q) == 0 and on_segment(a, b, q): ret 2;
        bool up = a.y <= q.y and b.y > q.y;
        bool down = b.y <= q.y and a.y > q.y;
        if up and cross(a, b, q) > 0 or down and cross(a, b, q) < 0: inside = !inside;
    }
    ret if inside: 1 else: 0;
}

fun gcd = (i64 a0, i64 b0) -> i64 {
    mut i64 a = if a0 < 0: -a0 else: a0;
    mut i64 b = if b0 < 0: -b0 else: b0;
    while b != 0 {
        i64 t = a % b;
        a = b;
        b = t;
    }
    ret a;
}

# lattice points strictly inside a lattice polygon: area = i + b / 2 - 1
fun interior_points = (&[]P poly) -> i64 {
    u64 n = poly.$len;
    mut i64 a2 = 0;
    mut i64 boundary = 0;
    for i in 0..<n {
        P a = poly.*[i];
        P b = poly.*[(i + 1) % n];
        a2 += a.x * b.y - b.x * a.y;
        boundary += gcd(b.x - a.x, b.y - a.y);
    }
    if a2 < 0: a2 = -a2;
    ret (a2 - boundary + 2) / 2;
}

stcfun hulls = () -> i64 {
    mut [12]P pts = [P(x = 0, y = 0), P(x = 4, y = 0), P(x = 4, y = 4), P(x = 0, y = 4), P(x = 2, y = 2), P(x = 1, y = 3),
                     P(x = 2, y = 0), P(x = 3, y = 1), P(x = 0, y = 2), P(x = 5, y = 2), P(x = 2, y = 5), P(x = 1, y = 1)];
    ret hull(pts.&, 12);
}

stcfun segments = () -> u32 {
    mut u32 bits = 0;
    if intersects(P(x = 0, y = 0), P(x = 4, y = 4), P(x = 0, y = 4), P(x = 4, y = 0)): bits += 1;
    if intersects(P(x = 0, y = 0), P(x = 2, y = 2), P(x = 3, y = 3), P(x = 5, y = 5)): bits += 2;
    if intersects(P(x = 0, y = 0), P(x = 3, y = 3), P(x = 2, y = 2), P(x = 5, y = 5)): bits += 4;
    if intersects(P(x = 0, y = 0), P(x = 2, y = 0), P(x = 2, y = 0), P(x = 2, y = 5)): bits += 8;
    if intersects(P(x = 0, y = 0), P(x = 1, y = 1), P(x = 1, y = 0), P(x = 2, y = -1)): bits += 16;
    if intersects(P(x = 0, y = 0), P(x = 0, y = 0), P(x = 0, y = 0), P(x = 1, y = 1)): bits += 32;
    ret bits;
}

stcfun locations = () -> u32 {
    [6]P l = [P(x = 0, y = 0), P(x = 6, y = 0), P(x = 6, y = 2), P(x = 2, y = 2), P(x = 2, y = 6), P(x = 0, y = 6)];
    mut u32 s = 0;
    [7]P qs = [P(x = 1, y = 1), P(x = 4, y = 4), P(x = 6, y = 1), P(x = 2, y = 4), P(x = 1, y = 5), P(x = 7, y = 1), P(x = 3, y = 2)];
    for q in qs: s = s * 10 + locate(l.&, q);
    ret s;
}

stcfun picks = () -> i64 {
    [4]P sq = [P(x = 0, y = 0), P(x = 4, y = 0), P(x = 4, y = 4), P(x = 0, y = 4)];
    [3]P tri = [P(x = 0, y = 0), P(x = 5, y = 0), P(x = 0, y = 7)];
    [3]P thin = [P(x = 0, y = 0), P(x = 3, y = 1), P(x = 6, y = 2)];
    ret interior_points(sq.&) * 10000 + interior_points(tri.&) * 10 + interior_points(thin.&);
}

stc i64 HULL = hulls(); #= HULL 60040
stc u32 SEG = segments(); #= SEG 45
stc u32 LOC = locations(); #= LOC 1022102
stc i64 PICK = picks(); #= PICK 90119

$main = () -> i64 {
    [3]P t = [P(x = 0, y = 0), P(x = 3, y = 0), P(x = 0, y = 3)];
    c = cross(t[0], t[1], t[2]); #: c i64
    ret c + locate(t.&, P(x = 1, y = 1)) as i64 + interior_points(t.&);
}
