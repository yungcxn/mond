# hacker's delight style bit manipulation on fixed widths

# trailing zeros by a de bruijn multiply and table lookup
stc [32]u32 DEBRUIJN = [0, 1, 28, 2, 29, 14, 24, 3, 30, 22, 20, 15, 25, 17, 4, 8, 31, 27, 13, 23, 21, 19, 16, 7, 26, 12, 18, 6, 11, 5, 10, 9];

fun ctz = (u32 x) -> u32 {
    if x == 0: ret 32;
    ret DEBRUIJN[((x & (0 - x)) * 0x077CB531) >> 27];
}

# leading zeros by halving the search window
fun clz = (u32 x0) -> u32 {
    if x0 == 0: ret 32;
    mut u32 x = x0;
    mut u32 n = 0;
    if x <= 0x0000FFFF { n += 16; x = x << 16; }
    if x <= 0x00FFFFFF { n += 8; x = x << 8; }
    if x <= 0x0FFFFFFF { n += 4; x = x << 4; }
    if x <= 0x3FFFFFFF { n += 2; x = x << 2; }
    if x <= 0x7FFFFFFF: n += 1;
    ret n;
}

# next larger integer with the same number of set bits
fun gosper = (u32 x) -> u32 {
    u32 c = x & (0 - x);
    u32 r = x + c;
    ret (((r ^ x) >> 2) / c) | r;
}

# spread the low 16 bits to the even positions, interleave two coordinates
fun spread = (u32 x0) -> u32 {
    mut u32 x = x0 & 0xFFFF;
    x = (x | (x << 8)) & 0x00FF00FF;
    x = (x | (x << 4)) & 0x0F0F0F0F;
    x = (x | (x << 2)) & 0x33333333;
    x = (x | (x << 1)) & 0x55555555;
    ret x;
}

fun morton = (u32 x, u32 y) -> u32: ret spread(x) | (spread(y) << 1);

fun sign_extend = (u32 v, u32 bits) -> i32 {
    u32 m = 1 << (bits - 1);
    ret ((v ^ m) - m) as i32;
}

fun branchless_abs = (i32 x) -> i32 {
    i32 m = x >> 31;
    ret (x ^ m) - m;
}

fun branchless_min = (i32 a, i32 b) -> i32: ret b ^ ((a ^ b) & -(if a < b: 1 else: 0));

# number of subsets of a mask, enumerated by sub = (sub - 1) & mask
fun subsets = (u32 mask) -> u32 {
    mut u32 n = 1;
    mut u32 sub = mask;
    while sub != 0 {
        n += 1;
        sub = (sub - 1) & mask;
    }
    ret n;
}

# knight moves from every square of a chess board as u64 bitboards
stc u64 NOT_A = 0xFEFEFEFEFEFEFEFE;
stc u64 NOT_AB = 0xFCFCFCFCFCFCFCFC;
stc u64 NOT_H = 0x7F7F7F7F7F7F7F7F;
stc u64 NOT_GH = 0x3F3F3F3F3F3F3F3F;

fun knight = (u64 b) -> u64 {
    u64 l1 = (b >> 1) & NOT_H;
    u64 l2 = (b >> 2) & NOT_GH;
    u64 r1 = (b << 1) & NOT_A;
    u64 r2 = (b << 2) & NOT_AB;
    u64 h1 = l1 | r1;
    u64 h2 = l2 | r2;
    ret (h1 << 16) | (h1 >> 16) | (h2 << 8) | (h2 >> 8);
}

fun pop64 = (u64 x0) -> u32 {
    mut u64 x = x0;
    mut u32 n = 0;
    while x != 0 {
        x = x & (x - 1);
        n += 1;
    }
    ret n;
}

fun all_knight_moves = () -> u32 {
    mut u32 total = 0;
    for sq in 0..<64: total += pop64(knight(1 << sq as u64));
    ret total;
}

stcfun ctzs = () -> u64 {
    mut u64 s = 0;
    [6]u32 xs = [1, 8, 0x80000000, 0x00F00000, 12, 0];
    for x in xs: s = s * 100 + ctz(x);
    ret s;
}

stcfun clzs = () -> u64 {
    mut u64 s = 0;
    [6]u32 xs = [1, 0xFFFF, 0x10000, 0x80000000, 0x7FFFFFFF, 0];
    for x in xs: s = s * 100 + clz(x);
    ret s;
}

stcfun gospers = () -> u32 {
    mut u32 x = 0b0111;
    mut u32 n = 0;
    while x < 256 {
        n += 1;
        x = gosper(x);
    }
    ret n * 1000 + gosper(0b1011) ;
}

stc u32 MORTON = morton(5, 3); #= MORTON 27
stc u32 MORTON2 = morton(0xFFFF, 0); #= MORTON2 1431655765
stc i32 SX1 = sign_extend(0xF, 4); #= SX1 -1
stc i32 SX2 = sign_extend(0x7, 4); #= SX2 7
stc i32 SX3 = sign_extend(0x80, 8); #= SX3 -128
stc i32 ABS = branchless_abs(-17) * 100 + branchless_abs(17); #= ABS 1717
stc i32 MIN = branchless_min(-3, 9) * 100 + branchless_min(4, 2); #= MIN -298
stc u32 SUBS = subsets(0b1011) * 100 + subsets(0); #= SUBS 801
stc u32 KN = all_knight_moves(); #= KN 336
stc u32 KC = pop64(knight(1)) * 10 + pop64(knight(1 << 27)); #= KC 28
stc u64 CTZ = ctzs(); #= CTZ 331200232
stc u64 CLZ = clzs(); #= CLZ 311615000132
stc u32 GOS = gospers(); #= GOS 56013

$main = () -> i32 {
    c = ctz(40); #: c u32
    k = knight(1 << 63); #: k u64
    ret (c + clz(40) + pop64(k) + morton(1, 1)) as i32 + sign_extend(3, 2);
}
