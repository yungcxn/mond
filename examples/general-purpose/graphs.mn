stc u32 INF = 1000000;

type Graph = (u32 N): *(mut [N][N]u32 w, mut u32 edges = 0) !{
    fun link = (u32 a, u32 b, u32 weight) {
        self.w[a][b] = weight;
        self.w[b][a] = weight;
        self.edges += 1;
    }

    fun arc = (u32 a, u32 b, u32 weight) {
        self.w[a][b] = weight;
        self.edges += 1;
    }

    fun bfs_order = (u32 start) -> u64 {
        mut [N]bool seen;
        mut [N]u32 queue;
        mut u32 head = 0;
        mut u32 tail = 0;
        queue[tail] = start;
        tail += 1;
        seen[start] = true;
        mut u64 order = 0;
        while head < tail {
            u32 v = queue[head];
            head += 1;
            order = order * 10 + v;
            for u in 0..<N {
                if self.w[v][u] != 0 and !seen[u] {
                    seen[u] = true;
                    queue[tail] = u;
                    tail += 1;
                }
            }
        }
        ret order;
    }

    fun dfs = (u32 v, *[N]bool seen) -> u32 {
        seen.*[v] = true;
        mut u32 n = 1;
        for u in 0..<N: if self.w[v][u] != 0 and !seen.*[u]: n += self.dfs(u, seen);
        ret n;
    }

    fun components = () -> u32 {
        mut [N]bool seen;
        mut u32 c = 0;
        for v in 0..<N {
            if !seen[v] {
                do self.dfs(v, seen.&);
                c += 1;
            }
        }
        ret c;
    }

    fun dijkstra = (u32 src, u32 dst) -> u32 {
        mut [N]u32 dist;
        mut [N]bool done;
        for i in 0..<N: dist[i] = INF;
        dist[src] = 0;
        for 0..<N {
            mut u32 best = INF;
            mut u32 at = N;
            for i in 0..<N: if !done[i] and dist[i] < best { best = dist[i]; at = i; }
            if at == N: brk;
            done[at] = true;
            for u in 0..<N {
                u32 wt = self.w[at][u];
                if wt != 0 and dist[at] + wt < dist[u]: dist[u] = dist[at] + wt;
            }
        }
        ret dist[dst];
    }

    fun bipartite = () -> bool {
        mut [N]i32 color;
        for i in 0..<N: color[i] = -1;
        for s in 0..<N {
            if color[s] != -1: cont;
            color[s] = 0;
            mut [N]u32 stack;
            mut u32 sp = 1;
            stack[0] = s;
            while sp > 0 {
                sp -= 1;
                u32 v = stack[sp];
                for u in 0..<N {
                    if self.w[v][u] == 0: cont;
                    if color[u] == -1 {
                        color[u] = 1 - color[v];
                        stack[sp] = u;
                        sp += 1;
                    } else: if color[u] == color[v]: ret false;
                }
            }
        }
        ret true;
    }
}

fun floyd = (*[5][5]u32 d) {
    for k in 0..<5: for i in 0..<5: for j in 0..<5 {
        if d.*[i][k] + d.*[k][j] < d.*[i][j]: d.*[i][j] = d.*[i][k] + d.*[k][j];
    }
}

fun topo = (&[6][6]u8 adj) -> u64 {
    mut [6]u32 indeg;
    for i in 0..<6: for j in 0..<6: indeg[j] += adj.*[i][j] as u32;
    mut [6]u32 queue;
    mut u32 head = 0;
    mut u32 tail = 0;
    for i in 0..<6: if indeg[i] == 0 { queue[tail] = i; tail += 1; }
    mut u64 order = 0;
    while head < tail {
        u32 v = queue[head];
        head += 1;
        order = order * 10 + v;
        for u in 0..<6 {
            if adj.*[v][u] == 1 {
                indeg[u] -= 1;
                if indeg[u] == 0 { queue[tail] = u; tail += 1; }
            }
        }
    }
    ret if tail == 6: order else: 0;
}

# BUG: a template value parameter in a field default (`mut u32 sets = N`) reports undefined_name, so `sets` is set in init_all
type Dsu = (u32 N): *(mut [N]u32 parent, mut [N]u32 size, mut u32 sets) !{
    fun init_all = () {
        self.sets = N;
        for i in 0..<N {
            self.parent[i] = i;
            self.size[i] = 1;
        }
    }

    fun find = (u32 x) -> u32 {
        mut u32 r = x;
        while self.parent[r] != r: r = self.parent[r];
        mut u32 c = x;
        while self.parent[c] != r {
            u32 next = self.parent[c];
            self.parent[c] = r;
            c = next;
        }
        ret r;
    }

    fun union = (u32 a, u32 b) -> bool {
        mut u32 ra = self.find(a);
        mut u32 rb = self.find(b);
        if ra == rb: ret false;
        if self.size[ra] < self.size[rb] {
            u32 t = ra;
            ra = rb;
            rb = t;
        }
        self.parent[rb] = ra;
        self.size[ra] += self.size[rb];
        self.sets -= 1;
        ret true;
    }
}

type Edge = *(u32 a, u32 b, u32 w);

fun kruskal = (*[7]Edge edges) -> u32 {
    for i in 1..<7 {
        mut u64 j = i;
        while j > 0 and edges.*[j - 1].w > edges.*[j].w {
            Edge t = edges.*[j];
            edges.*[j] = edges.*[j - 1];
            edges.*[j - 1] = t;
            j -= 1;
        }
    }
    mut Dsu(5) d;
    d.init_all();
    mut u32 total = 0;
    for e in edges.*: if d.union(e.a, e.b): total += e.w;
    ret total * 10 + d.sets;
}

stcfun build = () -> Graph(6) {
    mut Graph(6) g;
    g.link(0, 1, 7); g.link(0, 2, 9); g.link(0, 5, 14);
    g.link(1, 2, 10); g.link(1, 3, 15);
    g.link(2, 3, 11); g.link(2, 5, 2);
    g.link(3, 4, 6); g.link(4, 5, 9);
    ret g;
}

stcfun split = () -> Graph(7) {
    mut Graph(7) g;
    g.link(0, 1, 1); g.link(1, 2, 1); g.link(3, 4, 1); g.link(5, 6, 1);
    ret g;
}

stcfun odd_cycle = (bool odd) -> bool {
    mut Graph(5) g;
    g.link(0, 1, 1); g.link(1, 2, 1); g.link(2, 3, 1);
    if odd: g.link(2, 0, 1) else: g.link(3, 4, 1);
    ret g.bipartite();
}

stcfun apsp = () -> u32 {
    mut [5][5]u32 d;
    for i in 0..<5: for j in 0..<5: d[i][j] = if i == j: 0 else: INF;
    d[0][1] = 3; d[1][2] = 4; d[2][3] = 1; d[3][4] = 2; d[0][4] = 20; d[4][0] = 1;
    floyd(d.&);
    ret d[0][4] * 100 + d[4][3] * 10 + d[1][0];
}

stcfun run_topo = (bool cyclic) -> u64 {
    mut [6][6]u8 adj;
    adj[5][2] = 1; adj[5][0] = 1; adj[4][0] = 1; adj[4][1] = 1; adj[2][3] = 1; adj[3][1] = 1;
    if cyclic: adj[1][5] = 1;
    ret topo(adj.&);
}

stcfun run_kruskal = () -> u32 {
    mut [7]Edge es = [
        Edge(0, 1, 7), Edge(0, 3, 5), Edge(1, 2, 8), Edge(1, 3, 9),
        Edge(1, 4, 7), Edge(2, 4, 5), Edge(3, 4, 15),
    ];
    ret kruskal(es.&);
}

stc u64 BF = build().bfs_order(0); #= BF 12534
stc u32 DJ = build().dijkstra(0, 4); #= DJ 20
stc u32 DJ2 = build().dijkstra(0, 3); #= DJ2 20
stc u32 DJ3 = split().dijkstra(0, 2); #= DJ3 2
stc u32 DJ4 = split().dijkstra(0, 4); #= DJ4 1000000
stc u32 CC = split().components(); #= CC 3
stc u32 CC1 = build().components(); #= CC1 1
stc bool BP1 = odd_cycle(false); #= BP1 true
stc bool BP2 = odd_cycle(true); #= BP2 false
stc u32 AP = apsp(); #= AP 1098
stc u64 TS = run_topo(false); #= TS 450231
stc u64 TC = run_topo(true); #= TC 0
stc u32 KR = run_kruskal(); #= KR 241

$main = () {}
