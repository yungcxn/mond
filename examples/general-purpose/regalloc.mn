stc u32 A30 = pressure([6, 11, 12, 9, 7, 2, 5, 1, 0].&, [9, 19, 16, 14, 14, 7, 12, 8, 6].&); #= A30 4
stc [12]u32 A31 = color_intervals([6, 11, 12, 9, 7, 2, 5, 1, 0].&, [9, 19, 16, 14, 14, 7, 12, 8, 6].&); #= A31 [3, 2, 0, 3, 1, 1, 0, 2, 3, 0, 0, 0]
