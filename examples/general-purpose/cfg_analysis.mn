fun bit = (u32 i) -> u32: ret 1 << i;

fun hex = (u8 c) -> u32: ret match c {
    '0'..='9' => (c - '0') as u32,
    'a'..='f' => (c - 'a') as u32 + 10,
    _ => 99,
}

fun popcount = (u32 m) -> u32 {
    mut u32 n = 0;
    mut u32 x = m;
    while x != 0 {
        n += x & 1;
        x = x >> 1;
    }
    ret n;
}

type Cfg = *(
    u32 n,
    mut [10]u32 succ,
    mut [10]u32 pred,
    mut [10]u32 dom,
    mut [10]u32 lin,
    mut [10]u32 lout,
    mut u32 bad,
) !{
    fun build = (&[]u8 edges) {
        mut u32 i = 0;
        while (i as u64) + 1 < edges.$len {
            u8 c = edges.*[i];
            if c == ' ' {
                i += 1;
                cont;
            }
            u32 a = hex(c);
            u32 b = hex(edges.*[i + 1]);
            if a >= self.n or b >= self.n {
                self.bad = 1;
            } else {
                self.succ[a] = self.succ[a] | bit(b);
                self.pred[b] = self.pred[b] | bit(a);
            }
            i += 2;
        }
    }

    fun reach = () -> u32 {
        mut u32 mask = 1;
        loop {
            mut bool changed = false;
            for i in 0..<self.n {
                if (mask & bit(i)) != 0 and (mask | self.succ[i]) != mask {
                    mask = mask | self.succ[i];
                    changed = true;
                }
            }
            if !changed: ret mask;
        }
        ret mask;
    }

    fun doms = () -> u32 {
        u32 all = self.reach();
        for i in 0..<self.n {
            self.dom[i] = if i == 0: 1 else if (all & bit(i)) != 0: all else 0;
        }
        loop {
            mut bool changed = false;
            for i in 1..<self.n {
                if (all & bit(i)) == 0: cont;
                mut u32 inter = all;
                for p in 0..<self.n {
                    if (self.pred[i] & bit(p)) != 0 and (all & bit(p)) != 0: inter = inter & self.dom[p];
                }
                u32 nd = inter | bit(i);
                if nd != self.dom[i] {
                    self.dom[i] = nd;
                    changed = true;
                }
            }
            if !changed: brk;
        }
        ret all;
    }

    fun idom = (u32 v) -> i32 {
        if v == 0 or self.dom[v] == 0: ret -1;
        u32 strict = self.dom[v] ^ bit(v);
        for d in 0..<self.n {
            if (strict & bit(d)) != 0 and self.dom[d] == strict: ret d as i32;
        }
        ret -1;
    }

    fun loop_body = (u32 t, u32 h, u32 all) -> u32 {
        mut u32 mask = bit(h) | bit(t);
        loop {
            mut bool changed = false;
            for x in 0..<self.n {
                bool inside = (mask & bit(x)) != 0;
                u32 grown = mask | (self.pred[x] & all);
                if x != h and inside and ((grown) != mask) {
                    mask = grown;
                    changed = true;
                }
            }
            if !changed: ret mask;
        }
        ret mask;
    }

    fun back_edges = () -> u32 {
        mut u32 count = 0;
        for t in 0..<self.n {
            for h in 0..<self.n {
                bool edge = (self.succ[t] & bit(h)) != 0;
                bool dominated = (self.dom[t] & bit(h)) != 0;
                if edge and dominated: count += 1;
            }
        }
        ret count;
    }

    fun live = (&[]u8 use, &[]u8 def) {
        loop {
            mut bool changed = false;
            mut u32 i = self.n;
            while i > 0 {
                i -= 1;
                mut u32 out = 0;
                for s in 0..<self.n {
                    if (self.succ[i] & bit(s)) != 0: out = out | self.lin[s];
                }
                u32 inn = use.*[i] as u32 | (out & (def.*[i] as u32 ^ 0xFF));
                if out != self.lout[i] or inn != self.lin[i] {
                    self.lout[i] = out;
                    self.lin[i] = inn;
                    changed = true;
                }
            }
            if !changed: brk;
        }
    }
}

fun fresh = (u32 n) -> Cfg {
    [10]u32 a;
    [10]u32 b;
    [10]u32 c;
    [10]u32 d;
    [10]u32 e;
    ret Cfg(n = n, succ = a, pred = b, dom = c, lin = d, lout = e, bad = 0);
}

fun reachable = (&[]u8 edges, u32 n) -> u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    ret g.reach();
}

fun dominators = (&[]u8 edges, u32 n) -> [10]u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    do g.doms();
    ret g.dom;
}

fun idoms = (&[]u8 edges, u32 n) -> [10]i32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    do g.doms();
    mut [10]i32 out;
    for i in 0..<n: out[i] = g.idom(i);
    ret out;
}

fun loops = (&[]u8 edges, u32 n) -> [10]u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    u32 all = g.doms();
    mut [10]u32 out;
    for t in 0..<n {
        for h in 0..<n {
            bool edge = (g.succ[t] & bit(h)) != 0;
            bool dominated = (g.dom[t] & bit(h)) != 0;
            if edge and dominated: out[h] = out[h] | g.loop_body(t, h, all);
        }
    }
    ret out;
}

fun back_edge_count = (&[]u8 edges, u32 n) -> u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    do g.doms();
    ret g.back_edges();
}

fun live_in = (&[]u8 edges, u32 n, &[]u8 use, &[]u8 def) -> [10]u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    g.live(use, def);
    ret g.lin;
}

fun live_out = (&[]u8 edges, u32 n, &[]u8 use, &[]u8 def) -> [10]u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    g.live(use, def);
    ret g.lout;
}

fun bad_edges = (&[]u8 edges, u32 n) -> u32 {
    mut Cfg g = fresh(n);
    g.build(edges);
    ret g.bad;
}

