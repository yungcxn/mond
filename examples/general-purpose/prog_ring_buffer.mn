# a fixed capacity double ended queue over a ring, head and tail wrap around

type Ring = *(mut [8]i32 buf, mut u32 head = 0, mut u32 len = 0) !{
    fun cap = () -> u32: ret 8;
    fun full = () -> bool: ret self.len == 8;
    fun empty = () -> bool: ret self.len == 0;
    fun at = (u32 i) -> i32: ret self.buf[(self.head + i) % 8];
    fun push_back = (i32 v) -> bool {
        if self.len == 8: ret false;
        self.buf[(self.head + self.len) % 8] = v;
        self.len += 1;
        ret true;
    }
    fun push_front = (i32 v) -> bool {
        if self.len == 8: ret false;
        self.head = (self.head + 7) % 8;
        self.buf[self.head] = v;
        self.len += 1;
        ret true;
    }
    fun pop_front = () -> i32 {
        i32 v = self.buf[self.head];
        self.head = (self.head + 1) % 8;
        self.len -= 1;
        ret v;
    }
    fun pop_back = () -> i32 {
        self.len -= 1;
        ret self.buf[(self.head + self.len) % 8];
    }
    fun back = () -> i32: ret self.buf[(self.head + self.len + 7) % 8];
    fun front = () -> i32: ret self.buf[self.head];
}

fun fresh = () -> Ring: ret Ring(buf = [0, 0, 0, 0, 0, 0, 0, 0]);

# digits of the contents front to back, so order mistakes show
fun digits = (&Ring r) -> i32 {
    mut i32 s = 0;
    for i in 0..<r.len: s = s * 10 + r.at(i);
    ret s;
}

fun fifo = () -> i32 {
    mut Ring r = fresh();
    for i in 1..=5: r.push_back(i as i32);
    mut i32 out = 0;
    for 0..<3: out = out * 10 + r.pop_front();
    for i in 6..=9: r.push_back(i as i32);
    ret out * 1000000 + digits(r.&);
}

fun lifo = () -> i32 {
    mut Ring r = fresh();
    for i in 1..=4: r.push_front(i as i32);
    mut i32 out = 0;
    while !r.empty(): out = out * 10 + r.pop_back();
    ret out;
}

# a full ring rejects, wraps the head below zero and keeps order
fun overflow = () -> u32 {
    mut Ring r = fresh();
    mut u32 accepted = 0;
    for i in 0..<12 {
        bool ok = if i % 2 == 0: r.push_back(i as i32) else: r.push_front(i as i32);
        if ok: accepted += 1;
    }
    ret accepted * 100 + r.len * 10 + (if r.full(): 1 else: 0);
}

fun wrap_order = () -> i32 {
    mut Ring r = fresh();
    for i in 1..=6: r.push_back(i as i32);
    for 0..<5: r.pop_front();
    for i in 7..=9: r.push_back(i as i32);
    r.push_front(5);
    ret r.head as i32 * 100000 + digits(r.&);
}

# sliding window maximum with a monotonic deque of indices
fun window_max = (&[]i32 xs, u32 k) -> i32 {
    mut Ring q = fresh();
    mut i32 acc = 0;
    for i in 0..<xs.$len {
        u32 j = i as u32;
        while !q.empty() and xs.*[q.back()] <= xs.*[j]: q.pop_back();
        q.push_back(j as i32);
        if q.front() as u32 + k <= j: q.pop_front();
        if j + 1 >= k: acc = acc * 10 + xs.*[q.front()];
    }
    ret acc;
}

# josephus elimination on the ring: rotate k - 1 then drop
fun last_standing = (u32 n, u32 k) -> i32 {
    mut Ring r = fresh();
    for i in 1..=n: r.push_back(i as i32);
    while r.len > 1 {
        for 0..<(k - 1): r.push_back(r.pop_front());
        r.pop_front();
    }
    ret r.front();
}

stcfun s_fifo = () -> i32: ret fifo();
stcfun s_lifo = () -> i32: ret lifo();
stcfun s_overflow = () -> u32: ret overflow();
stcfun s_wrap = () -> i32: ret wrap_order();
stcfun s_window = () -> i32 {
    [8]i32 xs = [1, 3, 1, 2, 0, 5, 2, 4];
    ret window_max(xs.&, 3);
}
stcfun s_window1 = () -> i32 {
    [4]i32 xs = [4, 2, 7, 1];
    ret window_max(xs.&, 1);
}
stcfun s_jos = (u32 n) -> i32: ret last_standing(n, 3);

stc i32 FIFO = s_fifo(); #= FIFO 123456789
stc i32 LIFO = s_lifo(); #= LIFO 1234
stc u32 OVF = s_overflow(); #= OVF 881
stc i32 WRAP = s_wrap(); #= WRAP 456789
stc i32 WIN = s_window(); #= WIN 332555
stc i32 WIN1 = s_window1(); #= WIN1 4271
stc i32 J7 = s_jos(7); #= J7 4
stc i32 J1 = s_jos(1); #= J1 1
stc i32 J8 = s_jos(8); #= J8 7

$main = () -> i32 {
    q = fresh(); #: q *([8]i32 buf, u32 head, u32 len)
    f = fifo(); #: f i32
    ret f + lifo() + overflow() as i32 + wrap_order() + last_standing(5, 2);
}
