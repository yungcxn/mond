stc bool RM3 = row_moved(2, 0, 0, 0); #= RM3 false

fun script = (&[]u32 dirs) -> u64 {
    mut Grid g;
    g.t[0] = 2;
    g.t[1] = 2;
    g.t[5] = 4;
    g.t[10] = 4;
    g.t[15] = 2;
    g.t[12] = 8;
    mut u32 moved = 0;
    for d in dirs.*: if g.shift(d): moved += 1;
    ret g.digest() * 100 + (moved as u64);
}

fun script_score = (&[]u32 dirs) -> u32 {
    mut Grid g;
    g.t[0] = 2;
    g.t[1] = 2;
    g.t[5] = 4;
    g.t[10] = 4;
    g.t[15] = 2;
    g.t[12] = 8;
    for d in dirs.*: do g.shift(d);
    ret g.score;
}

fun is_over = (u32 kind) -> bool {
    mut Grid g;
    for i in 0..<16 {
        u32 n = i as u32;
        g.t[i] = if kind == 0: (n % 2 + 1) * 2 + (n / 4 % 2) * 4 else: (n + 1) * 2;
    }
    if kind == 2: g.t[15] = g.t[14];
    if kind == 3: g.t[7] = 0;
    ret g.over();
}

stc u64 SC1 = script([0, 2, 1, 3].&); #= SC1 78575728704
stc u32 SS1 = script_score([0, 2, 1, 3].&); #= SS1 12
stc u64 SC2 = script([0, 0, 0, 0].&); #= SC2 33742524601
stc u32 SS2 = script_score([0, 2, 0, 2, 0, 2].&); #= SS2 12
stcfun none_script = () -> u64 {
    []u32 e = [];
    ret script(e.&);
}

stc u64 SC3 = none_script(); #= SC3 32362395100
stc bool GO1 = is_over(0); #= GO1 true
stc bool GO2 = is_over(1); #= GO2 true
stc bool GO3 = is_over(2); #= GO3 false
stc bool GO4 = is_over(3); #= GO4 false

variant Cell = +(Empty, Red, Blue) tagof u8;

type Drop = *(mut [20]i32 c, mut [5]u32 h, mut u32 moves) !{
    fun drop = (u32 col, i32 who) -> i32 {
        if col >= 5 or self.h[col] >= 4: ret -1;
        u32 row = self.h[col];
        self.c[row * 5 + col] = who;
        self.h[col] += 1;
        self.moves += 1;
        ret row as i32;
    }

    fun get = (i32 r, i32 c) -> i32 {
        if r < 0 or r >= 4 or c < 0 or c >= 5: ret 0;
        ret self.c[r * 5 + c];
    }

    fun wins_at = (i32 r, i32 c) -> bool {
        i32 who = self.get(r, c);
        if who == 0: ret false;
        [8]i32 dirs = [0, 1, 1, 0, 1, 1, 1, -1];
        for d in 0..<4 {
            i32 dr = dirs[d * 2];
            i32 dc = dirs[d * 2 + 1];
            mut u32 run = 1;
            mut i32 k = 1;
            while self.get(r + dr * k, c + dc * k) == who {
                run += 1;
                k += 1;
            }
            k = 1;
            while self.get(r - dr * k, c - dc * k) == who {
                run += 1;
                k += 1;
            }
            if run >= 3: ret true;
        }
        ret false;
    }

    fun cell = (u32 i) -> Cell: ret match self.c[i] {
        1 => Cell.Red,
        -1 => Cell.Blue,
        _ => Cell.Empty,
    }

    fun red_count = () -> u32 {
        mut u32 n = 0;
        for i in 0..<20: n += match self.cell(i) {
            Cell.Red => 1,
            _ => 0,
        };
        ret n;
    }
}

fun play_script = (&[]u32 cols) -> i32 {
    mut Drop d;
    mut i32 who = 1;
    for col in cols.* {
        i32 r = d.drop(col, who);
        if r < 0: ret -1000 - col as i32;
        if d.wins_at(r, col as i32): ret who * (d.moves as i32);
        who = -who;
    }
    ret 0;
}

fun reds_after = (&[]u32 cols) -> u32 {
    mut Drop d;
    mut i32 who = 1;
    for col in cols.* {
        do d.drop(col, who);
        who = -who;
    }
    ret d.red_count();
}

stc i32 C1 = play_script([0, 1, 0, 1, 0].&); #= C1 5
stc i32 C2 = play_script([0, 0, 1, 1, 2].&); #= C2 5
stc i32 C3 = play_script([0, 1, 1, 2, 2, 3, 2].&); #= C3 -6
stc i32 C4 = play_script([0, 1, 2, 3, 4].&); #= C4 0
stc i32 C5 = play_script([0, 0, 0, 0, 0].&); #= C5 -1000
stcfun none_play = () -> i32 {
    []u32 e = [];
    ret play_script(e.&);
}

stc i32 C6 = none_play(); #= C6 0
stc i32 C7 = play_script([2, 3, 1, 3, 0].&); #= C7 5
stc i32 C8 = play_script([9,].&); #= C8 -1009
stc i32 C9 = play_script([1, 2, 2, 3, 3, 4, 3].&); #= C9 -6
stc u32 CR1 = reds_after([0, 1, 2, 3, 4, 0].&); #= CR1 3
stcfun none_reds = () -> u32 {
    []u32 e = [];
    ret reds_after(e.&);
}

stc u32 CR2 = none_reds(); #= CR2 0

trait Player = !{
    fun play = (Move last) -> Move;
}

type Rocky = *(u32 unused = 0) implof Player !{
    fun play = (Move last) -> Move: ret Move.Rock;
}

type Cycler = *(mut u32 i = 0) implof Player !{
    fun play = (Move last) -> Move {
        self.i += 1;
        ret match self.i % 3 {
            0 => Move.Rock,
            1 => Move.Paper,
            _ => Move.Scissors,
        };
    }
}

type Copycat = *(u32 unused = 0) implof Player !{
    fun play = (Move last) -> Move: ret last;
}

type Loser = *(u32 unused = 0) implof Player !{
    fun play = (Move last) -> Move: ret match last {
        Move.Rock => Move.Scissors,
        Move.Paper => Move.Rock,
        Move.Scissors => Move.Paper,
    }
}

type Rando = *(mut u32 s) implof Player !{
    fun play = (Move last) -> Move {
        self.s = self.s * 1664525 + 1013904223;
        ret match (self.s >> 16) % 3 {
            0 => Move.Rock,
            1 => Move.Paper,
            _ => Move.Scissors,
        };
    }
}

fun beats = (Move a, Move b) -> i32 {
    if a == b: ret 0;
    bool wins = match a {
        Move.Rock => b == Move.Scissors,
        Move.Paper => b == Move.Rock,
        Move.Scissors => b == Move.Paper,
    };
    ret if wins: 1 else: -1;
}

fun duel = (Player a, Player b, u32 rounds) -> i32 {
    mut Move la = Move.Rock;
    mut Move lb = Move.Rock;
    mut i32 score = 0;
    for 0..<rounds {
        Move ma = a.play(lb);
        Move mb = b.play(la);
        score += beats(ma, mb);
        la = ma;
        lb = mb;
    }
    ret score;
}

stc i32 P1 = beats(Move.Rock, Move.Scissors); #= P1 1
stc i32 P2 = beats(Move.Rock, Move.Paper); #= P2 -1
stc i32 P3 = beats(Move.Paper, Move.Paper); #= P3 0
stc i32 P4 = duel(Rocky(), Cycler(), 9); #= P4 0
stc i32 P5 = duel(Cycler(), Copycat(), 12); #= P5 12
stc i32 P6 = duel(Copycat(), Loser(), 10); #= P6 5
stc i32 P7 = duel(Rando(s = 7), Rocky(), 30); #= P7 -1
stc i32 P8 = duel(Rando(s = 7), Rando(s = 8), 30); #= P8 9
stc i32 P9 = duel(Loser(), Rando(s = 1), 25); #= P9 0
stc i32 PA = duel(Rocky(), Rocky(), 0); #= PA 0

$main = () {}
