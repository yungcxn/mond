fun nim_sum = (&[]u32 piles) -> u32 {
    mut u32 x = 0;
    for p in piles.*: x = x ^ p;
    ret x;
}

fun nim_move = (&[]u32 piles) -> u32 {
    u32 s = nim_sum(piles);
    if s == 0: ret 0;
    for i in 0..<piles.$len {
        u32 target = piles.*[i] ^ s;
        if target < piles.*[i]: ret (i as u32 + 1) * 1000 + (piles.*[i] - target);
    }
    ret 0;
}

fun nim_game = (*[]u32 piles, bool first_perfect) -> u32 {
    mut u32 turn = 0;
    mut u32 last = 0;
    loop {
        mut bool any = false;
        for p in piles.*: if p > 0: any = true;
        if !any: brk;
        u32 mv = nim_move(piles);
        bool perfect = if turn % 2 == 0: first_perfect else: !first_perfect;
        if perfect and mv != 0 {
            piles.*[mv / 1000 - 1] -= mv % 1000;
        } else {
            for i in 0..<piles.$len {
                if piles.*[i] > 0 {
                    piles.*[i] -= 1;
                    brk;
                }
            }
        }
        last = turn % 2;
        turn += 1;
    }
    ret turn * 10 + last;
}

fun grundy_sub = (u32 n) -> u32 {
    mut [32]u32 g;
    for k in 1..=n {
        mut [8]bool seen;
        for take in [1, 3, 4]: if take <= k: seen[g[k - take]] = true;
        mut u32 m = 0;
        while seen[m]: m += 1;
        g[k] = m;
    }
    ret g[n];
}

stc u32 N1 = nim_sum([3, 4, 5].&); #= N1 2
stc u32 N2 = nim_move([3, 4, 5].&); #= N2 1002
stc u32 N3 = nim_move([1, 2, 3].&); #= N3 0
stc u32 N4 = nim_move([7,].&); #= N4 1007
stc u32 N5 = nim_move([0, 0, 9].&); #= N5 3009
stcfun none_nim = () -> u32 {
    []u32 e = [];
    ret nim_sum(e.&) + nim_move(e.&);
}

stc u32 N6 = none_nim(); #= N6 0
stc u32 N7 = nim_move([1, 1, 1, 1].&); #= N7 0
stc u32 N8 = nim_move([5, 5, 6, 6, 3].&); #= N8 3001

fun nim_result = (u32 a, u32 b, u32 c, bool first_perfect) -> u32 {
    mut [3]u32 piles = [a, b, c];
    ret nim_game(piles.&, first_perfect);
}

stc u32 NG1 = nim_result(3, 4, 5, true); #= NG1 110
stc u32 NG2 = nim_result(3, 4, 5, false); #= NG2 121
