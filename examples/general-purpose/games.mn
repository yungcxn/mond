type Grid = *(mut [16]u32 t, mut u32 score) !{
    fun at = (u32 dir, u32 line, u32 k) -> u32: ret match dir {
        0 => line * 4 + k,
        1 => line * 4 + (3 - k),
        2 => k * 4 + line,
        _ => (3 - k) * 4 + line,
    }

    fun slide = (u32 dir, u32 line) -> bool {
        mut [4]u32 tiles;
        mut u32 n = 0;
        for k in 0..<4 {
            u32 v = self.t[self.at(dir, line, k)];
            if v != 0 {
                tiles[n] = v;
                n += 1;
            }
        }
        mut [4]u32 out;
        mut u32 w = 0;
        mut u32 r = 0;
        while r < n {
            if r + 1 < n and tiles[r] == tiles[r + 1] {
                out[w] = tiles[r] * 2;
                self.score += tiles[r] * 2;
                r += 2;
            } else {
                out[w] = tiles[r];
                r += 1;
            }
            w += 1;
        }
        mut bool moved = false;
        for k in 0..<4 {
            u32 idx = self.at(dir, line, k);
            if self.t[idx] != out[k] {
                self.t[idx] = out[k];
                moved = true;
            }
        }
        ret moved;
    }

    fun shift = (u32 dir) -> bool {
        mut bool moved = false;
        for line in 0..<4: if self.slide(dir, line): moved = true;
        ret moved;
    }

    fun over = () -> bool {
        for i in 0..<16: if self.t[i] == 0: ret false;
        for r in 0..<4 {
            for c in 0..<4 {
                if c < 3 and self.t[r * 4 + c] == self.t[r * 4 + c + 1]: ret false;
                if r < 3 and self.t[r * 4 + c] == self.t[(r + 1) * 4 + c]: ret false;
            }
        }
        ret true;
    }

    fun digest = () -> u64 {
        mut u64 h = 0;
        for v in self.t: h = (h * 31 + v as u64) % 1000000007;
        ret h;
    }
}

fun row = (u32 a, u32 b, u32 c, u32 d, u32 dir) -> u64 {
    mut Grid g;
    g.t[0] = a;
    g.t[1] = b;
    g.t[2] = c;
    g.t[3] = d;
    do g.slide(dir, 0);
    ret (g.t[0] as u64) * 1000000000000 + (g.t[1] as u64) * 100000000 + (g.t[2] as u64) * 10000 + (g.t[3] as u64);
}

fun row_score = (u32 a, u32 b, u32 c, u32 d) -> u32 {
    mut Grid g;
    g.t[0] = a;
    g.t[1] = b;
    g.t[2] = c;
    g.t[3] = d;
    do g.slide(0, 0);
    ret g.score;
}

fun row_moved = (u32 a, u32 b, u32 c, u32 d) -> bool {
    mut Grid g;
    g.t[0] = a;
    g.t[1] = b;
    g.t[2] = c;
    g.t[3] = d;
    ret g.slide(0, 0);
}

