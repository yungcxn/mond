variant Move = +(Rock, Paper, Scissors) tagof u8;

type Ttt = *(mut [9]i32 c, mut u32 nodes) !{
    fun winner = () -> i32 {
        [24]u32 lines = [0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 3, 6, 1, 4, 7, 2, 5, 8, 0, 4, 8, 2, 4, 6];
        for l in 0..<8 {
            i32 a = self.c[lines[l * 3]];
            if a != 0 and a == self.c[lines[l * 3 + 1]] and a == self.c[lines[l * 3 + 2]]: ret a;
        }
        ret 0;
    }

    fun empties = () -> u32 {
        mut u32 n = 0;
        for x in self.c: if x == 0: n += 1;
        ret n;
    }

    fun to_move = () -> i32: ret if self.empties() % 2 == 1: 1 else: -1;

    fun negamax = (i32 player, i32 alpha0, i32 beta) -> i32 {
        self.nodes += 1;
        i32 w = self.winner();
        if w != 0: ret if w == player: 1 else: -1;
        if self.empties() == 0: ret 0;
        mut i32 alpha = alpha0;
        mut i32 best = -2;
        for i in 0..<9 {
            if self.c[i] != 0: cont;
            self.c[i] = player;
            i32 v = -self.negamax(-player, -beta, -alpha);
            self.c[i] = 0;
            if v > best: best = v;
            if best > alpha: alpha = best;
            if alpha >= beta: brk;
        }
        ret best;
    }

    fun minimax = (i32 player) -> i32 {
        self.nodes += 1;
        i32 w = self.winner();
        if w != 0: ret if w == player: 1 else: -1;
        if self.empties() == 0: ret 0;
        mut i32 best = -2;
        for i in 0..<9 {
            if self.c[i] != 0: cont;
            self.c[i] = player;
            i32 v = -self.minimax(-player);
            self.c[i] = 0;
            if v > best: best = v;
        }
        ret best;
    }

    fun best_move = (i32 player) -> i32 {
        mut i32 best = -2;
        mut i32 at = -1;
        for i in 0..<9 {
            if self.c[i] != 0: cont;
            self.c[i] = player;
            i32 v = -self.minimax(-player);
            self.c[i] = 0;
            if v > best {
                best = v;
                at = i as i32;
            }
        }
        ret at;
    }
}

fun board = (&[]u32 moves) -> Ttt {
    mut Ttt t;
    mut i32 p = 1;
    for m in moves.* {
        t.c[m] = p;
        p = -p;
    }
    ret t;
}

fun pack_board = (Ttt t) -> u32 {
    mut u32 h = 0;
    for x in t.c: h = h * 3 + (x + 1) as u32;
    ret h;
}

stc i32 W1 = board([0, 3, 1, 4, 2].&).winner(); #= W1 1
stc i32 W2 = board([0, 1, 3, 4, 8, 7].&).winner(); #= W2 -1
stc i32 W3 = board([0, 1, 4, 2, 8].&).winner(); #= W3 1
stc i32 W4 = board([2, 0, 4, 1, 6].&).winner(); #= W4 1
stc i32 W5 = board([0, 1, 2, 4, 3, 5, 7, 6, 8].&).winner(); #= W5 0
stcfun none_winner = () -> i32 {
    []u32 e = [];
    ret board(e.&).winner();
}

stc i32 W6 = none_winner(); #= W6 0
stc u32 EM1 = board([4, 0, 8].&).empties(); #= EM1 6
stc i32 TM1 = board([4, 0].&).to_move(); #= TM1 1
stc i32 TM2 = board([4,].&).to_move(); #= TM2 -1

fun value = (&[]u32 moves) -> i32 {
    mut Ttt t = board(moves);
    ret t.minimax(t.to_move());
}

fun ab_value = (&[]u32 moves) -> i32 {
    mut Ttt t = board(moves);
    ret t.negamax(t.to_move(), -2, 2);
}

fun ab_nodes = (&[]u32 moves) -> u32 {
    mut Ttt t = board(moves);
    do t.negamax(t.to_move(), -2, 2);
    ret t.nodes;
}

fun mm_nodes = (&[]u32 moves) -> u32 {
    mut Ttt t = board(moves);
    do t.minimax(t.to_move());
    ret t.nodes;
}

fun pick = (&[]u32 moves) -> i32 {
    mut Ttt t = board(moves);
    ret t.best_move(t.to_move());
}

