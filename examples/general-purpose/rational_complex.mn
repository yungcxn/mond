type Cx = *(f64 re, f64 im) !{
    fun add = (Cx o) -> Cx: ret Cx(self.re + o.re, self.im + o.im);
    fun sub = (Cx o) -> Cx: ret Cx(self.re - o.re, self.im - o.im);
    fun mul = (Cx o) -> Cx: ret Cx(self.re * o.re - self.im * o.im, self.re * o.im + self.im * o.re);
    fun conj = () -> Cx: ret Cx(self.re, -self.im);
    fun abs2 = () -> f64: ret self.re * self.re + self.im * self.im;

    fun div = (Cx o) -> Cx {
        Cx n = self.mul(o.conj());
        f64 d = o.abs2();
        ret Cx(n.re / d, n.im / d);
    }

    fun powi = (u32 e) -> Cx {
        mut Cx r = Cx(1.0, 0.0);
        mut Cx b = self.*;
        mut u32 k = e;
        while k > 0 {
            if (k & 1) == 1: r = r.mul(b);
            b = b.mul(b);
            k = k >> 1;
        }
        ret r;
    }
}

type Gauss = *(i64 a, i64 b) !{
    fun mul = (Gauss o) -> Gauss: ret Gauss(self.a * o.a - self.b * o.b, self.a * o.b + self.b * o.a);
    fun sub = (Gauss o) -> Gauss: ret Gauss(self.a - o.a, self.b - o.b);
    fun norm = () -> i64: ret self.a * self.a + self.b * self.b;

    fun div_round = (Gauss o) -> Gauss {
        i64 n = o.norm();
        i64 re = self.a * o.a + self.b * o.b;
        i64 im = self.b * o.a - self.a * o.b;
        ret Gauss(floor_div(2 * re + n, 2 * n), floor_div(2 * im + n, 2 * n));
    }
}

fun floor_div = (i64 a, i64 b) -> i64 {
    i64 q = a / b;
    ret if a % b != 0 and ((a < 0) != (b < 0)): q - 1 else: q;
}

fun gauss_gcd = (Gauss x, Gauss y) -> Gauss {
    if y.norm() == 0: ret x;
    Gauss q = x.div_round(y);
    ret gauss_gcd(y, x.sub(q.mul(y)));
}

