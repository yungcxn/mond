type Fx = *(i32 raw) !{
    fun add = (Fx o) -> Fx: ret Fx(self.raw + o.raw);
    fun sub = (Fx o) -> Fx: ret Fx(self.raw - o.raw);
    fun mul = (Fx o) -> Fx: ret Fx((((self.raw as i64) * (o.raw as i64)) >> 16) as i32);
    fun div = (Fx o) -> Fx: ret Fx((((self.raw as i64) << 16) / (o.raw as i64)) as i32);
    fun floor = () -> i32: ret self.raw >> 16;
    fun milli = () -> i64: ret ((self.raw as i64) * 1000) >> 16;

    fun sqrt = () -> Fx {
        mut u64 rem = (self.raw as u64) << 16;
        mut u64 res = 0;
        mut u64 bit = 1 << 62;
        while bit > rem: bit = bit >> 2;
        while bit != 0 {
            if rem >= res + bit {
                rem -= res + bit;
                res = (res >> 1) + bit;
            } else {
                res = res >> 1;
            }
            bit = bit >> 2;
        }
        ret Fx(res as i32);
    }
}

fun fx = (i32 whole, u32 frac16) -> Fx: ret Fx((whole << 16) + frac16 as i32);

type Vec3 = *(i32 x, i32 y, i32 z) !{
    fun add = (Vec3 o) -> Vec3: ret Vec3(self.x + o.x, self.y + o.y, self.z + o.z);
    fun scale = (i32 k) -> Vec3: ret Vec3(self.x * k, self.y * k, self.z * k);
    fun dot = (Vec3 o) -> i32: ret self.x * o.x + self.y * o.y + self.z * o.z;
    fun len2 = () -> i32: ret self.dot(self.*);

    fun cross = (Vec3 o) -> Vec3: ret Vec3(
        self.y * o.z - self.z * o.y,
        self.z * o.x - self.x * o.z,
        self.x * o.y - self.y * o.x,
    );

    fun key = () -> i64: ret (self.x as i64) * 1000000 + (self.y as i64) * 1000 + (self.z as i64);
}

type Vec2 = *(i32 x, i32 y) !{
    fun cross = (Vec2 o) -> i64: ret (self.x as i64) * (o.y as i64) - (self.y as i64) * (o.x as i64);
    fun sub = (Vec2 o) -> Vec2: ret Vec2(self.x - o.x, self.y - o.y);
}

fun orient = (Vec2 a, Vec2 b, Vec2 c) -> i32 {
    i64 v = b.sub(a).cross(c.sub(a));
    ret if v > 0: 1 else: (if v < 0: -1 else: 0);
}

fun area2 = (&[]Vec2 pts) -> i64 {
    mut i64 s = 0;
    for i in 0..<pts.$len {
        Vec2 p = pts.*[i];
        Vec2 q = pts.*[(i + 1) % pts.$len];
        s += (p.x as i64) * (q.y as i64) - (q.x as i64) * (p.y as i64);
    }
    ret s;
}

type Quat = *(i64 w, i64 x, i64 y, i64 z) !{
    fun mul = (Quat o) -> Quat: ret Quat(
        self.w * o.w - self.x * o.x - self.y * o.y - self.z * o.z,
        self.w * o.x + self.x * o.w + self.y * o.z - self.z * o.y,
        self.w * o.y - self.x * o.z + self.y * o.w + self.z * o.x,
        self.w * o.z + self.x * o.y - self.y * o.x + self.z * o.w,
    );
    fun conj = () -> Quat: ret Quat(self.w, -self.x, -self.y, -self.z);
    fun norm = () -> i64: ret self.w * self.w + self.x * self.x + self.y * self.y + self.z * self.z;
    fun key = () -> i64: ret self.w * 1000000 + self.x * 10000 + self.y * 100 + self.z;
}

