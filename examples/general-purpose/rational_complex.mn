fun abs64 = (i64 x) -> i64: ret if x < 0: -x else: x;
fun gcd64 = (i64 a, i64 b) -> i64: ret if b == 0: abs64(a) else: gcd64(b, a % b);

type Rat = *(i64 n, i64 d) !{
    fun add = (Rat o) -> Rat: ret rat(self.n * o.d + o.n * self.d, self.d * o.d);
    fun sub = (Rat o) -> Rat: ret rat(self.n * o.d - o.n * self.d, self.d * o.d);
    fun mul = (Rat o) -> Rat: ret rat(self.n * o.n, self.d * o.d);
    fun div = (Rat o) -> Rat: ret rat(self.n * o.d, self.d * o.n);
    fun neg = () -> Rat: ret Rat(-self.n, self.d);
    fun recip = () -> Rat: ret rat(self.d, self.n);

    fun cmp = (Rat o) -> i32 {
        i64 l = self.n * o.d;
        i64 r = o.n * self.d;
        ret if l < r: -1 else: (if l > r: 1 else: 0);
    }

    fun floor = () -> i64 {
        i64 q = self.n / self.d;
        ret if self.n % self.d < 0: q - 1 else: q;
    }

    fun ceil = () -> i64 {
        i64 q = self.n / self.d;
        ret if self.n % self.d > 0: q + 1 else: q;
    }

    fun pow = (u32 e) -> Rat {
        mut Rat r = Rat(1, 1);
        for 0..<e: r = r.mul(self.*);
        ret r;
    }

    fun key = () -> i64: ret self.n * 100000 + self.d;
}

fun rat = (i64 n, i64 d where d != 0 else ret Rat(0, 0)) -> Rat {
    i64 g = gcd64(n, d);
    i64 s = if d < 0: -1 else: 1;
    ret Rat(s * n / g, s * d / g);
}

fun harmonic = (u32 n) -> Rat {
    mut Rat h = rat(0, 1);
    for k in 1..=n: h = h.add(rat(1, k as i64));
    ret h;
}

fun telescoping = (u32 n) -> Rat {
    mut Rat s = rat(0, 1);
    for k in 1..=n: s = s.add(rat(1, (k * (k + 1)) as i64));
    ret s;
}

fun cf_terms = (i64 n0, i64 d0) -> u64 {
    mut i64 n = n0;
    mut i64 d = d0;
    mut u64 out = 0;
    while d != 0 {
        out = out * 10 + (n / d) as u64;
        i64 r = n % d;
        n = d;
        d = r;
    }
    ret out;
}

fun convergent = (&[]u32 terms, u64 count) -> Rat {
    mut Rat r = rat(terms.*[count - 1] as i64, 1);
    mut u64 i = count - 1;
    while i > 0 {
        i -= 1;
        r = rat(terms.*[i] as i64, 1).add(r.recip());
    }
    ret r;
}

fun farey_count = (u32 n) -> u32 {
    mut u32 count = 2;
    mut Rat a = Rat(0, 1);
    mut Rat b = Rat(1, n as i64);
    while b.n < b.d {
        count += 1;
        i64 k = (n as i64 + a.d) / b.d;
        Rat c = Rat(k * b.n - a.n, k * b.d - a.d);
        a = b;
        b = c;
    }
    ret count;
}

