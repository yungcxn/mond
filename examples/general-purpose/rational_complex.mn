stcfun square_area = () -> i64 {
    [4]Vec2 sq = [Vec2(0, 0), Vec2(4, 0), Vec2(4, 3), Vec2(0, 3)];
    ret area2(sq.&);
}

stcfun cw_area = () -> i64 {
    [3]Vec2 tri = [Vec2(0, 0), Vec2(0, 5), Vec2(5, 0)];
    ret area2(tri.&);
}

stcfun l_area = () -> i64 {
    [6]Vec2 l = [Vec2(0, 0), Vec2(4, 0), Vec2(4, 2), Vec2(2, 2), Vec2(2, 5), Vec2(0, 5)];
    ret area2(l.&);
}

stcfun degenerate_area = () -> i64 {
    [2]Vec2 seg = [Vec2(0, 0), Vec2(5, 5)];
    ret area2(seg.&);
}

stc i64 AR1 = square_area(); #= AR1 24
stc i64 AR2 = cw_area(); #= AR2 -25
stc i64 AR3 = l_area(); #= AR3 28
stc i64 AR4 = degenerate_area(); #= AR4 0

stcfun quat_units = () -> i64 {
    Quat i = Quat(0, 1, 0, 0);
    Quat j = Quat(0, 0, 1, 0);
    Quat k = Quat(0, 0, 0, 1);
    ret i.mul(j).key() * 1000000 + j.mul(k).key() * 1000 + k.mul(i).key();
}

stcfun quat_ijk = () -> i64 {
    Quat i = Quat(0, 1, 0, 0);
    Quat j = Quat(0, 0, 1, 0);
    Quat k = Quat(0, 0, 0, 1);
    ret i.mul(j).mul(k).w;
}

stcfun quat_norm_mult = () -> i64 {
    Quat p = Quat(1, 2, 3, 4);
    Quat q = Quat(-2, 0, 5, 1);
    Quat r = p.mul(q);
    ret r.norm() - p.norm() * q.norm();
}

stcfun quat_inverse = () -> i64 {
    Quat p = Quat(3, -1, 2, 5);
    Quat r = p.mul(p.conj());
    ret r.w * 1000 + r.x + r.y + r.z;
}

stc i64 Q1 = quat_units(); #= Q1 11000100
stc i64 Q2 = quat_ijk(); #= Q2 -1
stc i64 Q3 = quat_norm_mult(); #= Q3 0
stc i64 Q4 = quat_inverse(); #= Q4 39000
stc i64 Q5 = Quat(1, 2, 3, 4).mul(Quat(-2, 0, 5, 1)).key(); #= Q5 -21210297
stc i64 Q6 = Quat(1, 2, 3, 4).mul(Quat(1, 0, 0, 0)).key(); #= Q6 1020304
stc i64 Q7 = Quat(0, 0, 0, 0).mul(Quat(9, 9, 9, 9)).key(); #= Q7 0

