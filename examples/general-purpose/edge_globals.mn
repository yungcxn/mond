stc u32 POLY = 0xEDB88320;

# BUG: a stcfun called with the variable of a stcfor reports not_static although the value is computed, so the helpers below are plain funs
fun crc_entry = (u32 n) -> u32 {
    mut u32 c = n;
    for 0..<8: c = if (c & 1) == 1: POLY ^ (c >> 1) else: c >> 1;
    ret c;
}

stc []u32 CRC_TABLE = stcfor 0..<256: crc_entry($it);

fun crc32 = (&[]u8 data) -> u32 {
    mut u32 crc = 0xFFFFFFFF;
    for b in data.*: crc = CRC_TABLE[((crc ^ b as u32) & 0xFF) as u64] ^ (crc >> 8);
    ret crc ^ 0xFFFFFFFF;
}

stc u32 CRC = crc32("123456789".&); #= CRC 3421780262
stc u32 T1 = CRC_TABLE[1]; #= T1 1996959894
stc u32 T255 = CRC_TABLE[255]; #= T255 755167117
stc u64 TL = CRC_TABLE.$len; #= TL 256

stc u32 W = 4;
stc u32 H = W * 2;
stc u32 AREA = W * H + FORWARD;
stc u32 FORWARD = 100;
[AREA]u8 grid; #: grid [132]u8
[W][H]u8 plane; #: plane [4][8]u8
stc u64 GS = sizeof [AREA]u32; #= GS 528

mut u32 counter = 0;
mut [4]u32 history;
u32 base = 40;
&u8 label = "global";

fun tick = () -> u32 {
    counter += 1;
    history[counter % 4] = counter * base;
    ret counter;
}

fun read_history = (u32 i) -> u32: ret history[i];

# BUG: `&[]u32 q = a.&` and `f(S.&)` for a `[]u32` static report type_mismatch (*[N]T to &[]T only coerces as an argument of a plain function), so this static has a written out length
stc [8]u32 SQUARES = stcfor 1..=8: $it * $it; #= SQUARES [1, 4, 9, 16, 25, 36, 49, 64]
stc []u32 CUBES = stcfor x in SQUARES: x * x; #= CUBES [1, 16, 81, 256, 625, 1296, 2401, 4096]
stc u32 SUM_SQ = sum_of(SQUARES.&); #= SUM_SQ 204

fun sum_of = (&[]u32 xs) -> u32 {
    mut u32 s = 0;
    for x in xs.*: s += x;
    ret s;
}

stc [2][3]u8 GRID = [[1, 2, 3], [4, 5, 6]]; #= GRID [[1, 2, 3], [4, 5, 6]]
stc u8 CORNER = GRID[1][2]; #= CORNER 6
stc []u8 FLAT = stcfor r in GRID: r[0] + r[2]; #= FLAT [4, 10]

fun is_prime = (u32 n) -> bool {
    if n < 2: ret false;
    for d in 2..<n {
        if d * d > n: brk;
        if n % d == 0: ret false;
    }
    ret true;
}
stc []u32 PRIMES = stcfor n in 2..<50: if is_prime(n): n else: 0; #= PRIMES [2, 3, 0, 5, 0, 7, 0, 0, 0, 11, 0, 13, 0, 0, 0, 17, 0, 19, 0, 0, 0, 23, 0, 0, 0, 0, 0, 29, 0, 31, 0, 0, 0, 0, 0, 37, 0, 0, 0, 41, 0, 43, 0, 0, 0, 47, 0, 0]

stc type Small = stcif sizeof u64 > 4: u16 else: u8; #= Small u16
stc Small BIG = 60000; #= BIG 60000

fun lookup = (u64 i) -> u32: ret SQUARES[i];
fun chosen = (bool b) -> u32: ret if b: CRC_TABLE[2] else: SQUARES[2];

$main = () -> i32 {
    u32 a = tick() + lookup(3) + chosen(true);
    ret a as i32;
}
