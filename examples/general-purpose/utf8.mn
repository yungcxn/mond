stc u64 D7 = dec_seq([0xE0, 0x80, 0x80].&); #= D7 99999999999
stc u64 D8 = dec_seq([0xE0, 0x9F, 0xBF].&); #= D8 99999999999
stc u64 D9 = dec_seq([0xE0, 0xA0, 0x80].&); #= D9 20483
stc u64 DA = dec_seq([0xED, 0xA0, 0x80].&); #= DA 99999999999
stc u64 DB = dec_seq([0xED, 0x9F, 0xBF].&); #= DB 552953
stc u64 DC = dec_seq([0xEE, 0x80, 0x80].&); #= DC 573443
stc u64 DD = dec_seq([0xF0, 0x80, 0x80, 0x80].&); #= DD 99999999999
stc u64 DE = dec_seq([0xF0, 0x90, 0x80, 0x80].&); #= DE 655364
stc u64 DF = dec_seq([0xF4, 0x8F, 0xBF, 0xBF].&); #= DF 11141114
stc u64 DG = dec_seq([0xF4, 0x90, 0x80, 0x80].&); #= DG 99999999999
stc u64 DH = dec_seq([0xF5, 0x80, 0x80, 0x80].&); #= DH 99999999999
stc u64 DI = dec_seq([0x80,].&); #= DI 99999999999
stc u64 DJ = dec_seq([0xE2, 0x82].&); #= DJ 99999999999
stc u64 DK = dec_seq([0xE2, 0x28, 0xA1].&); #= DK 99999999999
stc u64 DL = dec_seq([0xFF,].&); #= DL 99999999999
stc u64 DM = dec_seq([0xC3,].&); #= DM 99999999999
stc u64 DN = dec_seq([0xF0, 0x9F, 0x98].&); #= DN 99999999999

stc u64 S1 = sweep(977); #= S1 2001139
stc u64 S2 = sweep(65521); #= S2 18

stc bool V1 = validate("hello".&); #= V1 true
stc bool V2 = validate("".&); #= V2 true
stc bool V3 = validate([0x68, 0xC3, 0xA9, 0x6C, 0x6C, 0x6F].&); #= V3 true
stc bool V4 = validate([0x68, 0xC3].&); #= V4 false
stc bool V5 = validate([0x68, 0xC3, 0x28].&); #= V5 false
stc bool V6 = validate([0xED, 0xA0, 0x80, 0xED, 0xB0, 0x80].&); #= V6 false
stc bool V7 = validate([0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0x41].&); #= V7 true

stc i32 N1 = count_cps("hello".&); #= N1 5
stc i32 N2 = count_cps("".&); #= N2 0
