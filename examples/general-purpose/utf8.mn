stc i32 N4 = count_cps([0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0x41].&); #= N4 3
stc i32 N5 = count_cps([0x41, 0xFF, 0x42].&); #= N5 -1
stc i32 N6 = count_cps("héllo €".&); #= N6 7
stc u64 N7 = "héllo €".$len; #= N7 10

fun chars_sum = (&[]u8 s) -> u64 {
    mut Chars it = Chars(src = s, at = 0, bad = 0);
    mut u64 sum = 0;
    for cp in it: sum = sum * 3 + cp as u64;
    ret sum * 10 + it.bad as u64;
}

stc u64 I1 = chars_sum([0x68, 0xC3, 0xA9, 0x6C].&); #= I1 17430
stc u64 I2 = chars_sum([0x41, 0xFF, 0x42, 0xE2, 0x82].&); #= I2 20373823
stc u64 I3 = chars_sum("".&); #= I3 0
stc u64 I4 = chars_sum([0xF0, 0x9F, 0x98, 0x80].&); #= I4 1285120
stc u64 I5 = chars_sum([0x80, 0x80].&); #= I5 2621322

stc u32 U1 = utf16_len(0x41); #= U1 1
stc u32 U2 = utf16_len(0xFFFF); #= U2 1
stc u32 U3 = utf16_len(0x10000); #= U3 2
stc u32 U4 = utf16_len(0xD800); #= U4 0
stc u32 U5 = utf16_len(0x110000); #= U5 0
stc u32 U6 = utf16_pair(0x1F600); #= U6 3627933184
stc u32 U7 = utf16_pair(0x10000); #= U7 3623934976
stc u32 U8 = utf16_pair(0x10FFFF); #= U8 3690979327
stc u32 U9 = utf16_pair(0x20AC); #= U9 8364
stc u32 UA = from_utf16(0xD83D, 0xDE00); #= UA 128512
stc u32 UB = from_utf16(0xDBFF, 0xDFFF); #= UB 1114111

$main = () {}
