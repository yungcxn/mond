variant Dec = +(Ok(u32 cp, u32 len), Bad) tagof u8;

fun encode = (u32 cp, *[]u8 out, u32 at) -> u32 {
    if cp < 0x80 {
        out.*[at] = cp as u8;
        ret 1;
    }
    if cp < 0x800 {
        out.*[at] = (0xC0 | (cp >> 6)) as u8;
        out.*[at + 1] = (0x80 | (cp & 0x3F)) as u8;
        ret 2;
    }
    if cp >= 0xD800 and cp <= 0xDFFF: ret 0;
    if cp < 0x10000 {
        out.*[at] = (0xE0 | (cp >> 12)) as u8;
        out.*[at + 1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        out.*[at + 2] = (0x80 | (cp & 0x3F)) as u8;
        ret 3;
    }
    if cp > 0x10FFFF: ret 0;
    out.*[at] = (0xF0 | (cp >> 18)) as u8;
    out.*[at + 1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
    out.*[at + 2] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
    out.*[at + 3] = (0x80 | (cp & 0x3F)) as u8;
    ret 4;
}

fun is_cont = (&[]u8 s, u64 at) -> bool: ret at < s.$len and (s.*[at] & 0xC0) == 0x80;

fun decode = (&[]u8 s, u32 at) -> Dec {
    if at >= s.$len: ret Dec.Bad;
    u32 b0 = s.*[at] as u32;
    if b0 < 0x80: ret Dec.Ok(b0, 1);
    if b0 < 0xC2 or b0 > 0xF4: ret Dec.Bad;
    u32 need = if b0 < 0xE0: 1 else: (if b0 < 0xF0: 2 else: 3);
    mut u32 cp = if need == 1: b0 & 0x1F else: (if need == 2: b0 & 0x0F else: b0 & 0x07);
    for k in 1..=need {
        if !is_cont(s, (at + k) as u64): ret Dec.Bad;
        cp = (cp << 6) | ((s.*[at + k] as u32) & 0x3F);
    }
    if need == 2 and cp < 0x800: ret Dec.Bad;
    if need == 3 and (cp < 0x10000 or cp > 0x10FFFF): ret Dec.Bad;
    if cp >= 0xD800 and cp <= 0xDFFF: ret Dec.Bad;
    ret Dec.Ok(cp, need + 1);
}

fun show = (Dec d) -> u64: ret match d {
    Dec.Ok(cp, len) => (cp as u64) * 10 + len as u64,
    Dec.Bad => 99999999999,
}

fun validate = (&[]u8 s) -> bool {
    mut u32 at = 0;
    while at < s.$len {
        match decode(s, at) {
            Dec.Ok(_, len) => at += len,
            Dec.Bad => ret false,
        }
    }
    ret true;
}

fun count_cps = (&[]u8 s) -> i32 {
    mut u32 at = 0;
    mut i32 n = 0;
    while at < s.$len {
        match decode(s, at) {
            Dec.Ok(_, len) => at += len,
            Dec.Bad => ret -1,
        }
        n += 1;
    }
    ret n;
}

type Chars = *(&[]u8 src, mut u32 at, mut u32 bad) !{
    $has_next = () -> bool: ret self.at < self.src.$len;
    $next = () -> u32 {
        match decode(self.src, self.at) {
            Dec.Ok(cp, len) => {
                self.at += len;
                ret cp;
            },
            Dec.Bad => {
                self.at += 1;
                self.bad += 1;
                ret 0xFFFD;
            },
        }
    }
}

fun utf16_len = (u32 cp) -> u32 {
    bool surrogate = cp >= 0xD800 and cp <= 0xDFFF;
    ret if cp > 0x10FFFF or surrogate: 0 else: (if cp >= 0x10000: 2 else: 1);
}

fun utf16_pair = (u32 cp) -> u32: ret if cp < 0x10000: cp else: (((0xD800 + ((cp - 0x10000) >> 10)) << 16) | (0xDC00 + ((cp - 0x10000) & 0x3FF)));

fun from_utf16 = (u32 hi, u32 lo) -> u32: ret 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00);

fun enc_bytes = (u32 cp) -> u64 {
    mut [4]u8 b;
    u32 n = encode(cp, b.&, 0);
    mut u64 h = 0;
    for i in 0..<n: h = h * 256 + b[i] as u64;
    ret h * 10 + n as u64;
}

fun rt = (u32 cp) -> u64 {
    mut [4]u8 b;
    u32 n = encode(cp, b.&, 0);
    if n == 0: ret 1;
    match decode(b.&, 0) {
        Dec.Ok(c, len) => ret if c == cp and len == n: 0 else: 2,
        Dec.Bad => ret 3,
    }
}

fun sweep = (u32 step) -> u64 {
    mut u64 bad = 0;
    mut u64 good = 0;
    mut u32 cp = 0;
    while cp <= 0x10FFFF {
        u64 r = rt(cp);
        if r == 0: good += 1 else: bad += r * 1000000;
        cp += step;
    }
    ret bad + good;
}

fun dec_seq = (&[]u8 s) -> u64: ret show(decode(s, 0));

stc u64 E1 = enc_bytes(0x24); #= E1 361
stc u64 E2 = enc_bytes(0xA2); #= E2 498262
stc u64 E3 = enc_bytes(0x20AC); #= E3 148445883
stc u64 E4 = enc_bytes(0x10348); #= E4 40360052564
stc u64 E5 = enc_bytes(0x7F); #= E5 1271
stc u64 E6 = enc_bytes(0x80); #= E6 497922
stc u64 E7 = enc_bytes(0x7FF); #= E7 572792
stc u64 E8 = enc_bytes(0x800); #= E8 147211523
stc u64 E9 = enc_bytes(0xFFFF); #= E9 157121913
stc u64 EA = enc_bytes(0x10000); #= EA 40360019204
stc u64 EB = enc_bytes(0x10FFFF); #= EB 41030614394
stc u64 EC = enc_bytes(0x110000); #= EC 0
stc u64 ED = enc_bytes(0xD800); #= ED 0
stc u64 EE = enc_bytes(0xDFFF); #= EE 0
stc u64 EF = enc_bytes(0xD7FF); #= EF 155729273
stc u64 EG = enc_bytes(0xE000); #= EG 156304643
stc u64 EH = enc_bytes(0); #= EH 1
stc u64 EI = enc_bytes(0xFFFFFFFF); #= EI 0

stc u64 D1 = dec_seq([0xE2, 0x82, 0xAC].&); #= D1 83643
stc u64 D2 = dec_seq([0xF0, 0x9F, 0x98, 0x80].&); #= D2 1285124
