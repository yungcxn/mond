stc u32 ND3 = ndiv(61); #= ND3 2
stc u32 ND4 = ndiv(1); #= ND4 1

stcfun count_powers = () -> u32 {
    mut [1001]bool seen;
    for b in 2..<32 {
        mut u32 p = b * b;
        while p <= 1000 {
            seen[p] = true;
            p *= b;
        }
    }
    mut u32 c = 0;
    for x in seen: c += x as u32;
    ret c;
}

stc u32 CP = count_powers(); #= CP 40
