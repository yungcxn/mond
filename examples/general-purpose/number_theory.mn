stcfun totient_sum = (u32 n) -> u32 {
    mut u32 s = 0;
    for k in 1..=n: s += totient(k);
    ret s;
}

stcfun divisor_phi_sum = (u32 n) -> u32 {
    mut u32 s = 0;
    for d in 1..=n: if n % d == 0: s += totient(d);
    ret s;
}

stc u32 T1 = totient(1); #= T1 1
stc u32 T2 = totient(9); #= T2 6
stc u32 T3 = totient(36); #= T3 12
stc u32 T4 = totient(97); #= T4 96
stc u32 T5 = totient(999983); #= T5 999982
stc u32 T6 = totient_sum(100); #= T6 3044
stc u32 T7 = divisor_phi_sum(360); #= T7 360

stcfun signature = (u32 n) -> u64 {
    mut [100]u32 spf;
    build_spf(spf.&);
    ret factor_signature(spf.&, n);
}

stcfun ndiv = (u32 n) -> u32 {
    mut [100]u32 spf;
    build_spf(spf.&);
    ret divisor_count(spf.&, n);
}

stc u64 SP1 = signature(1); #= SP1 0
