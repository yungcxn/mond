# the untaken branch of a stcif is never checked
stc u32 A = stcif true: 1 else: undefined_name; #= A 1
stc u32 B = stcif false: "wrong type" else: 2; #= B 2
stc u32 C = stcif 1 > 2: 1 / 0 else: 3; #= C 3

# conditions over types and sizes
stc type Word = stcif sizeof *u8 == 8: u64 else: u32; #= Word u64
stc type Half = stcif Word == u64: u32 else: u16; #= Half u32
stc u64 HS = sizeof Half; #= HS 4

# chains pick the first true branch
stcfun grade = (u32 n) -> u32: ret if n >= 90: 1 else: if n >= 75: 2 else: if n >= 50: 3 else: 4;
stc u32 G = grade(90) * 1000 + grade(89) * 100 + grade(50) * 10 + grade(0); #= G 1234
stc u32 CH = stcif G > 2000: 1 else: stcif G > 1000: 2 else: 3; #= CH 2

# a stcif in a runtime function prunes code before it is checked
fun pick = () -> u32 {
    stcif sizeof u32 == 4 {
        ret 4;
    } else {
        ret missing_function();
    }
}

fun platform = () -> u64: ret stcif sizeof *u8 == 8: 64 else: undefined_thing;

# a stc condition may use stc locals and stcfun results
fun locals = () -> u32 {
    stc u32 K = grade(80);
    ret stcif K == 2: 22 else: "never";
}

# a stcmatch in a runtime function too
fun code = () -> u32: ret stcmatch sizeof u16 { 1 => "a", 2 => 2, _ => undefined_name }

$main = () {
    u32 x = pick() + locals() + code();
    u64 p = platform();
}
