# unlengthed arrays take their length from the value, empty arrays their element type from later use
fun sum = (&[]u32 xs) -> u32 {
    mut u32 s = 0;
    for x in xs.*: s += x;
    ret s;
}

fun drain = ([0]f32 xs) -> u64: ret xs.$len;

stc []u8 GREETING = "hello"; #: GREETING [5]u8
stc []i16 NEG = [-1, -2]; #: NEG [2]i16
stc [][]u8 GRID = [[1, 2], [3, 4], [5, 6]]; #: GRID [3][2]u8
stc u64 GLEN = GRID.$len; #= GLEN 3
stc u64 ILEN = GRID[0].$len; #= ILEN 2

$main = () {
    []u32 a = [1, 2, 3]; #: a [3]u32
    []u32 b = []; #: b [0]u32
    c = []; #: c [0]i8
    d = [c, []]; #: d [2][0]i8
    [2][0]i8 d2 = d;
    e = []; #: e [0]f32
    u64 n = drain(e);
    f32 z = 1.0;
    g = []; #: g [0]u16
    [0]u16 h = [];
    k = if z > 0.0: g else: h; #: k [0]u16
    []u8 s = ""; #: s [0]u8
    []bool bs = [true, false, true]; #: bs [3]bool
    u32 t = sum(a.&);
    nested = [[1], [2], [3]]; #: nested [3][1]u32
    copied = a; #: copied [3]u32
}
