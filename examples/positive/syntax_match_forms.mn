variant Shape = +(Circle(u32 r), Rect(u32 w, u32 h), Dot);
variant Opt8 = +(Some(u8), None = 0xFF) tagof self;

# or patterns with and without a trailing `|`, ranges, wildcards, blocks as arms, a trailing comma or none
stcfun classify = (u32 n) -> u32: ret match n {
    0 => 0,
    1 | 2 => 1,
    3 | 4 | => 2,
    5..=9 => 3,
    10..<20 => { 4; },
    _ => 5
}

stc [7]u32 C = [classify(0), classify(2), classify(4), classify(9), classify(10), classify(19), classify(20)]; #= C [0, 1, 2, 3, 4, 4, 5]

# payload binders positional and named, a label arrow on a case, a typecast arm
stcfun area = (Shape s) -> u32: ret match s {
    Shape.Circle(r) => 3 * r * r,
    Shape.Rect(w = width, h = height) => width * height,
    Shape.Dot <- d => 0,
}

stcfun opt = (Opt8 o) -> u32: ret match o {
    Opt8.Some <- v => v,
    Opt8 other => 1000,
}

stc u32 A = area(Shape.Circle(2)) + area(Shape.Rect(3, 4)) + area(Shape.Dot); #= A 24
stc u32 O = opt(Opt8.Some(7)) + opt(Opt8.None); #= O 1007

$main = () {
    i32 x = 3;
    match x { 3 => {}, _ => {} }
    match x {
        1 | 2 | 3 => {},
        _ => {},
    }
    b = match x > 2 { true => 1, false => 2 }; #: b u32
}
