# an untyped literal branch takes the type of the other branches, like a literal operand does
variant V = +(A, B, C);

fun branches = (bool c, i32 n, u8 b, i64 w, f64 d, V v) {
    a = if c: n else: 0; #: a i32
    a2 = if c: 0 else: n; #: a2 i32
    a3 = if c: -1 else: n; #: a3 i32
    a4 = if c: b else: 3; #: a4 u8
    a5 = if c: b else: 300; #: a5 u32
    a6 = if c: 1 else: -1; #: a6 i32
    a7 = if c: 1 else: 2.5; #: a7 f32
    a8 = if c: d else: 1; #: a8 f64
    a9 = if c: w else: if n > 0: 0 else: 1; #: a9 i64
    m1 = match v { V.A => n, V.B => 0, V.C => 1 }; #: m1 i32
    m2 = match v { V.A => 0, V.B => 1, V.C => n }; #: m2 i32
    m3 = match v { V.A => 0, V.B => w, V.C => -1 }; #: m3 i64
    m4 = match v { V.A => 1, V.B => -1, V.C => 2 }; #: m4 i32
    m5 = match v { V.A => 7, V.B => ret, V.C => b }; #: m5 u8
    m6 = match v { V.A => 5000000000, V.B => 1, V.C => 2 }; #: m6 u64
    m7 = match v { V.A => 1, _ => 2.0 }; #: m7 f32
}

# a stcfun body checks only the branch its static condition takes
stcfun pick = (bool c, i8 k) -> i32 {
    x = if c: k else: -100;
    i32 y = match c { true => 1, false => -1 };
    ret x * y;
}

stc i32 P1 = pick(true, 5); #= P1 5
stc i32 P2 = pick(false, 5); #= P2 100

$main = () {}
