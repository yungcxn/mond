type A = *(u8 a, u32 b); stc u64 sa = sizeof A; #= sa 8
type Pk = **(u8 a, u32 b); stc u64 spk = sizeof Pk; #= spk 5
type Ptrs = *(*u8 p, u8 b); stc u64 spp = sizeof Ptrs; #= spp 16
type N = *(A a, u8 c); stc u64 sn = sizeof N; #= sn 12
type Big = *(u8 a, u64 b, u8 c); stc u64 sbig = sizeof Big; #= sbig 24
variant E = +(X, Y, Z); stc u64 se = sizeof E; #= se 1
variant P = +(A(u32), B); stc u64 sp = sizeof P; #= sp 8
variant S = +(Some(u8), None = 0xFF) tagof self; stc u64 ss = sizeof S; #= ss 1
variant T16 = +(A(u16), B) tagof u16; stc u64 st = sizeof T16; #= st 4
variant U = E || P; stc u64 su = sizeof U; #= su 8
variant W = +(A(u64), B(u8)); stc u64 sw = sizeof W; #= sw 16

stc u64 sarr = sizeof [4]u32; #= sarr 16
stc u64 s2d = sizeof [2][3]u16; #= s2d 12
stc u64 sb = sizeof bool; #= sb 1
stc u64 sf = sizeof f64; #= sf 8
stc u64 sfn = sizeof (i32) -> i32; #= sfn 8
stc u64 su8 = sizeof u8; #= su8 1

$main = () {}
