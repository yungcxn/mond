variant Seq = +(A, B = 10, C, D = 3, E) tagtype u8;
variant Expr = +(A = 2 + 3, B = 1 << 4, C) tagtype u16;
variant Hex = +(A = 0x10, B = 0b11, C = 0o17) tagtype u8;
variant Cased = +(Lo(u8) = 7, Hi(u16), Off) tagtype u8;

stc u8 SA = tagof Seq.A; #= SA 0
stc u8 SB = tagof Seq.B; #= SB 10
stc u8 SC = tagof Seq.C; #= SC 11
stc u8 SD = tagof Seq.D; #= SD 3
stc u8 SE = tagof Seq.E; #= SE 4
stc u16 EA = tagof Expr.A; #= EA 5
stc u16 EB = tagof Expr.B; #= EB 16
stc u16 EC = tagof Expr.C; #= EC 17
stc []u8 HX = [tagof Hex.A, tagof Hex.B, tagof Hex.C]; #= HX [16, 3, 15]
stc u8 CL = tagof Cased.Lo; #= CL 7
stc u8 CH = tagof Cased.Hi; #= CH 8
stc u8 CO = tagof Cased.Off; #= CO 9

stcfun runtime_tag = (Cased c) -> u8: ret tagof c;
stc u8 RT = runtime_tag(Cased.Hi(300)); #= RT 8
stcfun as_int = (Seq s) -> u8: ret s as u8;
stc u8 AI = as_int(Seq.C); #= AI 11

variant V64 = +(C0, C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27, C28, C29, C30, C31, C32, C33, C34, C35, C36, C37, C38, C39, C40, C41, C42, C43, C44, C45, C46, C47, C48, C49, C50, C51, C52, C53, C54, C55, C56, C57, C58, C59, C60, C61, C62, C63);
stc u64 S64 = sizeof V64; #= S64 1
stc u8 L64 = tagof V64.C63; #= L64 63
variant Top = +(A = 254, B) tagtype u8;
stc u8 TB = tagof Top.B; #= TB 255
variant Wide = +(A = 255, B) tagtype u16;
stc u16 WB = tagof Wide.B; #= WB 256
stc u64 SW = sizeof Wide; #= SW 2

main = () {
    t = tagof Seq.E; #: t u8
    w = tagof Expr.B; #: w u16
}
