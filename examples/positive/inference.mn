fun make_adder = (i32 n): (i32 x): x + n; #: make_adder (i32) -> (i32) -> i32
fun induced = (i32 a, u8 b) { ret a + b; } #: induced (i32, u8) -> i32
fun unit_ret = () {} #: unit_ret () -> ()
fun lit_ret = (): ret 1; #: lit_ret () -> u32
fun signed_ret = (): ret -1; #: signed_ret () -> i32
fun rec = (u64 n) -> u64: ret if n <= 1: 1 else: n * rec(n - 1); #: rec (u64) -> u64
fun mutual_a = (u32 n) -> u32: ret if n == 0: 0 else: mutual_b(n - 1);
fun mutual_b = (u32 n): ret if n == 0: 1 else: mutual_a(n - 1); #: mutual_b (u32) -> u32

type Pair = *(i32 a, i32 b);
variant Opt8 = +(Some(u8), None = 0xFF) tagof self;

$main = () -> i32 {
    x = 5; #: x u32
    y = -5; #: y i32
    z = 5000000000; #: z u64
    zn = -5000000000; #: zn i64
    f = 2.5; #: f f32
    s = "hey"; #: s [3]u8
    arr = [1, 2, 3]; #: arr [3]u32
    []i32 sl = [1, 2]; #: sl [2]i32
    i64 w = x; #: w i64
    add5 = make_adder(5); #: add5 (i32) -> i32
    r = add5(1); #: r i32
    m = if x > 3: 1 else: 2; #: m u32
    sq = for i in 1..=4: i * i; #: sq [4]u32
    grid = [[1, 2], [3, 4], [5, 6]]; #: grid [3][2]u32
    p = Pair(a = 1, b = 2); #: p *(i32 a, i32 b)
    first = p.a; #: first i32
    o = Opt8.Some(3); #: o +(Some, None).Some
    Opt8 auto = 7; #: auto +(Some, None)
    u = auto ??; #: u u8
    fb = auto ?? 0; #: fb u8
    sum = (Pair(a = 1, b = 2) <- q, t).a + q + t; #: sum i32
    ptr = x.&; #: ptr &u32
    back = ptr.*; #: back u32
    fl = x as f64; #: fl f64
    same_t = (typeof x) == u32; #: same_t bool
    sz = sizeof Pair; #: sz u64
    lam = (i32 a, i32 b): a * b; #: lam (i32, i32) -> i32
    called = ((u8 c): c + 1)(4); #: called u8
    ret r;
}
