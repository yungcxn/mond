# `include` of a library with macros, types and values of its own: only what is `pub` can be named
<include "../lib/macro_kit.mn">;
stc u32 tw = <twice_of(quote: 21)>; #= tw 42
stc i32 deg = Celsius(degrees = 5).degrees; #= deg 5
stc u32 kv = kit_version; #= kv 3
fun calm = (Mood m) -> bool: ret match m { Mood.Calm => true, Mood.Angry => false };
stc bool cm = calm(Mood.Calm); #= cm true

# a public function uses the library's private ones, which keep out of the including program's way
fun secret_factor = () -> u32: ret 1;
stc u32 answer = kit_answer(); #= answer 42
stc u32 own = secret_factor(); #= own 1

# the included tree, read before it is spliced
stc u64 kit_decls = lenof (include "../lib/macro_kit.mn").decls; #= kit_decls 8
stc []u8 kit_first = (include "../lib/macro_kit.mn").decls[0].name.src; #= kit_first "twice_of"

# an edited copy spread into the program: its declarations side by side
stcfun renamed_lcm = (ast lib) -> ast {
    mut ast out = lib;
    out.decls[1].name = ast.Identifier("m_lcm");
    ret quote { @..out.decls; };
}
<renamed_lcm(include "../lib/math.mn")>;
stc u32 ml = m_lcm(8, 12); #= ml 24
stc u32 gg = gcd(8, 12); #= gg 4

# a path is any static text: a stc, a macro's parameter
stc []u8 path = "../lib/strings.mn";
stcfun library = ([]u8 name) -> ast: ret include name;
<library(path)>;
stc u8 fc = first_char("zebra"); #= fc 122
fun count_as = ([]u8 s) -> u32: ret count_char(s, 'a');

main = () {
    u32 a = count_as("banana");
    u32 b = m_lcm(3, 4);
}
