stcfun fact = (u64 n) -> u64: ret if n <= 1: 1 else: n * fact(n - 1);
stcfun fib = (u64 n) -> u64: ret if n < 2: n else: fib(n - 1) + fib(n - 2);

stcfun gcd = (u64 a, u64 b) -> u64 {
    mut u64 x = a;
    mut u64 y = b;
    while y != 0 {
        u64 t = y;
        y = x % y;
        x = t;
    }
    ret x;
}

stcfun collatz = (u64 start) -> u64 {
    mut u64 x = start;
    mut u64 steps = 0;
    loop {
        if x == 1: brk;
        x = if x % 2 == 0: x / 2 else: 3 * x + 1;
        steps++;
    }
    ret steps;
}

stcfun squares = (u32 n) -> [6]u32 {
    mut [6]u32 t;
    for i in 0..<n: t[i] = i * i;
    ret t;
}

# aggregates are values, a copy never aliases its source
stcfun copies = () -> u32 {
    mut [3]u32 a = [1, 2, 3];
    mut [3]u32 b = a;
    b[0] = 9;
    ret a[0] * 10 + b[0];
}

type P = *(mut i32 x, mut i32 y = 5);

stcfun moved = (i32 dx) -> P {
    mut P p = P(x = 1);
    p.x += dx;
    p.y = p.y * 2;
    ret p;
}

stcfun renewed = () -> i32 {
    P p = P(x = 3);
    P q = p with (y = 10);
    ret p.y * 100 + q.y;
}

variant Shape = +(Circle(u32 r), Rect(u32 w, u32 h), Dot);

stcfun area = (Shape s) -> u32: ret match s {
    Shape.Circle(r) => 3 * r * r,
    Shape.Rect(w, h) => w * h,
    Shape.Dot => 0,
}

stcfun total = () -> u32 {
    [3]Shape shapes = [Shape.Circle(2), Shape.Rect(w = 3, h = 4), Shape.Dot];
    mut u32 sum = 0;
    for s in shapes: sum += area(s);
    ret sum;
}

fun scale = (u32 a, u32 b = 3) -> u32: ret a * b;
fun classify = (u32 x where x < 10) -> u32: ret 1;
fun classify = (u32 x) -> u32: ret 2;

stcfun helpers = (u32 x) -> u32: ret scale(x) + scale(x, b = 1) + classify(3) * 100 + classify(30) * 1000;

stcfun closure = (u32 x) -> u32 {
    u32 k = 3;
    add_k = (u32 y) -> u32: ret y + k;
    ret add_k(add_k(x));
}

stcfun count_of = (u8 c) -> u32 {
    mut u32 n = 0;
    for ch in "hello world": if ch == c: n += 1;
    ret n;
}

stcfun evens = (u32 n) -> []u32: ret for i in 0..<n: i * 2;

# loop values get the length the execution produces
stcfun counted = (u32 n) -> []u32 {
    mut u32 i = 0;
    ret while i < n: i++;
}

stcfun until = (u32 n) -> []u32 {
    mut u32 i = 0;
    ret loop { i++; if i > n: brk else: i * 10; }
}

stcfun wraps = () -> i32 {
    i8 b = 127;
    i8 c = b +% 1;
    ret -7 / 2 + c;
}

stcfun first_even = ([5]u32 xs) -> u32 {
    for x in xs {
        if x % 2 == 0: ret x;
    }
    ret 0;
}

stcfun my_templ = (type T, bool add): (T a, T b) -> T: ret stcif add: a + b else: a - b;

# floats keep the precision of their type
stcfun precise = () -> f32 {
    mut f32 a = 16777216.0;
    a += 1.0;
    ret a;
}

stcfun heavy = () -> u64 {
    mut u64 s = 0;
    for j in 0..<400 {
        for x in [1, 2, 3, 4, 5, 6, 7, 8]: s += x;
    }
    ret s;
}

stcfun low = (i64 a, i64 b) -> i64: ret a / b;

stc u64 F = fact(20); #= F 2432902008176640000
stc u64 FB = fib(40); #= FB 102334155
stc u64 G = gcd(48, 18); #= G 6
stc u64 CZ = collatz(27); #= CZ 111
stc [6]u32 SQ = squares(4); #= SQ [0, 1, 4, 9, 0, 0]
stc u32 CP = copies(); #= CP 19
stc P MV = moved(4); #= MV [5, 10]
stc i32 RN = renewed(); #= RN 510
stc u32 TOT = total(); #= TOT 24
stc u32 HL = helpers(4); #= HL 2116
stc u32 CL = closure(1); #= CL 7
stc u32 CO = count_of('o'); #= CO 2
stc []u32 EV = evens(4); #= EV [0, 2, 4, 6]
stc []u64 SIZES = stcfor T in [u8, u16, u32, u64]: sizeof T; #= SIZES [1, 2, 4, 8]
stc []u32 WL = counted(3); #= WL [0, 1, 2]
stc []u32 LP = until(3); #= LP [10, 20, 30]
stc i32 WR = wraps(); #= WR -131
stc u32 FE = first_even([1, 3, 5, 6, 8]); #= FE 6
stc i32 TP = my_templ(i32, false)(2, 3); #= TP -1
stc f32 PR = precise(); #= PR 16777216
stc u64 HV = heavy(); #= HV 14400
stc u32 SAT = 10000000000.5 as u32; #= SAT 4294967295

fun at_runtime = () -> u64: ret fact(5) + gcd(12, 18); #: at_runtime () -> u64

$main = () {
    u64 r = at_runtime();
}
