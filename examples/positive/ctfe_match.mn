variant Shape = +(Circle(u32 r), Rect(u32 w, u32 h), Tri(u32 a, u32 b, u32 c), Empty);
type Pt = *(i32 x, i32 y);
variant Tree = +(Leaf(u32), Node(u32 l, u32 r));

stcfun area = (Shape s) -> u32: ret match s {
    Shape.Circle(0) => 0,
    Shape.Circle(r) => 3 * r * r,
    Shape.Rect(w, h = 1) => w,
    Shape.Rect(w = 1, h) => h,
    Shape.Rect(w, h) => w * h,
    Shape.Tri(a, b, c) | Shape.Tri(a = c, b, c = a) => a + b + c,
    Shape.Empty => 0,
}

stcfun quadrant = (Pt p) -> u32: ret match p {
    Pt(x = 0, y = 0) => 0,
    Pt(x = 1..=100, y = 1..=100) => 1,
    Pt(x = ..<0, y = 1..) => 2,
    Pt(x, y) => if x < 0: 3 else: 4,
}

stcfun bucket = (u32 v) -> u32: ret match v {
    0 => 0,
    1 | 2 | 3 => 1,
    4..<10 => 2,
    10..=99 => 3,
    _ => 4,
}

stcfun signed = (i8 v) -> i32: ret match v {
    -128 => -2,
    -127..=-1 => -1,
    0 => 0,
    1..=126 => 1,
    127 => 2,
}

stcfun flags = (bool a, bool b) -> u32: ret match a {
    true => match b { true => 3, false => 2 },
    false => if b: 1 else: 0,
}

# a binder of the whole value next to the case test
stcfun whole = (Shape s) -> u32: ret match s {
    Shape.Rect <- whole => whole.w + whole.h,
    other => area(other),
}

stc u32 A1 = area(Shape.Circle(0)) + area(Shape.Circle(2)); #= A1 12
stc u32 A2 = area(Shape.Rect(7, 1)) * 100 + area(Shape.Rect(1, 9)) * 10 + area(Shape.Rect(2, 3)); #= A2 796
stc u32 A3 = area(Shape.Tri(1, 2, 3)) + area(Shape.Empty); #= A3 6
stc []u32 Q = stcfor p in [Pt(x = 0, y = 0), Pt(x = 5, y = 100), Pt(x = -1, y = 7), Pt(x = -1, y = -7), Pt(x = 101, y = 1)]: quadrant(p); #= Q [0, 1, 2, 3, 4]
stc []u32 BK = stcfor v in [0, 3, 4, 9, 10, 99, 100, 4294967295]: bucket(v); #= BK [0, 1, 2, 2, 3, 3, 4, 4]
stc [7]i8 SV = [-128, -127, -1, 0, 1, 126, 127];
stc []i32 SG = stcfor v in SV: signed(v); #= SG [-2, -1, -1, 0, 1, 1, 2]
stc u32 FL = flags(true, true) * 1000 + flags(true, false) * 100 + flags(false, true) * 10 + flags(false, false); #= FL 3210
stc u32 WH = whole(Shape.Rect(4, 5)) * 100 + whole(Shape.Circle(1)); #= WH 903

# stcmatch only checks the arm that matches
stc u32 PICK = stcmatch 2 { 1 => undefined_name, 2 => 20, _ => "never checked" } #= PICK 20
stc type WT = stcmatch sizeof u16 { 1 => u8, 2 => u16, _ => u64 } #= WT u16
stc u32 RNG = stcmatch 42 { 0..<10 => 1, 10..<50 => 2, _ => 3 } #= RNG 2
stc u32 ORP = stcmatch 'b' { 'a' | 'b' => 1, _ => 2 } #= ORP 1
stc u32 BND = stcmatch 7 { 0 => 0, n => n * 3 } #= BND 21

$main = () {}
