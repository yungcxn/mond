fun f = (i32 x) -> i32: ret 1;
fun f = (f32 x) -> f32: ret 2.0;
fun f = (&u8 s) -> bool: ret true;
fun sign = (i32 x where x < 0) -> i32: ret -1;
fun sign = (i32 x where x == 0) -> i32: ret 0;
fun sign = (i32 x) -> i32: ret 1;
fun total = (&[]u32 a) -> u64: ret a.len; #: total (&[]u32) -> u64
fun first = (&[]u32 a) -> u32: ret a.*[0];
fun first = (&[0]u32 a) -> u32: ret 0;
fun widen = (i64 x) -> i64: ret x;
main = () {
    a = f(1); #: a i32
    b = f(1.5); #: b f32
    c = f("s"); #: c bool
    i32 n = 5;
    d = f(n); #: d i32
    e = sign(n); #: e i32
    t3 = total([1, 2, 3].&); #: t3 u64
    t5 = total([1, 2, 3, 4, 5].&); #: t5 u64
    h = first([9, 8].&); #: h u32
    z = first([].&); #: z u32
    u32 small = 3;
    wv = widen(small); #: wv i64
}
