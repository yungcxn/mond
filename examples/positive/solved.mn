stcfun first_over = (u32 limit) -> u32 {
    for i in 0..<100 {
        if i * i > limit: ret i;
    }
    ret 0;
}
stc u32 FO = first_over(50); #= FO 8
stc u32 cnt = 0;
stc []u32 upto = stcloop cnt = cnt + 1: if cnt > 4: brk else: cnt; #= upto [1, 2, 3, 4]
type V2 = *(i32 x, i32 y = 7);
stc V2 origin = V2(x = 1);
stc i32 oy = origin.y; #= oy 7
stc []u32 tbl = stcfor 0..<4: $it * 3;
stc u32 t2 = tbl[2]; #= t2 6
variant A = +(X, Y);
variant B = +(Z(u8));
variant U = A || B;
fun by_range = (i8 x) -> u8: ret match x { ..<0 => 0, 0..=127 => 1 }
fun by_member = (U v) -> u8: ret match v { A.X => 1, A.Y => 2, B.Z(z) => z }
fun by_group = (U v) -> u8: ret match v { A a => 1, B b => 2 }
type Buf = *(&[]u8 data);
fun blen = (Buf b) -> u64: ret b.data.len; #: blen (*(&[]u8 data)) -> u64
fun squares = (u32 n) -> []u32: ret for i in 0..<n: i * i; #: squares (u32) -> []u32
fun area = (u32 w, u32 h = w) -> u32: ret w * h;
trait Speak = !{ fun speak = () -> &u8; }
type Dog = *(u8 age) implof Speak !{ fun speak = () -> &u8: ret "woof"; }
fun is_dog = (Speak s) -> bool: ret s oftype Dog;
fun small = (type T stcwhere sizeof T <= 8) -> u64: ret sizeof T;
main = (i32 argc, &[]&u8 argv) -> i32 {
    mut i32 counter = 0;
    inc = (): counter += 1; #: inc () -> ()
    inc();
    a = area(3); #: a u32
    [4]u8 bytes = [1, 2, 3, 4];
    b = blen(Buf(data = bytes.&)); #: b u64
    sq = squares(5); #: sq []u32
    first = sq[0]; #: first u32
    n = argv.len; #: n u64
    s = small(u32); #: s u64
    Dog d = Dog(age = 3);
    dog = is_dog(d); #: dog bool
    mut u64 later;
    if argc > 1: later = 1 else: later = 2;
    u64 used = later;
    ret counter;
}
