stcfun hoisted = () -> u32 {
    u32 a = later(4);
    fun later = (u32 n) -> u32: ret n * 2;
    ret a + later(1);
}

stcfun mutual_local = () -> bool {
    fun is_even = (u32 n) -> bool: ret if n == 0: true else: is_odd(n - 1);
    fun is_odd = (u32 n) -> bool: ret if n == 0: false else: is_even(n - 1);
    ret is_even(10) and is_odd(7);
}

stcfun capturing = (u32 k) -> u32 {
    u32 base = 100;
    fun add_base = (u32 n) -> u32: ret n + base + k;
    ret add_base(1);
}

stcfun nested = () -> u32 {
    fun outer = (u32 n) -> u32 {
        fun inner = (u32 m) -> u32: ret m * 10;
        ret inner(n) + 1;
    }
    ret outer(outer(1));
}

stcfun shadowed = () -> u32 {
    fun pick = () -> u32: ret 1;
    u32 a = pick();
    u32 b = {
        fun pick = () -> u32: ret 2;
        pick();
    };
    ret a * 10 + b + pick() * 100;
}

stcfun recursive_local = (u64 n) -> u64 {
    fun fib = (u64 x) -> u64: ret if x < 2: x else: fib(x - 1) + fib(x - 2);
    ret fib(n);
}

fun global_pick = () -> u32: ret 7;

# a local function is hoisted to its block, so it shadows the global already before its declaration
stcfun local_over_global = () -> u32 {
    u32 before = global_pick();
    fun global_pick = () -> u32: ret 8;
    ret before * 10 + global_pick();
}

stc u32 HO = hoisted(); #= HO 10
stc bool ML = mutual_local(); #= ML true
stc u32 CA = capturing(5); #= CA 106
stc u32 NE = nested(); #= NE 111
stc u32 SH = shadowed(); #= SH 112
stc u64 RL = recursive_local(15); #= RL 610
stc u32 LG = local_over_global(); #= LG 88

$main = () {
    u32 r = later(2); #: r u32
    fun later = (u32 n) -> u32: ret n + 1; #: later (u32) -> u32
}
