fun apply = ((i32) -> i32 f, i32 x) -> i32: ret f(x);
fun compose = ((i32) -> i32 f, (i32) -> i32 g): (i32 x): f(g(x)); #: compose ((i32) -> i32, (i32) -> i32) -> (i32) -> i32
fun counter = (i32 start): (i32 step): start + step; #: counter (i32) -> (i32) -> i32
main = () {
    i32 base = 10;
    add_base = (i32 x): x + base; #: add_base (i32) -> i32
    r = apply(add_base, 5); #: r i32
    both = compose((i32 x): x * 2, add_base); #: both (i32) -> i32
    v = both(1); #: v i32
    chained = counter(1)(2); #: chained i32
    []((i32) -> i32) table = [add_base, both, (i32 x): x]; #: table [3](i32) -> i32
    t = table[1](3); #: t i32
    fun local = (i32 n) -> i32: ret if n == 0: 0 else: local(n - 1); #: local (i32) -> i32
    l = local(3); #: l i32
};
