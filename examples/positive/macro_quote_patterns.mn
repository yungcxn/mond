# `@..xs` takes the items between those before and after it, the ones after still have to match
stcfun middle = (ast e) -> u64: ret match e {
    quote: f(@..xs, 9) => xs.$len,
    _ => 99,
}
stc u64 m1 = middle(quote: f(1, 2, 9)); #= m1 2
stc u64 m2 = middle(quote: f(1, 2, 3)); #= m2 99
stc u64 m3 = middle(quote: f(9)); #= m3 0
stc u64 m4 = middle(quote: f()); #= m4 99
stcfun inner = (ast e) -> u64: ret match e {
    quote: [@_, @..rest, @_] => rest.$len,
    _ => 99,
}
stc u64 i0 = inner(quote: [1, 2]); #= i0 0
stc u64 i2 = inner(quote: [1, 2, 3, 4]); #= i2 2
stc u64 i_short = inner(quote: [1]); #= i_short 99

# statements of a block, by shape
stcfun statements = (ast e) -> u64: ret match e {
    quote { @first; @..rest; } => rest.$len,
    _ => 99,
}
stc u64 s3 = statements(quote { a(); b(); c(); }); #= s3 2
stc u64 s0 = statements(quote {}); #= s0 99

# literals, names and members compare by their text, parentheses are no shape
stcfun literal = (ast e) -> u32: ret match e {
    quote: 1 + 2 => 1,
    quote: "s" => 2,
    quote: true => 3,
    quote: x.y => 4,
    _ => 0,
}
stc u32 l1 = literal(quote: 1 + 2); #= l1 1
stc u32 l2 = literal(quote: 1 + 3); #= l2 0
stc u32 l3 = literal(quote: "s"); #= l3 2
stc u32 l4 = literal(quote: true); #= l4 3
stc u32 l5 = literal(quote: false); #= l5 0
stc u32 l6 = literal(quote: x.y); #= l6 4
stc u32 l7 = literal(quote: (1 + 2)); #= l7 1
stc u32 l8 = literal(quote: x.z); #= l8 0

# case patterns: the root's kind and its children, by field name too
stcfun calls = (ast e) -> u32: ret match e {
    ast.FunctionCall(callable = ast.Identifier) => 1,
    ast.FunctionCall => 2,
    _ => 3,
}
stc u32 c1 = calls(quote: f(1)); #= c1 1
stc u32 c2 = calls(quote: a.b(1)); #= c2 2
stc u32 c3 = calls(quote: 1); #= c3 3
stcfun deep = (ast e) -> []u8: ret match e {
    ast.BinaryAdd(_, ast.BinaryMultiply(l, _)) => l.$src,
    _ => "",
}
stc []u8 d1 = deep(quote: 1 + abc * 2); #= d1 "abc"
stc []u8 d2 = deep(quote: 1 + abc); #= d2 ""

$main = () {}
