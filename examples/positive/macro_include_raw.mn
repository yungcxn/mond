# `includeraw` brings every declaration of a library under its own name, also those without `pub`
<includeraw "../lib/macro_kit.mn">;
stc u32 secret = kit_secret; #= secret 7
stc u32 factor = secret_factor(); #= factor 6
stc u32 answer = kit_answer(); #= answer 42
stc u32 hidden = <hidden_macro()>; #= hidden 0
stc u32 tw = <twice_of(quote: 4)>; #= tw 8

# the same tree as `include`, only its names differ once spliced
stc u64 decls = lenof (includeraw "../lib/macro_kit.mn").decls; #= decls 8
stc bool raw = (quote: includeraw "f.mn") oftype ast.IncludeRaw; #= raw true

main = () {}
