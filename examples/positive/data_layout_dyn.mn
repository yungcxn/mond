# unlengthed arrays are runtime-length: the address of the first element, in a field as well
type Bytes = *(&[]u8 s);
type Owned = *([]u32 xs, u8 n);

stc u64 SF = sizeof Bytes; #= SF 8
stc u64 SO = sizeof Owned; #= SO 16
stc u64 SP = sizeof &[]u8; #= SP 8
stc u64 SM = sizeof *[]u64; #= SM 8
stc u64 SA = sizeof []u8; #= SA 8

main = () {}
