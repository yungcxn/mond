variant Shape = +(Circle(u32 r), Rect(u32 w, u32 h), Dot);

variant Level = +(Low = 3, Mid = 7, High = 9) tagof u8;

variant A = +(X, Y);

variant B = +(Z, W);

variant U = A || B;

# a known case has a static tag, a variant reads it at runtime
fun shape_tag = (Shape s) -> u8: ret s.$tag;
fun level_tag = (*Level l) -> u8: ret l.$tag;
fun union_tag = (U u) -> u8: ret u.$tag;

stcfun tags = () -> u32 {
    Shape s = Shape.Rect(w = 1, h = 2);
    U u = B.W;
    ret (s.$tag as u32) + (Level.High.$tag as u32) * 10 + (u.$tag as u32) * 100;
}

stc u8 DOT = Shape.Dot.$tag; #= DOT 2
stc u32 TG = tags(); #= TG 391

$main = () {
    Shape s = Shape.Circle(r = 2);
    mut Level l = Level.Mid;
    u8 a = shape_tag(s) + level_tag(l.&) + union_tag(A.Y);
    u8 b = Shape.Dot.$tag;
}
