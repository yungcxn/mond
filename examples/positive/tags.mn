variant Shape = +(Circle(u32 r), Rect(u32 w, u32 h), Dot);

variant Level = +(Low = 3, Mid = 7, High = 9) tagtype u8;

variant A = +(X, Y);

variant B = +(Z, W);

variant U = A || B;

# a known case has a static tag, a variant reads it at runtime
fun shape_tag = (Shape s) -> u8: ret tagof s;
fun level_tag = (*Level l) -> u8: ret tagof l;
fun union_tag = (U u) -> u8: ret tagof u;

stcfun tags = () -> u32 {
    Shape s = Shape.Rect(w = 1, h = 2);
    U u = B.W;
    ret (tagof s as u32) + (tagof Level.High as u32) * 10 + (tagof u as u32) * 100;
}

stc u8 DOT = tagof Shape.Dot; #= DOT 2
stc u32 TG = tags(); #= TG 391

main = () {
    Shape s = Shape.Circle(r = 2);
    mut Level l = Level.Mid;
    u8 a = shape_tag(s) + level_tag(l.&) + union_tag(A.Y);
    u8 b = tagof Shape.Dot;
}
