# the type of if / match values: never joins anything, cases join to their variant, unit blocks are runit
variant V = +(A, B(u8), C);

fun fail = () -> i32 { loop {} }

fun f = (bool c, u8 x, u16 y, i32 n, V v) {
    j1 = if c: x else: y; #: j1 u16
    j2 = if c: y else: x; #: j2 u16
    j3 = if c: x else: ret; #: j3 u8
    j4 = if c: fail() else: n; #: j4 i32
    j5 = if c: V.A else: V.C; #: j5 +(A, B, C)
    j6 = if c: V.B(1) else: V.A; #: j6 +(A, B, C)
    j7 = match x { 0 => ret, _ => x } #: j7 u8
    j8 = if c {} else {}; #: j8 runit
    j9 = if c: do x else: do y; #: j9 runit
    j10 = if c { x; } else { y; }; #: j10 u16
    j11 = if c: (if x > 1: y else: x) else: n; #: j11 i32
    j14 = if c: brk_never() else: x; #: j14 u8
}

fun brk_never = () -> u8 { loop {} }

# a literal branch takes the type of the other branches
fun g = (bool c, i32 n, u8 x, f64 d, V v) {
    l1 = if c: n else: 3; #: l1 i32
    l2 = if c: 3 else: n; #: l2 i32
    l3 = if c: x else: 255; #: l3 u8
    l4 = if c: n else: -3; #: l4 i32
    l5 = if c: 1 else: -1; #: l5 i32
    l6 = if c: d else: 2.5; #: l6 f64
    l7 = if c: 1 else: 2; #: l7 u32
    l8 = match c { true => n, false => 3 } #: l8 i32
    l9 = match c { true => 3, false => n } #: l9 i32
    l10 = match v { V.A => 1, V.B(b) => b, V.C => 2 } #: l10 u8
    l11 = match v { V.A => 1, V.B(b) => b, V.C => 300 } #: l11 u32
}



fun pick = (bool c) -> i32 {
    n = -7;
    x = if c: n else: 3;
    y = match c { true => 5, false => n }
    ret x * 10 + y;
}

stc i32 P0 = pick(false); #= P0 23
stc i32 P1 = pick(true); #= P1 -65
$main = () {}
