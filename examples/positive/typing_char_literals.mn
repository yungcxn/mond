# char and escape literals are integers of the value they name
stc u8 C0 = 'a'; #= C0 97
stc u8 C1 = '\n'; #= C1 10
stc u8 C2 = '\t'; #= C2 9
stc u8 C3 = '\r'; #= C3 13
stc u8 C4 = '\0'; #= C4 0
stc u8 C5 = '\\'; #= C5 92
stc u8 C6 = '\''; #= C6 39
stc u8 C7 = '"'; #= C7 34
stc u8 C8 = '\x7f'; #= C8 127
stc u8 C9 = '\xFF'; #= C9 255
stc u8 C10 = '\x00'; #= C10 0
stc u8 C11 = ' '; #= C11 32
stc i8 C12 = 'A'; #= C12 65
stc u16 C13 = 'z'; #= C13 122
stc u32 C14 = 'z' - 'a'; #= C14 25
stc bool C15 = 'b' > 'a'; #= C15 true
stc u8 C16 = 'a' + 1; #= C16 98

stc []u8 E = "\n\t\r\0\\\"\x41"; #: E [7]u8
stc u8 E0 = E[0]; #= E0 10
stc u8 E4 = E[4]; #= E4 92
stc u8 E5 = E[5]; #= E5 34
stc u8 E6 = E[6]; #= E6 65
stc []u8 Q = "it's"; #: Q [4]u8
stc u8 Q2 = Q[2]; #= Q2 39
stc []u8 H = "\x00\xff"; #: H [2]u8
stc u8 H1 = H[1]; #= H1 255

fun upper = (u8 c) -> u8: ret if c >= 'a' and c <= 'z': c - 32 else: c; #: upper (u8) -> u8

$main = () {}
