# examples/lib/autodiff.mn: derivatives made from the trees of functions, forward mode: every float
# local gets a tangent computed next to it
<include "../lib/autodiff.mn">;

# sums, products, quotients and negation, other parameters constant
fun poly = (f64 x) -> f64: ret 3 * x * x * x - 2 * x + 1;
fun d_poly = <derive(refl poly, quote: x, [])>;
fun ratio = (f64 x, f64 k) -> f64: ret (x + k) / (1 + x * x) - -x;
fun d_ratio = <derive(refl ratio, quote: x, [])>;
fun d_ratio_k = <derive(refl ratio, quote: k, [])>;
stc []f64 BASIC = [d_poly(2), d_poly(-1), d_ratio(1, 3), d_ratio_k(1, 3)]; #= BASIC [34, 7, -0.5, 0.5]

# locals with and without a type, updates, loops and branches; an integer local has no tangent
fun power = (f64 x, u64 n) -> f64 {
    mut f64 p = 1;
    for _ in 0..<n: p *= x;
    ret p;
}
fun d_power = <derive(refl power, quote: x, [])>;
fun steps = (f64 x) -> f64 {
    mut f64 acc = 0;
    mut u64 i = 0;
    while i < 3 {
        acc += x * i as f64;
        i = i + 1;
    }
    half = acc / 2;
    mut f64 shrink = half * x;
    shrink /= x + 1;
    shrink -= x;
    ret if x > 0: shrink else: -shrink;
}
fun d_steps = <derive(refl steps, quote: x, [])>;
fun piecewise = (f64 x) -> f64 {
    if x < 0 { ret -x * x; } else: if x < 1: ret x;
    ret 2 * x - 1;
}
fun d_piecewise = <derive(refl piecewise, quote: x, [])>;
stc []f64 FLOW = [d_power(2, 5), d_power(3, 0), d_steps(1), d_steps(-3)]; #= FLOW [80, 0, 0.125, -0.125]
stc []f64 PIECES = [d_piecewise(-2), d_piecewise(0.5), d_piecewise(4)]; #= PIECES [4, 1, 2]

# the chain rule through the derivatives given, a derivative of a derivative, conversions
fun square = (f64 v) -> f64: ret v * v;
fun d_square = (f64 v) -> f64: ret 2 * v;
fun composed = (f64 x) -> f64: ret square(square(x) + x) + square(3);
fun d_composed = <derive(refl composed, quote: x, [quote: square, quote: d_square])>;
fun d2_poly = <quote: <derive(refl d_poly, quote: x, [])> >;
fun narrow = (f64 x) -> f64: ret (x as f32 * 2) as f64;
fun d_narrow = <derive(refl narrow, quote: x, [])>;
stc []f64 CHAIN = [d_composed(1), d2_poly(2), d_narrow(9)]; #= CHAIN [12, 36, 2]

# every float parameter at once
fun bilinear = (f64 x, u32 skipped, f64 y) -> f64: ret x * y + x * x - y / 2 + skipped as f64;
fun grad_bilinear = <gradient(refl bilinear, [])>;
stc [2]f64 GRAD = grad_bilinear(3, 100, 4); #= GRAD [10, 2.5]

# newton's method at compile time: the square root of two, and where a cubic is zero
fun from_two = (f64 x) -> f64: ret x * x - 2;
fun d_from_two = <derive(refl from_two, quote: x, [])>;
fun cubic = (f64 x) -> f64: ret x * x * x - x - 1;
fun d_cubic = <derive(refl cubic, quote: x, [])>;
stcfun newton = (u8 which) -> f64 {
    mut f64 x = 1;
    for _ in 0..<20 {
        if which == 0: x -= from_two(x) / d_from_two(x) else: x -= cubic(x) / d_cubic(x);
    }
    ret x;
}
stc []f64 ROOTS = [newton(0), newton(1)]; #= ROOTS [1.414213562373095, 1.324717957244746]

# gradient descent: the minimum of a bowl
fun bowl = (f64 x, f64 y) -> f64: ret (x - 3) * (x - 3) + 2 * (y + 1) * (y + 1);
fun grad_bowl = <gradient(refl bowl, [])>;
stcfun descend = () -> [2]f64 {
    mut f64 x = 0;
    mut f64 y = 0;
    for _ in 0..<200 {
        [2]f64 g = grad_bowl(x, y);
        x -= 0.1 * g[0];
        y -= 0.1 * g[1];
    }
    ret [x, y];
}
stc [2]f64 BOTTOM = descend(); #= BOTTOM [2.999999999999999, -0.9999999999999999]

main = () {}
