# empty, single and inclusive ranges
stc []u32 NONE = stcfor 0..<0: $it; #= NONE []
stc []u32 ONE = stcfor 5..=5: $it; #= ONE [5]
stc []u32 BACK = stcfor 5..<3: $it; #= BACK []
stc []u32 UPTO = stcfor ..=3: $it; #= UPTO [0, 1, 2, 3]
stc []u32 BELOW = stcfor ..<3: $it * 10; #= BELOW [0, 10, 20]
stc u64 NL = NONE.$len + ONE.$len * 10 + UPTO.$len * 100; #= NL 410

# nested static loops build nested arrays
stc [][]u32 GRID = stcfor r in 0..<3: for c in 0..<2: r * 10 + c; #= GRID [[0, 1], [10, 11], [20, 21]]
stc u32 G21 = GRID[2][1]; #= G21 21

# a loop over an array keeps the element type
stc [3]i8 SRC = [1, -2, 3];
stc []i8 NEG = stcfor x in SRC: x * -1; #= NEG [-1, 2, -3]
stc []bool BITS = stcfor b in [true, false]: !b; #= BITS [false, true]
stc [2][2]u8 SRC2 = [[1, 2], [3, 4]];
stc [][2]u8 PAIRS = stcfor p in SRC2: [p[1], p[0]]; #= PAIRS [[2, 1], [4, 3]]
stc []u8 CHARS = stcfor c in "abc": c - 32; #= CHARS [65, 66, 67]

# cont skips an element, brk ends the array
stc []u32 ODD = stcfor i in 0..<7: if i % 2 == 0: cont else: i; #= ODD [1, 3, 5]
stc []u32 HEAD = stcfor i in 0..: if i == 4: brk else: i * i; #= HEAD [0, 1, 4, 9]

# stcwhile with a repeat statement, stcloop with brk
stc u32 W = 0;
stc []u32 STEPS = stcwhile W < 20, W += 7: W; #= STEPS [0, 7, 14]
stc u32 L = 1;
stc []u32 DOUBLES = stcloop L = L * 2: if L > 40: brk else: L; #= DOUBLES [2, 4, 8, 16, 32]
stc u32 AFTER = L; #= AFTER 64

# types as loop elements
stc []u64 SIZES = stcfor T in [i8, [3]u16, *u8, bool]: sizeof T; #= SIZES [1, 6, 8, 1]
stc []bool SIGNED = stcfor T in [u8, i8, u64, i64]: !(0 as T) < 0 as T; #= SIGNED [false, true, false, true]

# a loop value inside a stcfun takes the length execution produces
stcfun collatz = (u32 n) -> []u32 {
    mut u32 x = n;
    ret loop {
        if x == 1: brk;
        x = if x % 2 == 0: x / 2 else: 3 * x + 1;
        x;
    }
}
stc []u32 C6 = collatz(6); #= C6 [3, 10, 5, 16, 8, 4, 2, 1]
stc u64 C27 = collatz(27).$len; #= C27 111

stcfun digits = (u64 n) -> []u8 {
    mut u64 x = n;
    ret while x > 0: { d = (x % 10) as u8; x /= 10; d; }
}
stc []u8 DG = digits(90210); #= DG [0, 1, 2, 0, 9]
stc []u8 DZ = digits(0); #= DZ []

$main = () {}
