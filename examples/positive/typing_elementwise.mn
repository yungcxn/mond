# operators element by element: arrays with arrays of their length, with numbers and with slices,
# the result an array of the elements' join; `<` `<=` `>` `>=` give arrays of bools, `==` and `!=`
# still compare whole values; `-` and `!`; updates in place, also through a slice
stc [4]i32 A = [1, 5, 3, 7];
stc [4]i32 B = [2, 5, 1, 9];
stc S = A + B * 2;                       #: S [4]i32
stc [4]i32 SUM = S;                      #= SUM [5, 15, 5, 25]
stc [4]bool LT = A < B;                  #= LT [true, false, false, true]
stc [4]bool GE = A >= 2;                 #= GE [false, true, true, true]
stc bool SAME = A == B;                  #= SAME false
stc bool OTHER = A != B;                 #= OTHER true
stc [4]i32 NEG = -A;                     #= NEG [-1, -5, -3, -7]
stc [2]bool NOT = ![true, false];        #= NOT [false, true]
stc [3]u8 BITS = ![0, 15, 255];          #= BITS [255, 240, 0]
stc [3]i32 NARROW = [1, 2, 3];
stc [3]i64 LONG = [10, 20, 30];
stc WIDE = NARROW + LONG;                #: WIDE [3]i64
stc [3]i64 WIDENED = WIDE;               #= WIDENED [11, 22, 33]
stc [2]f64 HALF = 1.0 / [2.0, 4.0];      #= HALF [0.5, 0.25]
stc [3]u8 TEXT = "abc" + 1;              #= TEXT [98, 99, 100]
stc [3]u32 MODS = [10, 11, 12] % [3, 4, 5];   #= MODS [1, 3, 2]

stcfun updated = () -> [5]u32 {
    mut [5]u32 a = [1, 2, 3, 4, 5];
    a *= 10;
    [..]u32 middle = a[1..<4];
    middle += [1, 2, 3];
    middle -= 1;
    ret a;
}
stc [5]u32 UPDATED = updated();          #= UPDATED [10, 20, 31, 42, 50]

# a slice next to an array is checked against its length, here while compiling
stcfun mixed = ([..]u32 s) -> [2]u32: ret [100, 200] + s;
stc [2]u32 MIXED = mixed([1, 2, 3][1..]);     #= MIXED [102, 203]

main = () {}
