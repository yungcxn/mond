type P3 = *(i32 x, i32 y, i32 z);
type D = *(u32 a, u32 b = a * 2, u32 c = b + a);
type Clamp = *(u8 lo, mut u8 hi = 200 where hi >= lo else hi = lo);
type Wrap = *(P3 p, [2]u8 tag = [7, 8]);
type Nest = *(D d = D(a = 1), bool on = true);
type Anon = *(u8, u16, u32);

stc P3 POS = P3(1, 2, 3); #= POS [1, 2, 3]
stc P3 NAMED = P3(z = 3, x = 1, y = 2); #= NAMED [1, 2, 3]
stc P3 MIXED = P3(1, z = 3, y = 2); #= MIXED [1, 2, 3]
stc P3 TRAIL = P3(4, 5, 6,); #= TRAIL [4, 5, 6]
stc D D1 = D(3); #= D1 [3, 6, 9]
stc D D2 = D(3, 1); #= D2 [3, 1, 4]
stc D D3 = D(a = 2, c = 0); #= D3 [2, 4, 0]
stc D D4 = D(1, c = 5, b = 9); #= D4 [1, 9, 5]
stc Clamp C1 = Clamp(3); #= C1 [3, 200]
stc Clamp C2 = Clamp(250); #= C2 [250, 250]
stc Clamp C3 = Clamp(5, 2); #= C3 [5, 5]
stc Clamp C4 = Clamp(hi = 9, lo = 9); #= C4 [9, 9]
stc Wrap W = Wrap(P3(0, 0, 1)); #= W [[0, 0, 1], [7, 8]]
stc Nest N1 = Nest(); #= N1 [[1, 2, 3], true]
stc Nest N2 = Nest(on = false); #= N2 [[1, 2, 3], false]
stc Anon A = Anon(1, 2, 3); #= A [1, 2, 3]
stc u16 A1 = A.$1; #= A1 2
stc i32 SUM = POS.x + NAMED.y * 10 + MIXED.z * 100; #= SUM 321
stc u32 DEEP = N1.d.c; #= DEEP 3
stc u8 IDX = W.tag[1]; #= IDX 8

$main = () {
    p = P3(1, 2, 3); #: p *(i32 x, i32 y, i32 z)
    q = p with (y = 20); #: q *(i32 x, i32 y, i32 z)
    d = D(5); #: d *(u32 a, u32 b, u32 c)
    n = Nest().d.b; #: n u32
}
