# `crash` where nothing reaches it: a pruned branch, an arm not taken, a stcfun not running into
# it or never called, a pruned instantiation
stc u32 TAKEN = stcif true: 1 else: crash "never taken";                      #= TAKEN 1
stc type PICKED = stcmatch sizeof u16 { 2 => u16, _ => crash "no such size" };   #= PICKED u16
stcif __os == "plan9": crash "never on this machine";
stcfun checked = (u32 n) -> u32: ret if n > 3: crash "too big" else: n;
stc u32 SMALL = checked(3);                                                      #= SMALL 3
stcfun never_called = () -> u32: ret crash "never called";
fun per_type = (type T) -> u32: ret stcif sizeof T > 4: crash "too wide" else: 1;
stc u32 NARROW = per_type(u16);                                                  #= NARROW 1
fun pruned = (u32 n) -> u32: ret stcif sizeof u32 == 4: n + 1 else: crash "pruned";
stc u32 RUN = pruned(1);                                                         #= RUN 2

# it has the never type: it fits wherever a value is expected
stcfun positive = (i32 n) -> u32: ret if n < 0: crash "negative" else: n as u32;
stc u32 POS = positive(7);                                                       #: POS u32

main = () {}
