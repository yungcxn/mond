# comment lines start with # and run to end of line

u32 square(u32 n) {
    return n * n
}

u32 add(u32 a, u32 b) {
    return a + b
}

bool is_positive(u32 x) {
    if (x > 0) {
        return true
    } else {
        return false
    }
}

bool in_range(u32 x, u32 lo, u32 hi) {
    return x >= lo && x <= hi
}

bool negate(bool b) {
    return !b
}

u32 negify(u32 x) {
    return -x
}

f32 average(f32 a, f32 b) {
    return (a + b) / 2.0
}

Str greeting() {
    return "hello world"
}

u8 first_char() {
    return 'a'
}

Point make_point(u32 x, u32 y) {
    mut Point p = origin()
    p.x = x
    p.y = y
    return p
}

fill(*u32 arr, u32 len, u32 value) {
    mut u32 i = 0
    if (i < len) {
        arr[i] = value
    }
}

main() {
    mut u32 result = add(square(3), square(4))
    result = result + 1

    mut *u32 ptr = get_ptr()
    ptr[0] = 42

    if (is_positive(result)) {
        result = square(result)
    } else {
        result = 0
    }

    if (true) result = 1
}