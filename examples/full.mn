$import("somelib")

# TODOs tuples?

# globally the following is allowed:
# - a  function definition
# - a  type definition
# - a  trait definition
# - a  variant definition
# - global constants
# - $import

# classical func signature
fun add_i32 = (i32 a, i32 b) -> i32 {
    ret a + b;
}

# induced return type
fun add_i32_alt0 = (i32 a, i32 b) {
    ret a + b;
}

# automatic names
fun add_i32_alt1 = (i32, i32) {
    ret $0 + $1;
}

# non-code-block'd single line function
fun add_i32_alt2 = (i32 a, i32 b): ret a + b;

# with return type, needs colon
fun add_i32_alt3 = (i32 a, i32 b) -> i32: ret a + b;

# type is: (u32, u32)->(u32)
fun add_lambda1  = (u32 a, u32 b): ret a + b;

fun add_lambda5  = (u32 a, u32 b) {
    side_effect(a,b);
    ret a + b;
}

# "void" does not exist, it's always induced
fun my_void_func = () {
    print("Hello, world!");
}

# first set of parentheses is comptime, second set is runtime
# stc arguments can be also: type, trait, variant, size-induced-arrays and (...)->(...)  - functions
stcfun mytemplfunc = (type T, bool add_or_sub) -> (T a, T b) -> T {
    stcif add_or_sub {
        ret a + b;
    } stcelse {
        ret a - b;
    }
}

# mutable fields in type, default: constant
type Person = @([10]u8 name, mut i32 age = 18, mut *u8 address);
# no c-alignment: (packed)
type Packed = @@(u8 a, u16 b, u32 c); 

# abstract type, Point here has no real size.
stcfun Point = (type A, type B): @(A x, B y);
# or
# stcfun Point = (type A, type B) -> type: @(A x, B y);

# fully typed out, bad practice
Person alice = Person(name = "Alice", age = 30, address = "123 Main St");
# induced type
bob          = Person(name = "Bob", age = 25, address = "456 Elm St");
# copy struct with (with) and overriding tuple
peter        = bob with (name = "peter", age = bob.age + 1); 

# type definition with a belonging trait definition
stcfun AddablePointTempl = (type A, type B): @(A x, B y) @{
    fun add = (AddablePointTempl other) {
        $.x += other.x;
        $.y += other.y;
    }
}

# $Trait(AddablePoint) will provide its trait

trait AddablePoint = @{
    fun add = (Point other);
}

stcfun Addable = (type T): @{
    fun add = (T other);
}

type AddablePoint2D = @(i32 x, i32 y) implof Addable(AddablePoint2D) @{
    fun add = (AddablePoint2D other) {
        $.x += other.x;
        $.y += other.y;
    }
}

type ByteStream = @(*u8 buf, priv u32 cursor) implof Iterable(u8) @{
    fun $init = (*u8 in_buf) -> ByteStream: ret ByteStream(buf = in_buf, cursor = 0);
    fun $deinit = () {} # could be left out
    fun next = () ret $.buf[$.cursor defer $.cursor += 1];
    fun has_next = () ret $.cursor < $.buf.len;
    pub fun pop = () -> opt_u8: ret if ($.cursor >= $.buf.len) none else $.buf[$.cursor++];
}

# now abstracted:
stcfun Stream = (type ChildType): @(*ChildType buf, priv u32 cursor) implof Iterable(ChildType) @{
    fun $init = (*ChildType in_buf) -> ByteStream: ret ByteStream(buf = in_buf, cursor = 0);
    fun $deinit = () {} # could be left out
    fun next = () ret $.buf[$.cursor defer $.cursor += 1];
    fun has_next = () ret $.cursor < $.buf.len;
    pub fun pop = () -> $OptAuto(ChildType): ret if ($.cursor >= $.buf.len) none else $.buf[$.cursor++];
}

# type alias from stc fun returning a type
type Point_i32 = Point(i32, i32);
# func alias from similar
fun add = mytemplfunc(u32, true);

# variants do different stuff, one is a use-case like c-enums:
variant MyEnum = @(A = 0x01 | B = 0x02 | C = 0x03);
# tagof operator sets the tag type, above is induced through max(for all members)
# subset operator allows to define a subset of the variant
variant Color   = @(Red | Green | Blue) tagof u32;
variant Warm    = Color subset @(Red | Green);
variant Warm2   = Color subset 0..=1;
variant Warm3   = Color subset Color.Red..=Color.Green;
variant Cold    = Color subset @(Blue);
# union operator || allows to define a union of variants
variant WarmCold = Warm || Cold;
# union operator also allows to use real types:
variant WarmCold2 = Warm || Cold || u32;

# variants as tagged unions:
variant Message = @(                    # or with @@@ to have all members be equally sized, so this becomes a true c-union
    Quit = 0x0 |
    Move of Point(u8, u8) = 0x1 |
    Write of &u8 = 0x2 |
    Resize of @(u32 w, u32 h) = 0x3 |
) tagof u8;

# or "tagof none", which would mean all variant members should need a "payload type" as type is not prefixed by a tag
# could be used to group types just by some name, not through structural data.
# - to understand, each type looks like this:
#   Message.quit:   @(u8 $tag = 0x0)
#   Message.move:   @(u8 $tag = 0x1, Point(u8, u8))
#   Message.write:  @(u8 $tag = 0x2, &u8)
#   Message.Resize: @(u8 $tag = 0x3, @(u32 w, u32 h))

# now with trait definition alltogether:
variant Command = @(
    Print of @(&u8 text) @{
        fun print_with_newline = () println($.text);
    } |
    Exit of @(u8 code) @{
        fun exit = () os.exit($.code);
    } = 0x99 |
    Sleep of @(u32 ms) @{
        fun sleep = () os.sleep($.ms);
    } |
);

# heterogenic variants:
#   1) simple enum values:                           @(A | B | C)
#   2) explicitly tagged enum values:                @(A = 0x01 | B = 0x02 | C = 0x03)
#   3) enum values with payloads (types):            @(A of T1 | B of T2 | C of T3)
#   4) explicitly tagged enum values with payloads:  @(A of T1 = 0x01 | B of T2 = 0x02 | C of T3 = 0)

# homogenic variants: with @@@@, all members are equally sized, so this becomes a true c-union

# (heterogenic/homogenic) none-tagged variants:   @(...) tagof none

# union operator: 
#  - homogenic and homogenic -> homogenic
#  - heterogenic and heterogenic -> heterogenic
#  - heterogenic and homogenic -> heterogenic
#  - tagged and tagged -> tagged (tags must be disjunct or they will be overridden)
#  - tagged and none-tagged -> behaves like none-tagged, but tags in tagged one still exist

# ambiguously sized types (not usable as fields or variables, only as function parameters or return types):
# - stcfun returning a type, a trait or a variant
# - traits
# - none-tagged variants
# - heterogenic variants
# - unsized arrays
# - functions
# - fun type
# - type type

# hard & soft templating
#   - hard through stcfun params
#   - soft in fun params (not return types! as they do not need constraints) when using:
#     - stcfun returning a type, a trait or a variant
#     - traits
#     - heterogenic variants
#     - unsized arrays

# 1) simple enum values: @(A | B | C)
variant Direction = @(North | South | East | West);
fun describe_dir = (Direction d) -> &u8 {
    ret match (d) {
        Direction.North => "up",
        Direction.South => "down",
        Direction.East  => "right",
        Direction.West  => "left",
    };
}
# no soft-templating, returnable and storable as no payloads are used


# 2) explicitly tagged enum values: @(A = 0x01 | B = 0x02 | C = 0x03)
variant HttpStatus = @(Ok = 200 | NotFound = 404 | ServerError = 500) tagof u32;
fun describe_status = (HttpStatus s) -> &u8 {
    ret match (s) {
        HttpStatus.Ok          => "OK",
        HttpStatus.NotFound    => "Not Found",
        HttpStatus.ServerError => "Server Error",
    };
}
# same as above

# 3) enum values with payloads: @(A of T1 | B of T2 | C of T3)
variant Shape = @(
    Circle of f32             |
    Square of f32             |
    Rect   of @(f32 w, f32 h) |
);
fun area = (Shape s) -> f32 {
    # matches tags, could also use stcmatch(typeof s), would be better
    ret match (s) {
        Shape.Circle <- r    => 3.14159 * r * r,
        Shape.Square <- side => side * side,
        Shape.Rect   <- dims => dims.w * dims.h,
    };
}
# unknown sized Shape -> soft-templated, not returnable and not storable


# 4) explicitly tagged enum values with payloads:
#    @(A of T1 = 0x01 | B of T2 = 0x02 | C of T3 = 0)
variant Event = @(
    Click of @(i32 x, i32 y) = 0x01 |
    Key   of u8              = 0x02 |
    Close                    = 0x03 |
) tagof u8;
fun handle_event = (Event e) {
    # read same above
    match (e) {
        Event.Click <- pos  => println("click"),
        Event.Key   <- code => println("key"),
        Event.Close         => println("close"),
    }
}
# same as above

# 5) homogenic, tagged: @@@ forces all members to the same storage
#    size (true c-union layout), still has a runtime tag
variant Register = @@@(
    AsInt   of i32 = 0x01 |
    AsFloat of f32 = 0x02 |
    AsBytes of [4]u8 = 0x03 |
) tagof u8;
fun reinterpret = (Register r) -> i32 {
    # matches by tag, stcmatch(typeof r) could also be plain Register, which would then need to fallback to match by tag
    ret match (r) {
        Register.AsInt   <- i => i,
        Register.AsFloat <- f => f as i32,
        Register.AsBytes <- b => b as i32,
    };
}
# no soft-templating, returnable and storable

# 6) heterogenic, none-tagged: @(...) tagof none
variant AnyPrintable = @(
    AsInt  of i32 |
    AsText of &u8 |
    AsFlag of bool |
) tagof none;
fun print_any = (AnyPrintable v) {
    # match by tag is not possible as there's no tag
    stcmatch (typeof v) {
        AnyPrintable.AsInt  <- i => println(i),
        AnyPrintable.AsText <- t => println(t),
        AnyPrintable.AsFlag <- f => println(f),
    }
}
# soft-templated, not returnable and not storable


# 7) homogenic, none-tagged: @@@(...) tagof none
#    same comptime-only resolution as (7), but storage is
#    uniform-sized across members
variant AnyFixed32 = @@@(
    AsInt   of i32 |
    AsFloat of f32 |
    AsBits  of [4]u8 |
) tagof none;
fun to_bits = (AnyFixed32 v) -> [4]u8 {
    # match by tag is not possible as there's no tag - resolved per call site at comptime
    ret stcmatch (typeof v) {
        AnyFixed32.AsInt   <- i => i as [4]u8,
        AnyFixed32.AsFloat <- f => f as [4]u8,
        AnyFixed32.AsBits  <- b => b,
        _                       => 0, # possible as this is storable and mustn't be fixed to a subtype
    };
}
# soft-templated, returnable and storable (but not matchable by tag)

# optionals and errors
type opt8 = $Opt(u8, 0xFF);
type err8 = $ErrSet(u8, @(EOF = 0xFE | OOM = 0xFD));
type erropt8 = $Wrap(err8, opt8);

fun calc_something = (u32 i) -> erropt8: match (i) {
    0 => ret none,
    1 => ret erropt8.EOF,
    2 => ret erropt8.OOM,
    _ => ret 42,
}

# function with "subject to" operator to bind predicate to function parameter
type err_math = $ErrSet(u8, @(DivByZero = 0xFE | Overflow = 0xFD));
type erropt_i32 = $Wrap(err_math, $Opt(i32, 0xFF));

fun safe_div = (i32 a, i32 b where b != 0 else ret erropt_i32.DivByZero) -> erropt_i32 {
    ret a / b;
}

stcfun make_fixed_buf = (type T, u32 N where N > 0) -> (T seed) -> [N]T {
    [N]T buf = for i in 0..<N: seed;
    ret buf;
}

# fine, N=8 is a comptime literal, check passes at compile time
buf8 = make_fixed_buf(u8, 8)(0);

# compile error: "static where violated: N > 0", caught before codegen, zero runtime cost
# buf0 = make_fixed_buf(u8, 0)(0);

fun $main = () {
    [2]u8 my_str0 = ['h', 'i'];      type: [2]u8
    [2]u8 my_str1 = "hi";  # h i     type: [2]u8
    []u8  my_str2 = "hi";  # h i     type: [2]u8
    &u8   c_str   = "hi";  # h i \0  type: pointer to constant u8(s)
    induced_str   = "hi";  # h i     type: [2]u8

    println(c_str);

    # ----- expressed control flow -----
    a = if 2 > 1: 42 else 0;

    b = match (a) {
        0 => 0,
        42 => 1,
        _ => 2,
    };

    c = for i: 0..<10: i;
    # same as:
    # mut c = 0;
    # for i in 0..<10: c[i] = i;

    mut [100]u32 d = $splat(0);
    d = loop some_var += 5: some_generator(some_var) !! brk;     # may overflow tho
    # same as:
    # ...
    # mut u32 hidden_i = 0;
    # loop some_var += 5: d[hidden_i++] = some_generator(some_var) !! brk;
        
    mut [100]u32 e = $splat(0);
    e = while true: some_var += 5: some_generator(some_var) !! brk;     # may overflow tho
    # same as: see above

    # errors, optionals, ...

    val = calc_something(0);

    # the following gets translated into:
    #   if (val == EOF or val == OOM) ...
    # and that again into
    #   if (val == 0xFE or val == 0xFD) ...
    if val == error: println("val is either EOF or OOM");

    if val == none: println("val is none");

    valopt_or_2 = calc_something(1) !! 2;
    # same as 
    # valopt_or_2 = if calc_something(1) !<- x: x else 2;

    valopt = calc_something(1) !!;
    # same as 
    # valopt = if calc_something(1) !<- x: x else ret calc_something(1);

    valreal_or_2 = valopt ?? 2;
    # same as 
    # valopt = if valopt ?<- x: x else 2;

    valreal = valopt ??;
    # same as 
    # valopt = if valopt ?<- x: x else ret valopt;
    
    # TODO (100 as u32) operator
}
