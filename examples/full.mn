$import("somelib")

# fixed func signature
fun add_i32 = (i32 a, i32 b) -> i32 {
    ret a + b;
}

fun add_i32_alt0 = (i32 a, i32 b) {
    ret a + b;
}

fun add_i32_alt1 = (i32 a, i32 b): ret a + b;

# "void" does not eist, it's always induced
fun my_void_func = () {
    print("Hello, world!");
}

# first set of parentheses is comptime, second set is runtime
fun mytemplfunc = (type T, bool add_or_sub)(T a, T b) -> T {
    buildif add_or_sub {
        ret a + b;
    } buildelse {
        ret a - b;
    }
}

type Person = (u8[10] name, i32 age = 18, *u8 address);

type Point = (type A, type B)(A x, B y);

# $IFace(AddablePoint) will provide its interface
type AddablePoint = (type A, type B)(A x, B y) {
    add(AddablePoint other) {
        $.x += other.x;
        $.y += other.y;
    }
}

iface Addable = (type ElementType) {
    void add(ElementType other);
}

type AddablePoint2D = (i32 x, i32 y) <<< Addable(AddablePoint2D) {
    add(AddablePoint2D other) {
        $.x += other.x;
        $.y += other.y;
    }
}

# enums have no "backing int" it's not valued, but expressed 
enum MyEnum = (A = 0x01, B = 0x02, C = 0x03) {
    # space for functions
}

enum Color = (red, green, blue);

type ByteStream = (*u8 buf, prv u32 cursor) {

    fun $init = (*u8 in_buf) -> ByteStream {
        ret ByteStream(buf = in_buf, cursor = 0);
    }

    fun $deinit = () {} # could be left out

    fun $next = () {
        ret $.buf[$.cursor defer $.cursor += 1];
    }

    fun $has_next = () {
        ret $.cursor < $.buf.len;
    }

    pub fun pop = opt_u8 () {
        if (bs.cursor >= bs.buf.len) {
            ret none;
        }

        ret $.buf[$.cursor defer $.cursor += 1];
    }
}

// type def through alias
type opt_u8 = $Opt(u8, 0xFF);
type status_err = $ErrSet(EOF = 0xFE, OOM = 0xFD);
type my_u8 = $Wrap(status_err, opt_u8);

# type alias
type Point2D = Point(i32, i32);
# func alias, not templated
(u32, u32)->(u32) add = mytemplfunc(u32, true);

my_u8 calc_something(u32 i) { # TODO
    match (i) {
        0 => return none,
        1 => return EOF,
        2 => return OOM,
        _ => return 42,
    }
}

$main() {
    u8[2] my_str0 = ['h', 'i'];      type: u8[2]
    u8[2] my_str1 = "hi";  # h i     type: u8[2]
    u8[]  my_str2 = "hi";  # h i     type: u8[2]
    &u8   c_str   = "hi";  # h i \0  type: pointer to constant u8(s)
    induced_str   = "hi";  # h i     type: u8[2]

    println(c_str);

    # errors, optionals, ...

    val = calc_something(0);


    valopt_or_2 = calc_something(1) !! 2;
    # same as 
    # valopt_or_2 = if (calc_something(1) !<- x) x else 2;

    valopt = calc_something(1) !!;
    # same as 
    # valopt = if (calc_something(1) !<- x) x else return calc_something(1);

    valreal_or_2 = valopt ?? 2;
    # same as 
    # valopt = if (valopt ?<- x) x else 2;

    valreal = valopt ??;
    # same as 
    # valopt = if (valopt ?<- x) x else return valopt;
    
    # TODO $as(u8, 5)
}

# type is: (u32, u32)->(u32)
fun add_lambda1  = (u32 a, u32 b): ret a + b;

fun add_lambda5  = (u32 a, u32 b) {
    side_effect(a,b);
    ret a + b;
}
